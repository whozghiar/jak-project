;;-*-Lisp-*-
(in-package goal)

;; name: traffic-h.gc
;; name in dgo: traffic-h
;; dgos: ENGINE, GAME

;; +++traffic-danger-type
(defenum traffic-danger-type
  :type uint8
  (tdt0 0)
  (tdt1 1)
  (tdt2 2)
  (tdt3 3)
  (tdt4 4)
  (tdt5 5)
  (tdt6 6)
  (tdt7 7)
  )
;; ---traffic-danger-type

;; +++traffic-danger-flags
(defenum traffic-danger-flags
  :type uint8
  :bitfield #t
  (tdf0 0)
  )
;; ---traffic-danger-flags

;; +++traffic-h:traffic-type
(defenum traffic-type
  :type uint8
  (citizen-norm-1 0)
  (citizen-chick 1)
  (citizen-fat 2)
  (citizen-norm-2 3)
  (crimson-guard-0 4)
  (tt5 5)
  (crimson-guard-1 6)
  (crimson-guard-2 7)
  (metalhead-grunt 8)
  (metalhead-flitter 9)
  (metalhead-predator 10)
  (bikea 11)
  (bikeb 12)
  (bikec 13)
  (cara 14)
  (carb 15)
  (carc 16)
  (tt17 17)
  (guard-bike 18)
  (hellcat 19)
  (traffic-type-20 20)
  (traffic-type-21 21)
  )
;; ---traffic-h:traffic-type

;; +++traffic-h:traffic-spawn-flags
(defenum traffic-spawn-flags
  :type uint32
  :bitfield #t
  (trsflags-00)
  (trsflags-01)
  (trsflags-02)
  (dark-guard)
  (trsflags-04)
  (trsflags-05)
  (trsflags-06)
  (trsflags-07)
  )
;; ---traffic-h:traffic-spawn-flags

;; NOTE - for default-menu
(define-extern traffic-start (function none))
(define-extern traffic-kill (function none))

;; NOTE - for vehicle-rider
(define-extern lwide-entity-hack (function none))

(define-extern *traffic-alert-level-force* symbol)

(define-extern *crimson-blue-guard-ratio* int)
(define-extern find-nearest-enemy-guard (function process-focusable symbol float process-focusable))

;; ------------------------------------------------------------------------------------------------
;; Blue Crimson Guard mod -- optional "city mode" hook layer.
;;
;; The shared traffic / guard engine files (traffic-engine.gc, traffic-manager.gc, guard.gc,
;; crimson-blue-guard.gc) call these function-pointer globals instead of testing mode flags inline.
;; A small per-branch wiring file, mod-city-hooks.gc (present on every branch), (define)s them --
;; to no-op / stock defaults on the base `blueguard-traffic` branch, or to functions pulled from
;; mod-city-peaceful.gc / mod-city-insurrection.gc on a feature branch. The engine files therefore
;; stay byte-identical across the whole mod family; only the set of registered mode libraries and
;; the contents of mod-city-hooks.gc differ per branch.
;;
;; The two mode flags stay too -- the debug-menu pick-funcs need to clear the other one, so both
;; symbols exist on every branch (defined in mod-city-hooks.gc, default #f).
(define-extern *mod-city-peaceful?* symbol)
(define-extern *mod-city-insurrection?* symbol)
;; City Insurrection war-zone district configuration (see mod-city-insurrection.gc).
(define-extern *mod-city-conflict-district* symbol)
(define-extern *mod-city-conflict-mask* int)
(define-extern *mod-city-war-music* symbol)
(define-extern city-district->mask (function symbol int))
(define-extern mod-city-war-music-stop (function none))

(declare-type nav-mesh basic)

(declare-type nav-branch structure)
(declare-type traffic-manager process)
(declare-type crimson-guard process-focusable)
(declare-type crimson-blue-guard crimson-guard)

;; the *mod-city-*-hook* function pointers (need the forward-declared types above)
;; per-frame traffic shaping, called from traffic-manager::update (arg: traffic-manager)
(define-extern *mod-city-traffic-update-hook* (function traffic-manager none))
;; faction pick for one ambient city-guard spawn -- #t = blue (arg: traffic-object-spawn-params)
(define-extern *mod-city-guard-spawn-blue-hook* (function object symbol))
;; pull a process to activate from a guard pool's inactive list (args: traffic-tracker, traffic-type)
(define-extern *mod-city-guard-activate-hook* (function object traffic-type handle))
;; #t => block this frame's alert-level rise (Slums / war-zone safe havens)
(define-extern *mod-city-alert-blocked-hook* (function symbol))
;; crimson-blue-guard 'traffic-activate: the hook adds mode behaviour after stock activation (args: this, params)
(define-extern *mod-city-blue-activated-hook* (function crimson-blue-guard object symbol))
;; crimson-guard 'traffic-activate: general guard activation (e.g. randomize weapon in war zones)
(define-extern *mod-city-guard-activated-hook* (function crimson-guard object symbol))
;; per-frame active-state scan (guard.gc + crimson-blue-guard.gc active:trans)
(define-extern *mod-city-guard-active-trans-hook* (function crimson-guard none))
;; per-frame search-state scan (guard.gc search:trans): 'engaged = re-acquired a foe,
;; 'idle = drop back to patrol, #f = not applicable
(define-extern *mod-city-guard-search-trans-hook* (function crimson-guard symbol))
;; #t => keep this guard-vs-guard traffic-target instead of clearing it (crimson-guard-method-220)
(define-extern *mod-city-keep-guard-target-hook* (function process-focusable symbol))

;; DECOMP BEGINS

(define *traffic-manager* (the-as traffic-manager #f))

(define *ctywide-entity* (the-as entity #f))

(define *lwide-entity* (the-as entity #f))

(define *race-vehicle-entity* (the-as entity-actor #f))

(deftype traffic-danger-info (structure)
  ((sphere         sphere  :inline)
   (velocity       vector  :inline)
   (handle         handle)
   (notify-radius  float)
   (danger-level   float)
   (decay-rate     float)
   (flags          traffic-danger-flags)
   (danger-type    traffic-danger-type)
   )
  )


(deftype traffic-suppression-params (structure)
  ((bbox      bounding-box  :inline)
   (duration  time-frame)
   (id        int8)
   )
  (:methods
    (try-creating-new-suppression-box (_type_) symbol)
    (create-or-update-suppression-box (_type_) symbol)
    (has-valid-id? (_type_) none)
    (kill-suppression-box (_type_) none)
    )
  )


;; WARN: Return type mismatch symbol vs none.
(defmethod has-valid-id? ((this traffic-suppression-params))
  (!= (-> this id) -1)
  (none)
  )

(deftype traffic-object-spawn-params (structure)
  ((object-type  traffic-type)
   (behavior     uint64)
   (id           uint32)
   (nav-mesh     nav-mesh)
   (nav-branch   nav-branch)
   (position     vector      :inline)
   (rotation     quaternion  :inline)
   (velocity     vector      :inline)
   (handle       handle)
   (guard-type   uint8)
   (user-data    uint32)
   (flags        traffic-spawn-flags)
   (proc         process)
   )
  )

(deftype mystery-traffic-object-spawn-params (structure)
  "TODO - what is this!"
  ((params traffic-object-spawn-params :inline :offset-assert 0)
   (vector vector 3 :inline :offset-assert 112)
  ))

(define-extern traffic-object-spawn (function process traffic-object-spawn-params process-drawable))
