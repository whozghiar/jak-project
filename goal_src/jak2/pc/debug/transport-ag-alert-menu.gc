;;-*-Lisp-*-
(in-package goal)

#|
  ============================================================================
  transport-ag-alert-menu.gc -- Debug > Mods > transport-ag-alert
  ============================================================================

  Registers the "transport-ag / alert" mod's on/off switch with the unified
  "Mods" debug tab (goal_src/jak2/pc/debug/mods-menu.gc), per the mandatory
  procedure in docs/modding/tools/mods_debug_menu.md and CLAUDE.md's golden
  rules.

  This file only declares the flag's type and registers the menu row. The flag
  itself, *mod-transport-ag-alert-enable*, is defined (define-perm, #f default)
  in goal_src/jak2/levels/city/traffic/traffic-manager.gc -- a non-debug file
  resident in the CWI DGO next to every site that reads it -- so the gated code
  compiles in release builds too (this menu file is (declare-file (debug)) and
  is stripped from release).

  The whole mod is one cohesive behaviour (a scripted Crimson Guard troop
  transport drops in while the city alert level is >= 1, one per minute), so a
  single master toggle is all that is exposed. With it OFF the city plays
  exactly like stock Jak 2.

  Wiring: "transport-ag-alert-menu.o" is listed in goal_src/jak2/dgos/game.gd
  immediately after "mods-menu.o".
|#

;; debug-only file: stripped from release builds like the rest of the menu code.
(declare-file (debug))

;; the flag lives in traffic-manager.gc; just declare its type for this file.
(define-extern *mod-transport-ag-alert-enable* symbol)

;; ============================================================================
;; Menu builder -- pure: only builds and returns the submenu node.
;; ============================================================================

(defun mod-transport-ag-alert-build-menu ((ctx debug-menu-context))
  "Return the 'transport-ag-alert' submenu node."
  (debug-menu-make-from-template ctx
    '(menu "transport-ag-alert"
       ;; plain boolean -- the traffic code reads *mod-transport-ag-alert-enable*
       ;; live each frame, so the stock no-side-effect toggle pick-func is enough.
       (flag "Enable" *mod-transport-ag-alert-enable* dm-boolean-toggle-pick-func)
       )
    )
  )

;; ============================================================================
;; Register with the unified Mods tab (top-level, runs at file load / (mi)).
;; ============================================================================

(mods-menu-register "transport-ag-alert" mod-transport-ag-alert-build-menu)
