;;-*-Lisp-*-
(in-package goal)

;; name: yakow.gc
;; name in dgo: yakow
;; dgos: CFB, CFA

;; og:preserve-this MODDED - Jak 1-style yakow behavior (AI-assisted)
;; Adds: run-away, graze, graze-kicked states, walk/run animation blending,
;;       dark eco pill drops on death

;; DECOMP BEGINS

(defskelgroup skel-yakow yakow yakow-lod0-jg yakow-idle-ja
              ((yakow-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 1 0 4)
              )

(deftype yakow (nav-enemy)
  ((incoming-attack-id  uint32)
   (grazing             symbol)     ;; #t when in graze state
   (walk-run-blend      float)      ;; blend factor between walk and run anim (0.0 = walk, 1.0 = run)
   (walk-turn-blend     float)      ;; blend factor for turn animations (-1 = left, 1 = right)
   (run-mode            symbol)     ;; #t when running
   (home-base           vector :inline) ;; initial spawn position
   )
  (:state-methods
    kicked
    graze
    graze-kicked
    run-away
    )
  )


