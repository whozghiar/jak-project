;;-*-Lisp-*-
(in-package goal)

;; name: haven-city-chaos-h.gc
;; name in dgo: haven-city-chaos-h
;; dgos: GAME
;;
;; MOD "Haven City : Chaos" -- always-resident half.
;; ================================================================================================
;; This file carries every symbol the mod needs *outside* Haven City: the toggles the debug menu
;; writes, the stock-safe defaults for the hooks declared in `engine/ai/traffic-h.gc`, and the
;; level-borrow switch that turns the city into its metal-head-invasion variant.
;;
;; Why it lives in GAME.CGO and not next to the rest of the mod:
;;   - `guard.gc` / `traffic-engine.gc` / `traffic-manager.gc` / `nav-mesh.gc` read
;;     `*mod-chaos-enable*` and friends, and most of those ship in CWI.DGO, which is only
;;     resident while the player is in Haven City.
;;   - The debug menu (`pc/debug/haven-city-chaos-menu.gc`) can be opened anywhere, including in a
;;     level where CWI is gone. If the toggles lived in CWI they would be unbound symbols there.
;; The city-side half (`levels/city/chaos/*.gc`) overwrites the hook function pointers with real
;; implementations when CWI loads, and `mod-chaos-reset-hooks!` puts these no-ops back when it goes.
;;
;; Non-regression contract: with `*mod-chaos-enable*` at #f, every engine touch point is a single
;; symbol read that fails, so the city behaves exactly like retail.
;; ================================================================================================

;; ------------------------------------------------------------------------------------------------
;; 1. Player-visible toggles (written by the Debug > Mods > haven-city-chaos menu)
;; ------------------------------------------------------------------------------------------------

;; Master switch. Nothing below has any effect while this is #f.
(define *mod-chaos-enable* #f)

;; Hit-point multiplier for ambient Krimzon Guards (red riot + yellow rifle alike).
;; 1.0 = retail. `mod-chaos-set-enable!` flips this between 1.0 and MOD_CHAOS_GUARD_HP_SCALE.
(define *mod-chaos-guard-hp-scale* 1.0)

;; #t => guards drop Jak from their focus collide-spec and only fight metal heads.
(define *mod-chaos-guards-ignore-jak* #t)

;; HP scale + guard vehicles engaging metal heads.
(define *mod-chaos-guard-buffs* #t)

;; ------------------------------------------------------------------------------------------------
;; Per-species switches
;;
;; One symbol per metal head the mod can put in the city, each independently toggleable from
;; Debug > Mods > haven-city-chaos > species. The first three are the retail invasion species and
;; cost no extra memory, so they are on by default; the two chaos additions stream extra art into
;; LWIDEB and are off by default.
;; ------------------------------------------------------------------------------------------------

(define *mod-chaos-species-grunt*    #t)  ;; "Grunt"         traffic type  8  (metalhead-grunt)
(define *mod-chaos-species-flitter*  #t)  ;; "Stinger"       traffic type  9  (metalhead-flitter)
(define *mod-chaos-species-predator* #t)  ;; "Cloaker"       traffic type 10  (metalhead-predator)
(define *mod-chaos-species-juicer*   #f)  ;; "Juice goon"    traffic type 22  (chaos-juicer)
(define *mod-chaos-species-spyder*   #f)  ;; "Spyder gunner" traffic type 23  (chaos-spyder)

;; Set by the debug menu whenever a toggle changes something the city-side traffic table has to be
;; rebuilt from. The city half clears it on the next frame. This exists so the menu -- which is
;; GAME.CGO-resident and may be opened in a level where Haven City is not loaded at all -- never
;; has to call into CWI.DGO code directly.
(define *mod-chaos-species-dirty* #f)

;; ------------------------------------------------------------------------------------------------
;; 2. Tuning constants
;; ------------------------------------------------------------------------------------------------

;; "La vie des gardes (rouge & jaune) est multipliee par 1.5"
(defconstant MOD_CHAOS_GUARD_HP_SCALE 1.5)

;; ------------------------------------------------------------------------------------------------
;; Species mix
;;
;; The shares below are the percentages the mod advertises in its debug menu, straight from the
;; brief. They are *relative weights*, not absolute caps: `mod-chaos-apply-species!` sums the
;; shares of the species currently switched on and divides MOD_CHAOS_METALHEAD_POP between them in
;; proportion. Turning Juice goon and Spyder gunner off therefore does not thin the invasion out --
;; the three default species absorb their share.
;;
;; Why want-count and not a weighted random draw: the traffic engine already caps each type's live
;; population at `target-count` (`activate-by-type` refuses a type that is at its cap) and derives
;; `target-count` from `want-count`. The steady-state mix on screen is therefore governed by
;; want-count; the random pick only decides who is *offered* a free slot first. Weighting both
;; would double-count.
;; ------------------------------------------------------------------------------------------------

(defconstant MOD_CHAOS_SHARE_GRUNT    30)  ;; "Grunt"
(defconstant MOD_CHAOS_SHARE_FLITTER  30)  ;; "Stinger"
(defconstant MOD_CHAOS_SHARE_PREDATOR 10)  ;; "Cloaker"
(defconstant MOD_CHAOS_SHARE_JUICER   10)  ;; "Juice goon"
(defconstant MOD_CHAOS_SHARE_SPYDER    5)  ;; "Spyder gunner"

;; Total metal-head population budget, split between the enabled species in proportion to their
;; share. Retail `lwideb` runs 14 + 14 + 14 = 42; this is the "augmente les spawn rates" knob for
;; the metal-head side specifically.
;;
;; Two ceilings constrain this, and the second one is fatal rather than merely untidy:
;;
;;   - the pedestrian tracker holds at most 126 *live* processes
;;     (`traffic-tracker::active-object-list`), shared with citizens and guards;
;;   - `*default-nav-mesh*` holds at most `max-nav-control-count` *pooled* processes, and a
;;     city citizen keeps its slot for as long as its process exists, active or not. Overflowing
;;     it is a crash, not a degradation: `new-nav-control` returns #f and `nav-mesh::change-to`
;;     kills the process mid-`initialize`.
;;
;; `mod-chaos-nav-governor!` measures the free nav-mesh slots every frame and moves the budget to
;; suit, so this constant is a ceiling the mod climbs toward rather than a promise.
(defconstant MOD_CHAOS_METALHEAD_POP 60)

;; Where the governor starts on every city load, and the floor it will not climb down from until
;; the nav-mesh is genuinely under pressure. Deliberately below retail's 42: the first frames of a
;; city load run `spawn-all` in fast-spawn mode (120 spawns in one frame), which is the one moment
;; the governor cannot react inside, so the budget has to be safe *before* it starts measuring.
(defconstant MOD_CHAOS_START_POP 24)

;; No species is ever given fewer than this, so a 5%-share species still actually shows up.
(defconstant MOD_CHAOS_MIN_WANT 3)

;; ------------------------------------------------------------------------------------------------
;; The hard per-type ceiling, and why exceeding it leaks processes
;;
;; `traffic-engine::reset-and-init-from-manager` hands every traffic type a *fixed 20-handle window*
;; into `traffic-tracker::inactive-object-array`:
;;
;;   (set! (-> a1-3 array) v1-4)
;;   (set! v1-4 (&-> v1-4 20))     ;; next type starts 20 handles later
;;
;; and `add-reserved-process` refuses -- silently -- to record a 21st:
;;
;;   (when (< a1-2 20) ... (+! (-> v1-2 inactive-count) 1) ...)
;;
;; `spawn-all` spawns while `active-count + inactive-count < want-count`, so with a want-count above
;; 20 and nothing activated yet the counters stall at 20 while the test stays true. Every frame a
;; fresh process is created, its handle is dropped on the floor, and nothing can ever find it again:
;; it is in no tracker list, `kill-excess-once` cannot see it, and it holds its `nav-control` slot on
;; `*default-nav-mesh*` until the level is torn down. That is a one-process-per-frame leak that ends
;; in `nav-mesh::new-nav-control: too many users`.
;;
;; Retail never comes close -- its largest want-count is 15 -- which is why nothing in the stock
;; engine guards against it. Every want-count the mod writes is clamped to this.
(defconstant MOD_CHAOS_WANT_MAX 20)

;; Governor thresholds, in free `nav-control` slots on `*default-nav-mesh*`:
;; below LOW the metal-head budget is cut back, above HIGH it is allowed to grow again.
;; The gap between them is hysteresis -- without it the budget would oscillate every frame.
;;
;; LOW only has to cover what can be allocated between two governor ticks, and the governor runs
;; every frame while `spawn-all` adds at most one pooled process per frame outside the fast-spawn
;; burst, so 16 is generous.
(defconstant MOD_CHAOS_NAV_LOW 16)
(defconstant MOD_CHAOS_NAV_HIGH 32)

;; How fast the budget moves. Asymmetric on purpose: giving slots back has to be faster than taking
;; them, because running out is fatal and running lean is only disappointing.
(defconstant MOD_CHAOS_POP_SHRINK 4)
(defconstant MOD_CHAOS_POP_GROW 1)

;; ------------------------------------------------------------------------------------------------
;; Ambient density ("augmente les spawn rates", inspired by jak2/config/enhanced_spawnrates)
;;
;; Three levers, all inert while the mod is off:
;;   - want-count bumps for the guard-side traffic types, so there is someone to fight the
;;     invasion (`mod-chaos-boost-ambient!` in chaos-city.gc);
;;   - a lower `inv-density-factor`, which packs traffic more tightly per nav segment;
;;   - wider per-cell activation ranges, so the denser population stays populated further from
;;     the camera (traffic-engine.gc).
;;
;; The fourth thing the extra population needs is not a toggle but a capacity: `*default-nav-mesh*`
;; in nav-mesh.gc grew from 128 to 192 slots. That one is unconditional -- it is a static object
;; sized at compile time, and an unused slot costs nothing but its 288 bytes.
;; ------------------------------------------------------------------------------------------------

;; Note the ceiling: MOD_CHAOS_WANT_MAX is 20 and these are clamped to it, so 20 is as dense as the
;; Krimzon Guard garrison can be made without leaking processes. The guard *vehicles* are the lever
;; left for going denser than that -- each one carries a rider.
(defconstant MOD_CHAOS_WANT_CRIMSON_GUARD_1 20)  ;; traffic type  6, retail 9
(defconstant MOD_CHAOS_WANT_GUARD_BIKE       9)  ;; traffic type 18, retail 4
(defconstant MOD_CHAOS_WANT_HELLCAT          7)  ;; traffic type 19, retail 3

;; Retail is 5.0; lower packs traffic tighter.
(defconstant MOD_CHAOS_INV_DENSITY_FACTOR 3.0)

;; ------------------------------------------------------------------------------------------------
;; 3. Stock-safe hook defaults
;;
;; These stand in whenever the city half is not loaded. They are deliberately dumb: the engine only
;; calls a hook after testing `*mod-chaos-enable*`, and that can only matter with CWI resident, so
;; in practice these run at most during the frame CWI is being torn down.
;; ------------------------------------------------------------------------------------------------

(defun mod-chaos-citizen-type-default ((traffic object))
  "Fallback pedestrian draw: reproduce the retail uniform pick over traffic types 0..10."
  (the-as traffic-type (rand-vu-int-count 11))
  )

(defun mod-chaos-spawn-default ((parent process) (params object))
  "Fallback spawn dispatch: claim nothing, so `traffic-object-spawn` runs its own retail case."
  (the-as process-drawable #f)
  )

(defun mod-chaos-traffic-update-default ((mgr traffic-manager))
  "Fallback per-frame hook: do nothing."
  0
  (none)
  )

(defun mod-chaos-lwide-activate-default ((level-name symbol))
  "Fallback borrow-level hook: do nothing."
  0
  (none)
  )

(define *mod-chaos-citizen-type-hook* mod-chaos-citizen-type-default)
(define *mod-chaos-spawn-hook* mod-chaos-spawn-default)
(define *mod-chaos-traffic-update-hook* mod-chaos-traffic-update-default)
(define *mod-chaos-lwide-activate-hook* mod-chaos-lwide-activate-default)

(defun mod-chaos-reset-hooks! ()
  "Point every hook above back at the always-resident defaults. Called when Haven City unloads so
   the function pointers can never outlive the CWI heap the real implementations live in."
  (set! *mod-chaos-citizen-type-hook* mod-chaos-citizen-type-default)
  (set! *mod-chaos-spawn-hook* mod-chaos-spawn-default)
  (set! *mod-chaos-traffic-update-hook* mod-chaos-traffic-update-default)
  (set! *mod-chaos-lwide-activate-hook* mod-chaos-lwide-activate-default)
  0
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; 4. The city-variant switch
;; ------------------------------------------------------------------------------------------------

(defun mod-chaos-apply-borrow! ((on symbol))
  "Force Haven City onto (or off) its metal-head-invasion variant.

   Haven City picks the contents of its ambient population from whichever level is borrowed into
   `ctywide` slot 1. Retail uses `lwidea` (citizens + traffic + guards) for most of the story and
   swaps to `lwideb` for the late-game invasion; `lwideb` is the one that carries grunt / flitter /
   predator art, and `lwide-activate` is what turns those traffic types on, raises the alert level
   and -- crucially for this mod -- clears the `target-jak` alert flag so guards stop caring about
   Jak. Forcing `lwideb` therefore gets us the invasion *and* the guards-ignore-Jak truce for free.

   The borrow normally comes from the open game-task nodes, but `update-task-masks` applies the
   `borrow` setting *after* every node, so a setting always wins. Writing `user-default` rather
   than opening a `set-setting!` connection keeps the override alive without tying it to the
   lifetime of whichever process happened to toggle the menu.

   @param on #t to force the invasion city, #f to hand control back to the story."
  (set! (-> *setting-control* user-default borrow)
        (if on
            '((ctywide 1 lwideb special))
            '()
            )
        )
  ;; Recompute user-current from user-default; the borrow comparison inside `apply-settings`
  ;; fires `update-task-masks 'event`, which re-runs `borrow-eval` and `add-borrow-levels`
  ;; so the level system streams `lwideb` in (or drops it again).
  (apply-settings *setting-control*)
  0
  (none)
  )

(defun mod-chaos-set-enable! ((on symbol))
  "Single entry point for turning the mod on and off. Safe to call anywhere, including outside
   Haven City -- the city-side effects are all re-derived from `*mod-chaos-enable*` the next time
   the traffic manager runs."
  (set! *mod-chaos-enable* on)
  (set! *mod-chaos-guard-hp-scale*
        (if (and on *mod-chaos-guard-buffs*)
            MOD_CHAOS_GUARD_HP_SCALE
            1.0
            )
        )
  (set! *mod-chaos-species-dirty* #t)
  (mod-chaos-apply-borrow! on)
  0
  (none)
  )
