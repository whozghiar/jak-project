(set! (-> *yakow-nav-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

;; og:preserve-this Changed: returns 1 damage per hit instead of 0 so yakow can die
(defmethod damage-amount-from-attack ((this yakow) (arg0 process) (arg1 event-message-block))
  "@returns the amount of damage taken from an attack.  This can come straight off the [[attack-info]] or via [[penetrate-using->damage]]"
  1
  )

(defmethod general-event-handler ((this yakow) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "Handles various events for the enemy
@TODO - unsure if there is a pattern for the events and this should have a more specific name"
  (case arg2
    (('attack)
     ;; og:preserve-this Let the parent handle damage processing (HP decrement, death check)
     ;; The parent will then send 'hit-knocked or 'hit which we intercept below
     (format #t "yakow: received 'attack event, HP=~D, grazing=~A~%" (-> this hit-points) (-> this grazing))
     
     ;; og:preserve-this Trigger Krimzon Guard alert when hitting a yakow! (Crime contre la nature)
     (if *traffic-manager*
         (send-event *traffic-manager* 'set-alert-level 1)
     )
     ((method-of-type nav-enemy general-event-handler) this arg0 arg1 arg2 arg3)
     )
    (('hit-knocked 'hit)
     ;; og:preserve-this Intercept hit/knocked events from parent's attack processing
     ;; If HP > 0, go to kicked/graze-kicked. If HP = 0, let die happen.
     (format #t "yakow: received '~A event, HP=~D, grazing=~A~%" arg2 (-> this hit-points) (-> this grazing))
     (cond
       ((zero? (-> this hit-points))
        ;; Dead - let the parent handler trigger die
        (format #t "yakow: HP is 0, going to die!~%")
        ((method-of-type nav-enemy general-event-handler) this arg0 arg1 arg2 arg3)
        )
       (else
        ;; Still alive - go to our custom kicked states
        (format #t "yakow: HP > 0, going to kicked/graze-kicked~%")
        (if (-> this grazing)
            (go (method-of-object this graze-kicked))
            (go (method-of-object this kicked))
            )
        )
       )
     )
    (else
      ((method-of-type nav-enemy general-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defmethod rnd-go-idle? ((this yakow) (arg0 float))
  "TODO"
  (>= arg0 (rand-vu))
  )

;; WARN: Function (method 156 yakow) has a return type of none, but the expression builder found a return statement.
(defmethod nav-enemy-method-156 ((this yakow))
  (dotimes (s5-0 16)
    (let ((f30-1 (* 4096.0 (rnd-float-range this -10.0 10.0)))
          (f0-2 (* 4096.0 (rnd-float-range this -10.0 10.0)))
          (s4-0 (new 'stack-no-clear 'vector))
          )
      (set! (-> s4-0 quad) (-> this root trans quad))
      (+! (-> s4-0 x) f30-1)
      (+! (-> s4-0 z) f0-2)
      (let ((v1-7 (-> this nav))
            (a0-6 s4-0)
            (a1-2 (new 'stack-no-clear 'nav-find-poly-parms))
            )
        (vector-! (-> a1-2 point) a0-6 (-> v1-7 state mesh bounds))
        (set! (-> a1-2 y-threshold) (-> v1-7 nearest-y-threshold))
        (set! (-> a1-2 ignore) (the-as uint 2))
        (when (find-poly-containing-point-local (-> v1-7 state mesh) a1-2)
          (let ((v1-12 (-> this nav state)))
            (logclear! (-> v1-12 flags) (nav-state-flag directional-mode))
            (logior! (-> v1-12 flags) (nav-state-flag target-poly-dirty))
            (set! (-> v1-12 target-post quad) (-> s4-0 quad))
            )
          0
          (return #f)
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this Helper: check if yakow is facing a given direction
(defbehavior yakow-facing-direction? yakow ((arg0 vector) (arg1 float))
  (let ((s4-0 (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat)))
        (s5-0 (new 'stack-no-clear 'vector))
        )
    (set! (-> s5-0 quad) (-> arg0 quad))
    (set! (-> s5-0 y) 0.0)
    (vector-normalize! s5-0 1.0)
    (>= (vector-dot s4-0 s5-0) (cos arg1))
    )
  )

;; og:preserve-this Helper: check if yakow is facing a point
(defbehavior yakow-facing-point? yakow ((arg0 vector) (arg1 float))
  (let ((v1-1 (vector-! (new 'stack-no-clear 'vector) arg0 (-> self root trans))))
    (yakow-facing-direction? v1-1 arg1)
    )
  )

;; og:preserve-this Helper: check if yakow is facing the player
(defbehavior yakow-facing-player? yakow ((arg0 float))
  (if *target*
      (yakow-facing-point? (get-trans *target* 0) arg0)
      #f
      )
  )

;; ==========================================
;; IDLE STATE - Jak 1 style with graze chance
;; ==========================================
(defstate idle (yakow)
  :virtual #t
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.15))
    (until #f
      (let ((f30-0 (rand-vu-float-range 0.9 1.1)))
        (ja-no-eval :group! yakow-idle-ja :num! (seek! max f30-0) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max f30-0))
          )
        )
      (when (rand-vu-percent? 0.25)
        (ja-channel-push! 1 (seconds 0.1))
        (ja-no-eval :group! yakow-graze-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!))
          )
        (ja-channel-push! 1 (seconds 0.1))
        )
      )
    #f
    )
  :post (behavior ()
    (if (and (nonzero? (-> self draw)) (logtest? (-> self draw status) (draw-control-status on-screen)))
        (set-time! (-> self last-draw-time))
        )
    (enemy-method-129 self)
    ;; og:preserve-this If player is near and not facing them, go to run-away
    (when (and *target*
               (< (vector-vector-distance (-> self root trans) (get-trans *target* 0)) (meters 10))
               (not (yakow-facing-player? 21845.334))
               )
      (go-virtual run-away)
      )
    (ja-post)
    )
  )

;; ==========================================
;; GRAZE STATE - Dedicated grazing behavior (inspired by Jak 1)
;; ==========================================
(defstate graze (yakow)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (format #t "yakow: entering GRAZE state~%")
    (set-time! (-> self state-time))
    (set! (-> self grazing) #t)
    (let ((v1-2 self))
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logclear (-> v1-2 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-2 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    )
  :exit (behavior ()
    (format #t "yakow: exiting GRAZE state~%")
    (set! (-> self grazing) #f)
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.15))
    (until #f
      (let ((f30-0 (rand-vu-float-range 0.9 1.1)))
        (ja-no-eval :group! yakow-idle-ja :num! (seek! max f30-0) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max f30-0))
          )
        )
      (when (rand-vu-percent? 0.5)
        (ja-channel-push! 1 (seconds 0.1))
        (ja-no-eval :group! yakow-graze-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek!))
          )
        (ja-channel-push! 1 (seconds 0.1))
        )
      )
    #f
    )
  :post (behavior ()
    ;; Check if player is near - if so, stop grazing and flee
    (when (and *target*
               (< (vector-vector-distance (-> self root trans) (get-trans *target* 0)) (meters 10))
               (not (yakow-facing-player? 21845.334))
               )
      (go-virtual run-away)
      )
    (ja-post)
    )
  )

;; ==========================================
;; GRAZE-KICKED STATE - Hit while grazing (inspired by Jak 1)
;; ==========================================
(defstate graze-kicked (yakow)
  :virtual #t
  :event #f
  :enter (behavior ()
    (format #t "yakow: entering GRAZE-KICKED state~%")
    (let ((v1-0 self))
      (set! (-> v1-0 enemy-flags) (the-as enemy-flag (logclear (-> v1-0 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-0 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    (set-time! (-> self state-time))
    )
  :code (behavior ()
    (format #t "yakow: playing graze-kicked animation~%")
    (ja-channel-push! 1 (seconds 0.05))
    (ja-no-eval :group! yakow-kicked-in-place-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    ;; After being kicked while grazing, flee
    (go-virtual run-away)
    )
  :post ja-post
  )

;; ==========================================
;; ACTIVE STATE - Walk around with run blending
;; ==========================================
(defstate active (yakow)
  :virtual #t
  :trans (behavior ()
    (when (time-elapsed? (-> self state-time) (seconds 0.1))
      (if (< (the-as int (-> self focus aware)) 1)
          (go-virtual idle)
          )
      ;; og:preserve-this If player is near and yakow not facing them, flee
      (when (and *target*
                 (< (vector-vector-distance (-> self root trans) (get-trans *target* 0)) (meters 10))
                 (not (yakow-facing-player? 21845.334))
                 )
        (go-virtual run-away)
        )
      )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (let ((f30-0 (rnd-float-range self 0.9 1.1)))
      (until #f
        (ja-no-eval :group! (-> self draw art-group data (-> self enemy-info walk-anim))
                    :num! (seek! max f30-0)
                    :frame-num 0.0
                    )
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max f30-0))
          )
        (when (rnd-go-idle? self 0.2)
          (ja-no-eval :num! (loop!))
          (ja-channel-push! 1 (seconds 0.6))
          (let ((v1-37 self))
            (set! (-> v1-37 enemy-flags) (the-as enemy-flag (logclear (-> v1-37 enemy-flags) (enemy-flag enemy-flag36))))
            (set! (-> v1-37 nav callback-info) *nav-enemy-null-callback-info*)
            )
          0
          (nav-enemy-method-167 self)
          (until #f
            (let ((f28-0 (rand-vu-float-range 0.9 1.1)))
              (ja-no-eval :group! yakow-idle-ja :num! (seek! max f28-0) :frame-num 0.0)
              (until (ja-done? 0)
                (suspend)
                (ja :num! (seek! max f28-0))
                )
              )
            (when (rand-vu-percent? 0.25)
              (ja-channel-push! 1 (seconds 0.1))
              (ja-no-eval :group! yakow-graze-ja :num! (seek!) :frame-num 0.0)
              (until (ja-done? 0)
                (suspend)
                (ja :num! (seek!))
                )
              (ja-channel-push! 1 (seconds 0.1))
              )
            (if (rnd-go-idle? self 0.2)
                (goto cfg-15)
                )
            )
          #f
          (label cfg-15)
          (let ((v1-97 (-> self nav state)))
            (set! (-> v1-97 speed) 0.0)
            )
          0
          (let ((a0-23 (-> self nav state))
                (v1-100 *null-vector*)
                )
            (set! (-> a0-23 velocity quad) (-> v1-100 quad))
            )
          0
          (let ((v1-103 self))
            (if (not (logtest? (enemy-flag enemy-flag36) (-> v1-103 enemy-flags)))
                (set! (-> v1-103 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag38) (-> v1-103 enemy-flags))))
                )
            (set! (-> v1-103 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag36) (-> v1-103 enemy-flags))))
            (set! (-> v1-103 nav callback-info) (-> v1-103 enemy-info callback-info))
            )
          0
          (nav-enemy-method-165 self)
          (ja-no-eval :num! (loop!))
          (ja-channel-push! 1 (seconds 0.6))
          (ja-no-eval :group! (-> self draw art-group data (-> self enemy-info walk-anim))
                      :num! (seek! max f30-0)
                      :frame-num 0.0
                      )
          (until (ja-done? 0)
            (ja-blend-eval)
            (suspend)
            (ja :num! (seek! max f30-0))
            )
          )
        )
      )
    #f
    )
  )

;; ==========================================
;; KICKED STATE - Inspired by Jak 1 yakow-kicked
;; ==========================================
(defstate kicked (yakow)
  :virtual #t
  :event #f
  :enter (behavior ()
    (format #t "yakow: entering KICKED state, HP=~D, grazing=~A~%" (-> self hit-points) (-> self grazing))
    (let ((v1-0 self))
      (set! (-> v1-0 enemy-flags) (the-as enemy-flag (logclear (-> v1-0 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-0 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    (set-time! (-> self state-time))
    ;; og:preserve-this If we were grazing, redirect to graze-kicked
    (if (-> self grazing)
        (go-virtual graze-kicked)
        )
    )
  :exit (behavior ()
    '()
    )
  :trans (behavior ()
    '()
    )
  :code (behavior ()
    (sound-play "grunt-hit")
    (ja-channel-push! 1 (seconds 0.05))
    (ja-no-eval :group! yakow-kicked-in-place-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    ;; og:preserve-this After kick animation, flee like Jak 1
    (go-virtual run-away)
    )
  :post ja-post
  )

;; ==========================================
;; RUN-AWAY STATE - Flee from player (inspired by Jak 1 yakow-run-away)
;; ==========================================
(defstate run-away (yakow)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (format #t "yakow: entering RUN-AWAY state~%")
    (set-time! (-> self state-time))
    (set! (-> self grazing) #f)
    ;; Set up run speed via nav-enemy-method-166
    (nav-enemy-method-166 self)
    ;; Enable nav movement
    (let ((v1-4 self))
      (if (not (logtest? (enemy-flag enemy-flag36) (-> v1-4 enemy-flags)))
          (set! (-> v1-4 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag38) (-> v1-4 enemy-flags))))
          )
      (set! (-> v1-4 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag36) (-> v1-4 enemy-flags))))
      (set! (-> v1-4 nav callback-info) (-> v1-4 enemy-info callback-info))
      )
    0
    (let ((v1-7 self))
      (set! (-> v1-7 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag37) (-> v1-7 enemy-flags))))
      )
    0
    )
  :trans (behavior ()
    ;; If player is far away (> 20m) or gone, return to idle or graze
    (when (or (not *target*)
              (< (meters 20)
                 (vector-vector-distance (-> self root trans) (get-trans *target* 0))
                 )
              )
      ;; Slow down and transition back
      (go-virtual active)
      )
    )
  :code (behavior ()
    ;; og:preserve-this Run animation loop using yakow-run-ja
    (ja-channel-push! 1 (seconds 0.1))
    (until #f
      (ja-no-eval :group! yakow-run-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    ;; og:preserve-this Flee post: compute direction away from player and move there
    (let ((a0-1 (handle->process (-> self focus handle))))
      (when a0-1
        (let ((gp-1
                (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (get-trans (the-as process-focusable a0-1) 0))
                )
              )
          (set! (-> gp-1 y) 0.0)
          (vector-normalize! gp-1 409600.0)
          (vector+! gp-1 gp-1 (-> self root trans))
          (let ((v1-10 (-> self nav state)))
            (logclear! (-> v1-10 flags) (nav-state-flag directional-mode))
            (logior! (-> v1-10 flags) (nav-state-flag target-poly-dirty))
            (set! (-> v1-10 target-post quad) (-> gp-1 quad))
            )
          )
        0
        )
      )
    (nav-enemy-method-176 self)
    0
    (none)
    )
  )

;; ==========================================
;; DIE STATE - Drop dark eco pills and disappear
;; ==========================================
(defstate die (yakow)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (format #t "yakow: entering DIE state! HP=~D~%" (-> self hit-points))
    (dying self)
    (let ((v1-3 (-> self root root-prim)))
      (set! (-> v1-3 prim-core collide-as) (collide-spec))
      (set! (-> v1-3 prim-core collide-with) (collide-spec))
      )
    0
    (set-time! (-> self state-time))
    (set! (-> self hit-points) 0)
    ;; og:preserve-this Spawn dark eco pills around our position
    (format #t "yakow: spawning 5 dark eco pills around position~%")
    (let ((s5-0 (new 'stack-no-clear 'vector)))
      (dotimes (s4-0 5)
        (set! (-> s5-0 quad) (-> self root trans quad))
        ;; Disperse in a ~1.5 meter radius (6144.0)
        (+! (-> s5-0 x) (rnd-float-range self -6144.0 6144.0))
        (+! (-> s5-0 z) (rnd-float-range self -6144.0 6144.0))
        ;; Add a bit of vertical offset
        (+! (-> s5-0 y) (rnd-float-range self 0.0 4096.0))
        (birth-pickup-at-point s5-0 (pickup-type eco-pill-dark) 1.0 #t *entity-pool* (-> self fact))
        )
      )
    ;; Prevent the engine from dropping the default pickup-type during cleanup
    (set! (-> self fact pickup-type) (pickup-type none))
    )
  :code (behavior ()
    ;; Leave standard purple particles upon disappearance (using manual particle launch because Yakow skeleton lacks the effect)
    (sound-play "enemy-fizz")
    (let ((v1-2 (-> self root trans)))
      (launch-particles (-> *part-id-table* 74) v1-2)
      (launch-particles (-> *part-id-table* 72) v1-2)
      )
    (send-event self 'death-end)
    (while (-> self child)
      (suspend)
      )
    (cleanup-for-death self)
    )
  :post enemy-simple-post
  )

(defmethod init-enemy-collision! ((this yakow))
  "Initializes the [[collide-shape-moving]] and any ancillary tasks to make the enemy collide properly"
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate
                                    generic-attack
                                    lunge
                                    flop
                                    punch
                                    spin
                                    roll
                                    uppercut
                                    bonk
                                    tube
                                    vehicle
                                    flut-attack
                                    board
                                    mech-punch
                                    dark-punch
                                    dark-giant
                                    )
          )
    (let ((v1-7 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-7 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-7 prim-core collide-with) (collide-spec backgnd jak player-list))
      (set! (-> v1-7 prim-core action) (collide-action solid no-standon))
      (set-vector! (-> v1-7 local-sphere) 0.0 4096.0 0.0 10240.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-7)
      )
    (set! (-> s5-0 nav-radius) 10240.0)
    (let ((v1-9 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-9 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-enemy! ((this yakow))
  "Common method called to initialize the enemy, typically sets up default field values and calls ancillary helper methods"
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-yakow" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (init-enemy-behaviour-and-stats! this *yakow-nav-enemy-info*)
  (let ((v1-5 (-> this nav)))
    (set! (-> v1-5 speed-scale) 1.0)
    )
  0
  (set-gravity-length (-> this root dynam) 327680.0)
  ;; og:preserve-this Initialize new fields
  (set! (-> this grazing) #f)
  (set! (-> this walk-run-blend) 0.0)
  (set! (-> this walk-turn-blend) 0.0)
  (set! (-> this run-mode) #f)
  (set! (-> this home-base quad) (-> this root trans quad))
  0
  (none)
  )
