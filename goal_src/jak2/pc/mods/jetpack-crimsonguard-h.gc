;;-*-Lisp-*-
(in-package goal)

;; name: jetpack-crimsonguard-h.gc
;; name in dgo: jetpack-crimsonguard-h
;; dgos: GAME
;;
;; MOD "Jetpack Crimson Guard" -- always-resident half.
;; ================================================================================================
;; Jak 2 already ships a jet-propelled Krimzon Guard: `crimson-guard-hover`, the one that patrols
;; the Fortress rescue, the Drill Platform and Haven Forest. It never appears in Haven City for one
;; concrete reason -- it navigates with `hover-nav-control`, which paths through a per-level
;; `nav-network` (`*forest-adjacency*`, `*drill-adjacency*`, ...), and Haven City has none.
;;
;; This mod puts it in the city anyway. See `levels/city/jetpack/jetpack-guard.gc` for how the
;; missing network is sidestepped; this file only carries the toggles, which have to be readable
;; from the debug menu in levels where CWI.DGO is not resident.
;;
;; Off by default: with `*mod-jetpack-enable*` at #f the only cost is one symbol read per frame
;; inside `traffic-manager::update`.
;; ================================================================================================

;; Master switch.
(define *mod-jetpack-enable* #f)

;; How many jetpack guards may patrol at once. They are `hover-enemy`s with particle trails and a
;; per-instance `hover-nav-control`, so this stays small.
(defconstant MOD_JETPACK_MAX_GUARDS 3)

;; Chance, in percent, that a dispatch roll produces a guard.
(defconstant MOD_JETPACK_SPAWN_PERCENT 35)

;; How often a dispatch roll is made.
(defconstant MOD_JETPACK_ROLL_PERIOD (seconds 6))

;; Where a new guard appears relative to the player: this far out horizontally, this far up.
;; Far enough that they fly in rather than pop in on top of Jak, close enough to join the fight.
(defconstant MOD_JETPACK_SPAWN_DIST (meters 45))
(defconstant MOD_JETPACK_SPAWN_HEIGHT (meters 18))

;; Beyond this distance from the player a guard is recycled -- they have no city nav graph to
;; patrol, so one that has chased a metal head off into the distance is just wasted budget.
(defconstant MOD_JETPACK_CULL_DIST (meters 140))

;; How far a guard looks for a metal head to engage.
(defconstant MOD_JETPACK_PREY_DIST (meters 60))

;; The dispatcher itself lives in `levels/city/jetpack/jetpack-guard.gc` (CWI.DGO), which is
;; compiled after `traffic-manager.gc` -- the file that calls it. Hence the forward declaration
;; here, in the always-resident half.
(define-extern mod-jetpack-tick (function traffic-manager none))
