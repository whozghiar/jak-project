;;-*-Lisp-*-
(in-package goal)

#|
  ============================================================================
  dark-jak-enhanced-menu.gc -- Debug > Mods > dark-jak-enhanced
  ============================================================================

  Registers the Dark Jak Enhanced mod's on/off switch with the unified "Mods"
  debug tab (goal_src/jak2/pc/debug/mods-menu.gc), per the mandatory procedure
  in docs/modding/tools/mods_debug_menu.md and CLAUDE.md's golden rules.

  This file only flips the switch and registers the menu row. The flag itself,
  *mod-dark-jak-enhanced-enable*, is defined (define-perm, #f default) in
  goal_src/jak2/engine/target/target-h.gc -- a non-debug header loaded very early
  in GAME.CGO -- so all the target/*.gc code that reads it compiles in every
  build. See the block comment there.

  Every behaviour the mod adds is a single cohesive package (the 3-tier
  evolution, R2 cancel, full eco drain, instant Dark Bomb, collision-resilient
  Dark Blast, Level-1 rolling, titan camera/footsteps), so one master toggle is
  all that is exposed. With it OFF the player is stock Jak 2 Dark Jak.

  Wiring: "dark-jak-enhanced-menu.o" is listed in goal_src/jak2/dgos/game.gd
  immediately after "mods-menu.o".
|#

;; debug-only file: stripped from release builds like the rest of the menu code.
(declare-file (debug))

;; the flag lives in target-h.gc; just declare its type for this file.
(define-extern *mod-dark-jak-enhanced-enable* symbol)

;; ============================================================================
;; Menu builder
;; ============================================================================

(defun mod-dark-jak-enhanced-build-menu ((ctx debug-menu-context))
  "Return the 'dark-jak-enhanced' submenu node. Pure: only builds and returns a node."
  (debug-menu-make-from-template ctx
    '(menu "dark-jak-enhanced"
       ;; plain boolean -- the target code reads *mod-dark-jak-enhanced-enable* live,
       ;; so the stock toggle pick-func (no side effect) is all that is needed.
       (flag "Enable" *mod-dark-jak-enhanced-enable* dm-boolean-toggle-pick-func)
       )
    )
  )

;; ============================================================================
;; Register with the unified Mods tab (top-level, runs at file load / (mi))
;; ============================================================================

(mods-menu-register "dark-jak-enhanced" mod-dark-jak-enhanced-build-menu)
