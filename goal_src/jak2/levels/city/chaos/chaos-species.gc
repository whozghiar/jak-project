;;-*-Lisp-*-
(in-package goal)

;; name: chaos-species.gc
;; name in dgo: chaos-species
;; dgos: CWI
;;
;; MOD "Haven City : Chaos" -- the extra metal-head species.
;; ================================================================================================
;; Retail Haven City knows exactly three metal heads: `metalhead-grunt`, `metalhead-flitter` and
;; `metalhead-predator`. They are not the standalone `grunt` / `flitter` / `predator` enemies --
;; they are `citizen-enemy` subclasses that reuse the *same art groups* ("skel-grunt" and friends)
;; but plug into the city traffic engine: they are pooled, recycled, walk the city nav-graph and
;; take part in the guard-vs-metal-head war.
;;
;; This file follows exactly that recipe for two species that never set foot in the city:
;;
;;   chaos-juicer  "Juice goon"     (levels/atoll/juicer.gc)
;;   chaos-spyder  "Spyder gunner"  (levels/common/enemy/spyder.gc)
;;
;; Everything that makes a city enemy work already lives in `citizen-enemy`:
;;   - `citizen-init!` derives the walk / run animation slots and travel speeds from `enemy-info`;
;;   - the `active` state walks the nav-graph playing `walk-anim`;
;;   - `citizen-enemy-method-202` picks the nearest valid focus (guard, citizen or Jak) and
;;     `go-hostile`s at it;
;;   - `traffic-danger-init!` makes vehicles swerve around them.
;; So a new species needs only three things: which skeleton to wear, which `nav-enemy-info` to be
;; tuned by, and a collide-shape. We take all three straight from the retail enemy, which is why
;; each species below is barely forty lines and why their stats match the originals exactly.
;;
;; Two things we do have to add, because a retail arena enemy and a city enemy differ there:
;;   - a `hostile` :code thread. `nav-enemy`'s own `hostile` has no :code, so an inherited chase
;;     would keep playing the walk animation from `active` while moving at run speed.
;;   - a city-shaped overlap filter and a melee cadence -- see `common-post` and the
;;     MOD_CHAOS_MELEE_PERIOD block in `hostile` below. Without those the new species and the
;;     Krimzon Guards are mutually intangible.
;; ================================================================================================

;; ------------------------------------------------------------------------------------------------
;; Shared base
;; ------------------------------------------------------------------------------------------------

;; How often a metal head locked in melee is allowed to land a hit.
;;
;; Damage between two `enemy`s flows through `enemy-method-75` -> `enemy-method-104`, which sends
;; an `attack` event stamped with the attacker's `attack-id`. The victim remembers the last id it
;; took damage from, so an unchanging id lands exactly once however long the contact lasts. Retail
;; enemies get a fresh id every time they enter their `attack` state; `chaos-metalhead` has no
;; scripted attack animation to enter (see the note on the retail states below), so it re-stamps
;; on this cadence instead, which is what turns a permanent shove into a repeating melee.
(defconstant MOD_CHAOS_MELEE_PERIOD (seconds 0.8))

;; Ranged attack. The species that have a projectile in their retail form fire it on this cadence
;; while they have a focus in the band below -- close enough to be worth a shot, far enough that
;; they are not already in melee.
(defconstant MOD_CHAOS_SHOT_PERIOD (seconds 1.5))
(defconstant MOD_CHAOS_SHOT_MIN_DIST (meters 8))
(defconstant MOD_CHAOS_SHOT_MAX_DIST (meters 45))

(deftype chaos-metalhead (citizen-enemy)
  ((next-melee-time  time-frame)
   (next-shot-time   time-frame)
   )
  (:methods
    ;; Name of the skeleton group to wear, e.g. "skel-juicer". Resolved through
    ;; `art-group-get-by-name`, so the matching `<x>-ag.go` must be in a resident DGO
    ;; (the mod puts them in LWIDEB.DGO -- see goal_src/jak2/dgos/lwideb.gd).
    (chaos-skel-name (_type_) string)
    ;; Animation index to play while chasing. Falls back to the walk animation for species
    ;; that ship with `run-anim -1`.
    (chaos-chase-anim (_type_) int)
    ;; The `nav-enemy-info` this species is tuned by. NOT inherited from anywhere: `metalhead-grunt`
    ;; declares `get-nav-info` in its own `:methods` block rather than `nav-enemy` or `enemy`
    ;; providing it, so the chaos hierarchy has to declare its own slot for it.
    (get-nav-info (_type_) nav-enemy-info)
    ;; Projectile this species fires, or #f for a melee-only one. `spawn-projectile` takes the
    ;; type at runtime (it is a plain function, not a macro), so one shared `chaos-fire!` can
    ;; serve every species.
    (chaos-shot-type (_type_) type)
    ;; Muzzle velocity, straight from the species' retail firing code -- the projectile types
    ;; differ in how they read it, so it is not shareable.
    (chaos-shot-speed (_type_) float)
    (chaos-fire! (_type_ process-focusable) none)
    )
  )

(defmethod chaos-skel-name ((this chaos-metalhead))
  "Subclasses must override; the base name would fail the art lookup on purpose."
  "skel-chaos-metalhead-unset"
  )

(defmethod chaos-chase-anim ((this chaos-metalhead))
  "Pick the chase animation, tolerating species that have no dedicated run cycle."
  (let ((run (-> this enemy-info run-anim)))
    (if (>= run 0)
        run
        (-> this enemy-info walk-anim)
        )
    )
  )

(defmethod get-nav-info ((this chaos-metalhead))
  "Base implementation. `chaos-metalhead` is abstract -- only the species below are ever spawned,
   and each overrides this -- but the slot needs a body, and it has to be a body that cannot crash
   `init-enemy-behaviour-and-stats!` if the hierarchy is ever extended carelessly. The city grunt's
   tuning is the closest thing to a neutral default."
  *metalhead-grunt-nav-enemy-info*
  )

(defmethod chaos-shot-type ((this chaos-metalhead))
  "Melee-only by default."
  (the-as type #f)
  )

(defmethod chaos-shot-speed ((this chaos-metalhead))
  "Unused unless `chaos-shot-type` is overridden."
  0.0
  )

(defmethod chaos-fire! ((this chaos-metalhead) (prey process-focusable))
  "Spawn one of this species' projectiles, aimed from our upper body at the target's.

   Modelled on `juicer::fire-projectile` and `spyder-method-183`, which build the same
   `projectile-init-by-other-params` and differ only in the projectile type and the muzzle speed.
   Two deliberate simplifications over those:

     - the muzzle is `(get-trans this 3)` rather than a named joint. The retail juicer fires from
       joint 20 of its own skeleton; hard-coding joint indices for a shared base class is exactly
       the kind of drift that breaks silently when an art group changes, and the upper-body trans
       point is what every other city actor aims from anyway.
     - one shot per cadence, no `current-projectile` handle. The retail juicer keeps its shot alive
       and re-aims it; that is part of its scripted attack state, which a `citizen-enemy` subclass
       cannot enter (see the note on `hostile` below).

   `ignore-handle` is us, so the shot cannot detonate on the shooter. Both `juicer-shot` and
   `spyder-shot` (a `metalhead-shot`) already carry `civilian` and `enemy` in their collide-with,
   so they damage Krimzon Guards without any change to the projectile side."
  (let ((shot (chaos-shot-type this)))
    (when shot
      (let ((muzzle (new 'stack-no-clear 'vector))
            (params (new 'stack-no-clear 'projectile-init-by-other-params))
            )
        (set! (-> muzzle quad) (-> (get-trans this 3) quad))
        (set! (-> params ent) (-> this entity))
        (set! (-> params charge) 1.0)
        (set! (-> params options) (projectile-options))
        (set! (-> params notify-handle) (process->handle this))
        (set! (-> params owner-handle) (the-as handle #f))
        (set! (-> params ignore-handle) (process->handle this))
        (let* ((info *game-info*)
               (id (+ (-> info attack-id) 1))
               )
          (set! (-> info attack-id) id)
          (set! (-> params attack-id) id)
          )
        (set! (-> params timeout) (seconds 4))
        (set! (-> params pos quad) (-> muzzle quad))
        (vector-normalize! (vector-! (-> params vel) (get-trans prey 3) muzzle) (chaos-shot-speed this))
        (spawn-projectile shot params this *default-dead-pool*)
        )
      )
    )
  0
  (none)
  )

(defmethod init-enemy! ((this chaos-metalhead))
  "Common city-enemy bring-up: wear the retail skeleton, adopt the retail tuning, then apply the
   few city-specific overrides the retail city metal heads also apply (neck aim envelope, a nav
   speed scale of 1, no water animation, no minimap icon before `citizen-init!` adds one)."
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* (chaos-skel-name this) (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (init-enemy-behaviour-and-stats! this (get-nav-info this))
  ;; `citizen::init-enemy-behaviour-and-stats!` writes `*default-nav-mesh*` into the
  ;; `nav-enemy-info` it is handed -- traffic-spawned actors have no entity to resolve a mesh from,
  ;; so the city forces one. For the retail city Metal Heads that is harmless: each owns its own
  ;; static. Our species share theirs with the arena originals, so the write has to be undone or a
  ;; Pumping Station juicer would afterwards path on the city's dummy mesh. `#f` is the shipped
  ;; value for every `nav-enemy-info` involved, so this restores rather than approximates.
  (set! (-> (get-nav-info this) nav-mesh) #f)
  (let ((neck (-> this neck)))
    (set! (-> neck up) (the-as uint 1))
    (set! (-> neck nose) (the-as uint 2))
    (set! (-> neck ear) (the-as uint 0))
    ;; Same envelope the city grunt uses: +/- 65 degrees of head turn, give up past ~170.
    (set-vector! (-> neck twist-max) 11832.889 11832.889 0.0 1.0)
    (set! (-> neck ignore-angle) 30947.555)
    )
  (let ((nav (-> this nav)))
    (set! (-> nav speed-scale) 1.0)
    )
  (set! (-> this water-anim) -1)
  (set! (-> this minimap) #f)
  (set! (-> this next-melee-time) 0)
  (set! (-> this next-shot-time) 0)
  0
  (none)
  )

(defmethod common-post ((this chaos-metalhead))
  "`citizen-enemy::common-post` with exactly one thing changed: the overlap filter.

   This is the fix for 'the Juice goon and the Krimzon Guard stand chest to chest and neither can
   hurt the other'. Damage between two `enemy`s is touch-driven: `common-post` calls
   `find-overlapping-shapes`, which fills `*touching-list*` and makes both sides receive a `touch`
   event; `enemy-method-75` then turns a touch involving a `deadly` primitive into an `attack`.
   Which shapes are even considered comes from `enemy-info.overlaps-others-collide-with-filter`,
   and the two values differ by exactly the bits that matter here:

     metalhead-grunt / flitter / predator : jak civilian enemy vehicle-sphere hit-by-others-list
                                            player-list
     juicer / spyder (arena enemies)      : jak bot player-list

   `civilian` is what Krimzon Guards and citizens register as and `vehicle-sphere` is what city
   traffic registers as, so with the arena filter a Juice goon in Haven City can only ever touch
   Jak. The two shapes still collide as solids -- hence the shoving -- but no touch entry is ever
   produced, so neither the guard's rifle-butt nor the juicer's own permanently-`deadly` body prim
   can deal damage.

   Patching `enemy-info` itself is not an option: `*juicer-nav-enemy-info*` is a shared static that
   the Atoll juicers read too. Overriding here costs nothing and leaves the retail enemies alone."
  (let ((params (new 'stack-no-clear 'overlaps-others-params)))
    (set! (-> params options) (overlaps-others-options))
    (set! (-> params collide-with-filter)
          (collide-spec jak civilian enemy vehicle-sphere hit-by-others-list player-list)
          )
    (set! (-> params tlist) *touching-list*)
    (find-overlapping-shapes (-> this root) params)
    )
  ;; Unchanged from `citizen-enemy::common-post`: re-pick a focus every 0.2s while idle, and
  ;; keep the traffic danger sphere alive so vehicles swerve around us.
  (when (and (not (focus-test? this disable dead ignore inactive))
             (< (-> this next-update-target) (current-time))
             (not (logtest? (enemy-flag lock-focus) (-> this enemy-flags)))
             (-> this next-state)
             (= (-> this next-state name) 'active)
             )
    (citizen-enemy-method-202 this)
    (set! (-> this next-update-target) (+ (current-time) (seconds 0.2)))
    (traffic-danger-init! this)
    )
  ((method-of-type citizen common-post) this)
  (none)
  )

(defstate hostile (chaos-metalhead)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (let ((parent-enter (-> (method-of-type citizen-enemy hostile) enter)))
      (if parent-enter
          (parent-enter)
          )
      )
    (set! (-> self next-melee-time) 0)
    )
  :trans (behavior ()
    (let ((parent-trans (-> (method-of-type citizen-enemy hostile) trans)))
      (if parent-trans
          (parent-trans)
          )
      )
    ;; Melee cadence -- see MOD_CHAOS_MELEE_PERIOD at the top of the file. The chaos species charge
    ;; and deal contact damage rather than playing a scripted attack (their retail `attack` states
    ;; are written against `juicer` / `spyder` fields that a `citizen-enemy` subclass does not
    ;; have), so the attack id has to be re-stamped here for a hit to land more than once.
    ;; `dangerous` is re-asserted with it because `enemy-method-75` tests it before dealing damage
    ;; and several shared states clear it on exit.
    (when (time-elapsed? (-> self next-melee-time) MOD_CHAOS_MELEE_PERIOD)
      (set-time! (-> self next-melee-time))
      (let* ((info *game-info*)
             (id (+ (-> info attack-id) 1))
             )
        (set! (-> info attack-id) id)
        (set! (-> self attack-id) id)
        )
      (logior! (-> self focus-status) (focus-status dangerous))
      )
    ;; Ranged attack, for the species that have one. Fired from the chase rather than from a
    ;; dedicated firing state: the retail `attack` states are written against `juicer` / `spyder`
    ;; fields that a `citizen-enemy` subclass does not have, so there is no state to enter. The
    ;; practical difference is that these two shoot while closing instead of standing off -- which
    ;; for the Juice goon, a charger in its own level, is the right read anyway.
    (when (chaos-shot-type self)
      (let ((prey (handle->process (-> self focus handle))))
        (when (and prey (time-elapsed? (-> self next-shot-time) MOD_CHAOS_SHOT_PERIOD))
          (let ((dist (vector-vector-distance (-> self root trans)
                                              (-> (the-as process-drawable prey) root trans)
                                              )
                      )
                )
            (when (and (< MOD_CHAOS_SHOT_MIN_DIST dist) (< dist MOD_CHAOS_SHOT_MAX_DIST))
              (set-time! (-> self next-shot-time))
              (chaos-fire! self (the-as process-focusable prey))
              )
            )
          )
        )
      )
    )
  :code (behavior ()
    ;; Loop the chase animation for as long as the trans above keeps us in `hostile`.
    ;; The slight per-instance rate jitter stops a pack of the same species from
    ;; marching in lockstep, exactly like the retail city grunt does.
    (let ((chase (-> self draw art-group data (chaos-chase-anim self)))
          (rate (rnd-float-range self 0.9 1.1))
          )
      (let ((playing (ja-group)))
        (if (not (and playing (= playing chase)))
            (ja-channel-push! 1 (seconds 0.15))
            )
        )
      (until #f
        (ja-no-eval :group! chase :num! (seek! max rate) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max rate))
          )
        )
      )
    #f
    )
  :post nav-enemy-chase-post
  )

;; ------------------------------------------------------------------------------------------------
;; Shared helpers
;; ------------------------------------------------------------------------------------------------

(defun chaos-cityify-collision! ((this nav-enemy))
  "Take a collide-shape built by a retail enemy's `init-enemy-collision!` and make it a citizen of
   Haven City: add `civilian` and `enemy` to the collide-with of the root primitive **and of every
   child primitive**.

   The children are the whole point, and getting that wrong is what made the first two builds ship
   a Juice goon that walked *through* Krimzon Guards, took no damage from them and dealt none.

   A collide-shape's root primitive is a `collide-shape-prim-group` -- a bounding sphere used to
   reject the whole actor cheaply. The primitives that actually collide, and that carry the
   `deadly` action a melee hit is tested against, are its children. `find-overlapping-shapes` pairs
   two primitives only when one's `collide-as` appears in the other's `collide-with`
   (intersected with `overlaps-others-collide-with-filter`), so a child that does not list
   `civilian` can never produce a touching entry against a guard -- and a guard is `civilian`.

   Compare the retail city grunt with the arena juicer, child by child:

     metalhead-grunt children : ... jak civilian hit-by-others-list player-list ...
     juicer children          : ... jak bot player-list ...

   Widening only the group, as the first version did, changes nothing: the group never pairs, so
   neither the guard's rifle butt nor the juicer's own permanently-`deadly` body primitive could
   ever be part of a touching entry, and the solid reaction that keeps two actors apart never fired
   either. All three reported symptoms -- overlapping bodies, immunity to melee, no damage dealt --
   are the same missing bit.

   `backup-collide-as` / `backup-collide-with` must be refreshed afterwards because `citizen-init!`
   restores the root primitive from them every time the traffic engine recycles the process. The
   children are not restored, so the widening above survives recycling on its own."
  (let* ((cshape (-> this root))
         (root-prim (-> cshape root-prim))
         (group (the-as collide-shape-prim-group root-prim))
         )
    (logior! (-> root-prim prim-core collide-with) (collide-spec civilian enemy))
    (dotimes (i (the int (-> group num-children)))
      (logior! (-> group child i prim-core collide-with) (collide-spec civilian enemy))
      )
    ;; Same story one level down, for the `deadly` action rather than the collide spec.
    ;;
    ;;   metalhead-grunt : group deadly, and two limb children deadly
    ;;   spyder          : group deadly, and four children deadly
    ;;   juicer          : group deadly, *no* child deadly -- its body damage is scripted, applied
    ;;                     by `juicer-method-184` toggling a primitive during its attack state
    ;;
    ;; Since only children ever appear in a touching entry, the juicer as shipped would charge into
    ;; a guard and do nothing. Mirror the group's `deadly` down onto the solid body children when
    ;; no child has it, which gives a charging species contact damage the way the city grunt has it.
    ;; This is not a free-for-all: `citizen-enemy::enemy-method-76` only converts a deadly touch
    ;; into damage against a process carrying `process-mask guard` or `civilian`, so Jak is
    ;; unaffected and keeps going through his own handler exactly as with the retail city species.
    (let ((child-deadly #f))
      (dotimes (i (the int (-> group num-children)))
        (if (logtest? (-> group child i prim-core action) (collide-action deadly))
            (set! child-deadly #t)
            )
        )
      (when (and (not child-deadly)
                 (logtest? (-> root-prim prim-core action) (collide-action deadly))
                 )
        (dotimes (i (the int (-> group num-children)))
          (if (logtest? (-> group child i prim-core action) (collide-action solid))
              (logior! (-> group child i prim-core action) (collide-action deadly))
              )
          )
        )
      )
    (set! (-> cshape backup-collide-as) (-> root-prim prim-core collide-as))
    (set! (-> cshape backup-collide-with) (-> root-prim prim-core collide-with))
    ;; City metal heads run at event-priority 8 so a guard's shot beats an ambient bump.
    (set! (-> cshape event-priority) (the-as uint 8))
    )
  0
  (none)
  )

(defun chaos-art-ready? ((skel-name string))
  "#t when the skeleton group is resident, i.e. its `-ag.go` made it into a loaded DGO.
   Checked before spawning so a missing art group degrades into 'this species does not appear'
   instead of a `process-drawable-art-error` crash.

   Written as an `if` rather than `(and ... #t)` on purpose: `and` types as the union of its
   operands, i.e. `object`, which will not go into a `symbol` global."
  (if (art-group-get-by-name *level* skel-name (the-as (pointer uint32) #f))
      #t
      #f
      )
  )

;; ------------------------------------------------------------------------------------------------
;; chaos-juicer -- "Juice goon"  (10%)
;; ------------------------------------------------------------------------------------------------

(deftype chaos-juicer (chaos-metalhead)
  ()
  )

(defmethod chaos-skel-name ((this chaos-juicer))
  "Skeleton group worn by the Juice goon. A method body that is nothing but a string would be read
   as a docstring, hence this one."
  "skel-juicer"
  )

(defmethod get-nav-info ((this chaos-juicer))
  "Reuse the Atoll juicer's tuning verbatim: 9 hit points, its charge speeds and its full
   animation table. Read-only -- never mutate it, the retail Atoll juicers share this object."
  *juicer-nav-enemy-info*
  )

(defmethod chaos-shot-type ((this chaos-juicer))
  "The Atoll juicer's own shot. Its collide-with already covers `civilian` and `enemy`, so it
   damages Krimzon Guards unmodified."
  juicer-shot
  )

(defmethod chaos-shot-speed ((this chaos-juicer))
  "Retail spells this `(* 24576.0 (-> pp clock frames-per-second))`; 60 is what that clock reads."
  1474560.0
  )

(defmethod init-enemy-collision! ((this chaos-juicer))
  ;; Borrow the retail primitive layout (it is keyed to juicer joint indices, so hand-writing
  ;; it would only introduce drift), then widen the root prim for city faction combat. The
  ;; juicer's root primitive is permanently `deadly`, which is what makes its charge hurt.
  ((method-of-type juicer init-enemy-collision!) (the-as juicer this))
  (chaos-cityify-collision! this)
  0
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; chaos-spyder -- "Spyder gunner"  (5%)
;; ------------------------------------------------------------------------------------------------

(deftype chaos-spyder (chaos-metalhead)
  ()
  )

(defmethod chaos-skel-name ((this chaos-spyder))
  "Skeleton group worn by the Spyder gunner. A method body that is nothing but a string would be read
   as a docstring, hence this one."
  "skel-spyder"
  )

(defmethod get-nav-info ((this chaos-spyder))
  *spyder-nav-enemy-info*
  )

(defmethod chaos-shot-type ((this chaos-spyder))
  "`spyder-shot` is a `metalhead-shot`, whose collide-with already covers `civilian` and `enemy`."
  spyder-shot
  )

(defmethod chaos-shot-speed ((this chaos-spyder))
  "The speed `spyder-method-183` is called with from the retail attack state."
  307200.0
  )

(defmethod init-enemy-collision! ((this chaos-spyder))
  ;; Like the juicer, the spyder's root primitive carries `deadly` in retail, so the city version
  ;; fights by contact without needing the gun turret its arena counterpart uses.
  ((method-of-type spyder init-enemy-collision!) (the-as spyder this))
  (chaos-cityify-collision! this)
  0
  (none)
  )
