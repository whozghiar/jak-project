;;-*-Lisp-*-
(in-package goal)

;; name: crimson-blue-guard.gc
;; name in dgo: crimson-blue-guard
;; dgos: CWI
;;
;; Blue-recolored Crimson Guard (custom mod entity, not part of the original game).
;; Branch: jak2/features/crimson-blueguard/crimson-redguard-behavior
;;
;; ================================================================================================
;; DESIGN INTENT -- READ THIS BEFORE ADDING ANYTHING TO THIS FILE
;; ================================================================================================
;; `crimson-blue-guard` is a plain subtype of `crimson-guard` that is meant to behave EXACTLY like
;; the stock red guard: same states, same alert reaction after a crime, same arrest/pursuit logic,
;; same stats, same animations, same sounds, same death. Only three things differ, and each one is
;; either cosmetic or a hard technical requirement of a `build-actor` custom actor:
;;
;;   1. `init-enemy!`            -- binds `skel-crimson-blue-guard` instead of `skel-crimson-guard`
;;                                  (the whole point of the mod: the blue mesh).
;;   2. `die` + `enemy-method-78` -- replicate the native purple dissolution by hand, because the
;;                                  stock death path would drive Generic Merc over this actor's
;;                                  build-actor geometry and crash (see DEATH below).
;;   3. `crimson-guard-method-214` + the grenade fields -- optional grenade launcher (see WEAPONS).
;;
;; Everything else is inherited. Do NOT override states, event handlers or targeting methods here:
;; any such override is, by definition, a behaviour difference from the red guard.
;;
;; ------------------------------------------------------------------------------------------------
;; ASSETS & SKELETON
;; ------------------------------------------------------------------------------------------------
;; Built via `build-actor` (see game.gp) from:
;;   custom_assets/jak2/models/custom_levels/crimson-blue-guard.glb  (actor art-group)
;;   custom_assets/jak2/models/common/crimson-blue-guard-lod0.glb    (PC FR3 renderer)
;; Both share the pristine 38-bone crimson-guard skeleton with the native joint indices:
;;   joint 14 "blast"    -- gun barrel tip      (projectile spawn point)
;;   joint 15 "dirblast" -- barrel forward axis (projectile direction)
;; so gunshots and taser lightning fire from the muzzle exactly like the red guard.
;;
;; The art-group is built with `:native-header #t`, which pads header slots 2 & 3 so animation
;; slots 4..43 line up 1:1 with `crimson-guard-ag`. That alignment is what lets every inherited
;; state keep using the stock numeric animation indices (`anim-shoot`, `die-anim`, `riding-anim`,
;; ...) unchanged. Do not rebuild without `:native-header #t`.
;;
;; ------------------------------------------------------------------------------------------------
;; DEATH (the one unavoidable deviation)
;; ------------------------------------------------------------------------------------------------
;; A custom actor built by `build-actor` carries dummy merc-ctrl geometry. Letting the stock death
;; path set `death-timer` hands the actor to the Generic Merc C++ routines, which read
;; uninitialized fragment memory and crash. The `die` state below therefore reproduces the native
;; look by hand (same approach as the yakow_killable mod):
;;   1. play "enemy-fizz";
;;   2. emit the authentic purple death particles (preset 73) across all 38 bones for ~1 second
;;      via merc-death-spawn;
;;   3. hide the mesh after 5 frames so the body dissolves into purple mist;
;;   4. `knocked-fatal?` (set from `enemy-method-78`) keeps a knockdown death lying on the ground
;;      instead of re-playing the standing collapse, matching the native crimson-guard.
;;
;; ------------------------------------------------------------------------------------------------
;; WEAPONS
;; ------------------------------------------------------------------------------------------------
;; `guard-type` is left entirely to the traffic engine, exactly as for a red guard (0 = taser,
;; 1 = rifle). On top of that, a rifle guard has a 1-in-3 chance of carrying a grenade launcher:
;; `grenade-launcher?`. That flag changes ONLY what `crimson-guard-method-214` spawns -- a
;; `vehicle-grenade` on a ballistic arc instead of a straight `guard-shot`. Every range, state
;; transition, animation and cooldown stays that of a stock rifle guard, so a grenade guard is a
;; red rifle guard with a different projectile. Because the stock `gun-shoot` burst is hardcoded to
;; four shots, grenades are additionally rate-limited (`grenade-last-time`) so one burst lobs one
;; grenade rather than four.
;; ================================================================================================

(declare-type vehicle-grenade projectile-bounce)

(define-extern merc-death-spawn (function int vector vector none))
(define-extern citizen-spawn (function process type traffic-object-spawn-params process-drawable))

(deftype crimson-blue-guard (crimson-guard)
  ((knocked-fatal?     symbol)      ;; #t when the killing blow was a knockdown -- see DEATH above
   (grenade-launcher?  symbol)      ;; #t when this guard's rifle slot carries the grenade launcher
   (grenade-last-time  time-frame)  ;; frame the last grenade left the muzzle (burst rate limit)
   )
  )

(def-art-elt crimson-blue-guard-ag crimson-blue-guard-lod0-jg 0)
(def-art-elt crimson-blue-guard-ag crimson-blue-guard-lod0-mg 1)

;; Pedestrian skeleton-group. Mirrors skel-crimson-guard; the custom art-group only ships lod0, so
;; there is a single mesh entry instead of the native lod0/lod2 pair. `-1` for the default
;; animation: every inherited state selects its animation explicitly by numeric slot.
(defskelgroup skel-crimson-blue-guard crimson-blue-guard crimson-blue-guard-lod0-jg -1
              ((crimson-blue-guard-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              :origin-joint-index 3
              )

;; Vehicle-rider skeleton-group. Mirrors skel-crimson-guard-rider (bounds and LOD layout included)
;; so `crimson-guard-rider` can bind it instead of the red one while the mod is enabled -- see
;; vehicle-rider-method-32 in levels/city/traffic/vehicle/vehicle-rider.gc. The rider overwrites
;; the LOD distances itself right after initialize-skeleton, so only the mesh entry matters here.
(defskelgroup skel-crimson-blue-guard-rider crimson-blue-guard crimson-blue-guard-lod0-jg -1
              ((crimson-blue-guard-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 3)
              )

(defmethod init-enemy! ((this crimson-blue-guard))
  "Identical to crimson-guard's init-enemy!, except it binds skel-crimson-blue-guard and clears
   this type's three extra fields. Every stat, animation index and nav setting is the red guard's."
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-crimson-blue-guard" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (set! (-> this joint) (new 'process 'joint-mod (joint-mod-mode joint-set*-world) this 4))
  (set! (-> this info) *crimson-guard-global-info*)
  (init-enemy-behaviour-and-stats! this *crimson-guard-nav-enemy-info*)
  (let ((v1-7 (-> this nav)))
    (set! (-> v1-7 speed-scale) 1.0)
    )
  0
  (set! (-> this draw lod-set lod 0 dist) 143360.0)
  (set! (-> this draw lod-set lod 1 dist) 491520.0)
  (set! (-> this anim-shuffle) 5)
  (set! (-> this anim-walk) 5)
  (set! (-> this speed-walk) 12288.0)
  (set! (-> this dist-walk-anim) 12288.0)
  (set! (-> this dist-run-anim) 34078.72)
  (set! (-> this anim-run) 6)
  (set! (-> this speed-run) 49152.0)
  (set! (-> this anim-get-up-front) 33)
  (set! (-> this anim-get-up-back) 34)
  (set! (-> this l-control) (new 'process 'lightning-control (-> *lightning-spec-id-table* 13) this 0.0))
  (set! (-> this l-control state points-to-draw) 0)
  (set! (-> this water-anim) -1)
  (set! (-> this minimap) #f)
  ;; mod-specific fields (hit-points and every other stat come from *crimson-guard-nav-enemy-info*)
  (set! (-> this knocked-fatal?) #f)
  (set! (-> this grenade-launcher?) #f)
  (set! (-> this grenade-last-time) 0)
  0
  (none)
  )

(defmethod citizen-init! ((this crimson-blue-guard))
  "Stock crimson-guard initialization -- guard-type, collide-spec, hit-points, alert reaction and
   minimap icon are all left to the parent, so a fresh blue guard is indistinguishable from a red
   one -- then roll this guard's grenade launcher (1 in 3). See WEAPONS in the file header."
  ((method-of-type crimson-guard citizen-init!) this)
  (set! (-> this knocked-fatal?) #f)
  (set! (-> this grenade-launcher?) (zero? (rand-vu-int-count 3)))
  (set! (-> this grenade-last-time) 0)
  (none)
  )

(defmethod crimson-guard-method-214 ((this crimson-blue-guard))
  "Fire one shot. Stock straight `guard-shot` bolt unless this guard carries the grenade launcher,
   in which case it lobs a `vehicle-grenade` on a ballistic arc toward the predicted target
   position. Grenades are rate-limited: the stock `gun-shoot` burst is hardcoded to four shots, so
   without a cooldown one engagement would throw four grenades. Shots suppressed by the cooldown
   fire nothing at all -- the shoot animation still plays, which reads as the launcher reloading."
  (cond
    ((and (-> this grenade-launcher?) (time-elapsed? (-> this grenade-last-time) (seconds 2)))
     (set-time! (-> this grenade-last-time))
     (let* ((target-pos (-> this target-pos-predict-miss))
            ;; joint 14 = "blast", the gun barrel tip (see ASSETS in the file header)
            (muzzle (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 14)))
            (traj (new 'stack-no-clear 'traj3d-params))
            (a1-1 (new 'stack-no-clear 'projectile-init-by-other-params))
            )
       (set! (-> traj src quad) (-> muzzle quad))
       (set! (-> traj dest quad) (-> target-pos quad))
       (set! (-> traj initial-tilt) 8192.0)
       (set! (-> traj gravity) 184320.0)
       (set! (-> a1-1 ent) (-> this entity))
       (set! (-> a1-1 charge) 1.0)
       (set! (-> a1-1 options) (projectile-options))
       (set! (-> a1-1 notify-handle) (process->handle this))
       (set! (-> a1-1 owner-handle) (the-as handle #f))
       (set! (-> a1-1 ignore-handle) (process->handle this))
       (let* ((gi *game-info*)
              (atk-id (+ (-> gi attack-id) 1))
              )
         (set! (-> gi attack-id) atk-id)
         (set! (-> a1-1 attack-id) atk-id)
         )
       (set! (-> a1-1 timeout) (seconds 4))
       (set! (-> a1-1 pos quad) (-> muzzle quad))
       (cond
         ((traj3d-calc-initial-velocity-using-tilt traj)
          (set! (-> a1-1 vel quad) (-> traj initial-velocity quad))
          )
         (else
           ;; no solution for the requested tilt (target too far / straight overhead): fall back to
           ;; a plain lobbed throw along the line of fire so the guard still shoots something.
           (let ((dir (vector-! (new 'stack-no-clear 'vector) target-pos muzzle)))
             (vector-normalize! dir 102400.0)
             (+! (-> dir y) 40960.0)
             (set! (-> a1-1 vel quad) (-> dir quad))
             )
           )
         )
       (spawn-projectile vehicle-grenade a1-1 this *default-dead-pool*)
       )
     )
    ((-> this grenade-launcher?)
     ;; launcher on cooldown -- the animation plays, no projectile leaves the muzzle.
     0
     )
    (else
      ((method-of-type crimson-guard crimson-guard-method-214) this)
      )
    )
  0
  (none)
  )

(defbehavior crimson-blue-guard-dissolve-sequence crimson-blue-guard ()
  "Play the fizz sound and emit purple death particles (*part-id-table* preset 73) across the
   skeleton for ~1 second while the body mesh dissolves. See DEATH in the file header for why the
   native death path cannot be used on a build-actor actor."
  (sound-play "enemy-fizz")
  (let ((node-cnt (-> self node-list length))
        (pos (new 'stack-no-clear 'vector))
        (zero-vec (new 'static 'vector))
        )
    (dotimes (frame 60)
      ;; after 5 frames (~0.08s) hide the body: by then the mist has taken over
      (when (= frame 5)
        (logior! (-> self draw status) (draw-control-status no-draw))
        )
      ;; 8 purple death sparks per frame, spread over random joints with a little jitter
      (dotimes (j 8)
        (let ((joint-idx (rand-vu-int-count node-cnt)))
          (vector<-cspace! pos (-> self node-list data joint-idx))
          (+! (-> pos x) (rnd-float-range self -819.2 819.2))
          (+! (-> pos y) (rnd-float-range self -819.2 819.2))
          (+! (-> pos z) (rnd-float-range self -819.2 819.2))
          (merc-death-spawn 73 pos zero-vec)
          )
        )
      (suspend)
      )
    )
  ;; mandatory teardown, same as every native enemy death: tell listeners the death animation is
  ;; over, let any child process (pickups, particles) finish, then release the process.
  (send-event self 'death-end)
  (while (-> self child)
    (suspend)
    )
  (cleanup-for-death self)
  (none)
  )

(defstate die (crimson-blue-guard)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (dying self)
    (let ((v1-3 (-> self root root-prim)))
      (set! (-> v1-3 prim-core collide-as) (collide-spec))
      (set! (-> v1-3 prim-core collide-with) (collide-spec))
      )
    0
    (set-time! (-> self state-time))
    (set! (-> self hit-points) 0)
    (enemy-method-103 self)
    )
  :code (behavior ()
    ;; Standing death: play the stock collapse animation first. Knockdown death: knocked-fatal? is
    ;; #t, so the guard stays lying where it fell, exactly like the native crimson-guard.
    (when (not (-> self knocked-fatal?))
      (ja-channel-push! 1 (seconds 0.075))
      (let ((f30-0 (rnd-float-range self 0.8 1.2)))
        (ja-no-eval :group! (-> self draw art-group data (-> self enemy-info die-anim))
                    :num! (seek! max f30-0)
                    :frame-num 0.0
                    )
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max f30-0))
          )
        )
      )
    (crimson-blue-guard-dissolve-sequence)
    )
  :post enemy-simple-post
  )

(defmethod enemy-method-78 ((this crimson-blue-guard) (arg0 enemy-knocked-info))
  "Record a fatal knockdown so the `die` state above leaves the body on the ground instead of
   re-playing the standing collapse, then run the stock knocked-land handling."
  (when (<= (-> this hit-points) 0)
    (set! (-> this knocked-fatal?) #t)
    )
  ((method-of-type crimson-guard enemy-method-78) this arg0)
  )

;; ================================================================================================
;; Traffic-pool helpers -- used by `spawn-crimson-blue-guard-debug` (traffic-manager.gc) to recycle
;; an inactive blue guard from the ambient pool instead of allocating a brand new process.
;; ================================================================================================

(defun get-inactive-crimson-blue-guard-handle ((engine traffic-engine) (params traffic-object-spawn-params))
  "Find an inactive crimson-blue-guard in the ambient guard pools (crimson-guard-1 first, then
   crimson-guard-0) and point `params object-type` at the pool it came from. #f if none is free."
  (when engine
    (let ((type-info (-> engine object-type-info-array (traffic-type crimson-guard-1))))
      (dotimes (i (-> type-info inactive-count))
        (let* ((h (-> type-info array i))
               (p (handle->process h))
               )
          (when (and p (type? p crimson-blue-guard))
            (set! (-> params object-type) (traffic-type crimson-guard-1))
            (return h)
            )
          )
        )
      )
    (let ((type-info-0 (-> engine object-type-info-array (traffic-type crimson-guard-0))))
      (dotimes (i (-> type-info-0 inactive-count))
        (let* ((h (-> type-info-0 array i))
               (p (handle->process h))
               )
          (when (and p (type? p crimson-blue-guard))
            (set! (-> params object-type) (traffic-type crimson-guard-0))
            (return h)
            )
          )
        )
      )
    )
  (the-as handle #f)
  )

(defun activate-inactive-crimson-blue-guard ((engine traffic-engine) (params traffic-object-spawn-params))
  "Pull an inactive crimson-blue-guard out of the traffic pool and activate it at `params`."
  (let ((h (get-inactive-crimson-blue-guard-handle engine params)))
    (when (handle->process h)
      (set! (-> params handle) h)
      (activate-by-handle engine params)
      (let ((proc (the-as crimson-blue-guard (-> params proc))))
        (when proc
          (logclear! (-> proc focus-status) (focus-status inactive))
          )
        proc
        )
      )
    )
  )
