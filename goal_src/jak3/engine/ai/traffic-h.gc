  (h-bike-a 0)
  (h-bike-b 1)
  (h-bike-c 2)
  (h-car-a  3)
  (h-car-b  4)
  (h-car-c  5)
  (h-bike-d 6)
  (h-hellcat 7)
  (h-warf 8)
  (h-glider 9)
  (h-sled 10)
  (h-kg-pickup 11)
  (v-turtle 12)
  (v-snake 13)
  (v-scorpion 14)
  (v-toad 15)
  (v-fox 16)
  (v-rhino 17)
  (v-mirage 18)
  (v-x-ride 19)
  (v-marauder 20)
  (v-faccar 21)
  (v-catapult 22)
  (v-marauder-b 23)
