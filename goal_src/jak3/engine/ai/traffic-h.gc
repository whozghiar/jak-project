  (tsf0 0)
  (tsf1 1)
  (tsf2 2)
  (tsf3 3)
  (tsf4 4)
  (tsf5 5)
  (tsf6 6)
  (tsf7 7)
  (tsf8 8)
  (tsf9 9)
  (tsf10 10)
  (tsf11 11)
  (tsf12 12)
  (tsf13 13)
  (tsf14 14)
  (tsf15 15)
  (tsf16 16)
  )
;; ---traffic-spawn-flags

;; +++traffic-type
(defenum traffic-type
  :type uint8
  (civilian-male 0)
  (civilian-female 1)
  (civilian-fat 2)
  (civilian-pilot 3)
  (guard-pilot 4)
  (citizen-task 5)
  (guard-a 6)
  (guard-b 7)
  (metalhead-grunt 8)
  (metalhead-flitter 9)
  (metalhead-predator 10)
  (wlander-male 11)
  (wlander-female 12)
  (formation 13)
  (roboguard 14)
  (spydroid 15)
  (flying-turret 16)
  (civilian-bike-a 17)
  (civilian-bike-b 18)
  (civilian-bike-c 19)
  (civilian-car-a 20)
  (civilian-car-b 21)
  (civilian-car-c 22)
  (vehicle-task 23)
  (guard-bike 24)
  (guard-car 25)
  (guard-transport 26)
  (kg-pickup 27)
  (bike-d 28)
  (max 29)
