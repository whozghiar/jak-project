;;-*-Lisp-*-
(in-package goal)

;; name: haven-city-chaos-menu.gc
;; name in dgo: haven-city-chaos-menu
;; dgos: GAME
;;
;; MOD "Haven City : Chaos" -- Debug > Mods > haven-city-chaos
;; ================================================================================================
;; Registers the mod's submenu with the shared `mods-menu.gc` registry. Per the house rules this
;; file never touches `default-menu.gc` / `default-menu-pc.gc` / `mods-menu.gc`, and every symbol
;; it defines is prefixed with the mod slug so two branches can never collide.
;;
;;   Debug > Mods > haven-city-chaos
;;     Enable                            -- the master switch; everything else is inert without it
;;     species > Grunt (30%)             -- on by default  (retail invasion species, no extra art)
;;             > Stinger (30%)           -- on by default
;;             > Cloaker (10%)           -- on by default
;;             > Rapid gunner (10%)      -- off by default (streams gunner art into LWIDEB)
;;             > Spyder gunner (5%)      -- off by default (streams spyder art into LWIDEB)
;;     guards  > Tougher guards          -- 1.5x hit points + vehicles engaging metal heads
;;             > Guards ignore Jak       -- the truce
;;
;; The percentages are relative shares, not caps: whatever is switched on splits the whole
;; metal-head population budget between itself in these proportions (see MOD_CHAOS_METALHEAD_POP
;; in pc/mods/haven-city-chaos-h.gc). Switching Rapid gunner and Spyder gunner off therefore makes
;; the other three *more* numerous, not the invasion smaller.
;;
;; All the state itself lives in `pc/mods/haven-city-chaos-h.gc`; this file only drives it, so the
;; mod is equally controllable from the REPL (`(mod-chaos-set-enable! #t)`) with the menu closed.
;; ================================================================================================

(declare-file (debug))

;; ------------------------------------------------------------------------------------------------
;; Pick functions
;;
;; House rule: side effects happen on `press` only. The menu re-sends `update` every few frames
;; purely to refresh the checkmark, so anything that allocates or re-shapes the level must not run
;; there. Every pick function ends by returning the current boolean.
;; ------------------------------------------------------------------------------------------------

(defun mod-haven-city-chaos-enable-pick ((arg0 symbol) (arg1 debug-menu-msg))
  "Master toggle. `mod-chaos-set-enable!` flips the city onto (or off) the `lwideb` borrow, which
   is what streams the metal-head art in, turns the invasion traffic types on and drops Jak from
   the guards' target list. The level stream takes a moment -- expect a second or two before the
   first metal head walks around a corner.

   One thing does *not* apply live: the nav-mesh concurrent-user ceiling is read once when Haven
   City's nav mesh is initialised, so the densest spawn rates only arrive on the next city load.
   Step indoors and back out after enabling."
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-chaos-set-enable! (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-species-changed! ((ttype traffic-type) (now-on symbol))
  "Shared tail of every species toggle.

   Turning a species *off* also recycles the ones already walking around: once its want-count
   drops to 0 the mod clears `trtflags-1` on the type, and `kill-excess-once` -- the traffic
   manager's own reclaimer -- only looks at types that still carry that flag, so nothing would
   ever collect them.

   Either way the city half is asked to re-derive its traffic table on its next frame. Flagging
   rather than calling keeps this GAME.CGO file free of any reference to CWI.DGO code, so the menu
   still works in a level where Haven City is not loaded."
  (when (and (not now-on) *traffic-manager*)
    (send-event *traffic-manager* 'deactivate-by-type ttype)
    )
  (set! *mod-chaos-species-dirty* #t)
  0
  (none)
  )

(defun mod-haven-city-chaos-grunt-pick ((arg0 symbol) (arg1 debug-menu-msg))
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-haven-city-chaos-species-changed! (traffic-type metalhead-grunt) (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-flitter-pick ((arg0 symbol) (arg1 debug-menu-msg))
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-haven-city-chaos-species-changed! (traffic-type metalhead-flitter) (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-predator-pick ((arg0 symbol) (arg1 debug-menu-msg))
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-haven-city-chaos-species-changed! (traffic-type metalhead-predator) (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-rapid-pick ((arg0 symbol) (arg1 debug-menu-msg))
  "Rapid gunner on/off. Unlike the three retail species this one needs `skel-rapid-gunner` resident, which
   only happens once `lwideb` has streamed in -- so with the mod freshly enabled the first few
   seconds may show nothing. The city half re-probes art residency whenever this flag changes and
   silently leaves the species out if the skeleton is missing, rather than crashing on spawn."
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-haven-city-chaos-species-changed! (traffic-type chaos-rapid-gunner) (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-spyder-pick ((arg0 symbol) (arg1 debug-menu-msg))
  "Spyder gunner on/off. Same art-residency caveat as the Rapid gunner."
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (mod-haven-city-chaos-species-changed! (traffic-type chaos-spyder) (the-as symbol (-> arg0 value)))
     )
    )
  (-> arg0 value)
  )

(defun mod-haven-city-chaos-guard-buffs-pick ((arg0 symbol) (arg1 debug-menu-msg))
  "Guard buffs on/off: the 1.5x hit points and the vehicle-vs-metal-head engagement, together.
   The hit-point scale only applies to guards spawned *after* the toggle -- `citizen-init!` reads
   it once per spawn -- so existing guards keep the health they were born with until the traffic
   engine recycles them."
  (case arg1
    (((debug-menu-msg press))
     (set! (-> arg0 value) (not (-> arg0 value)))
     (set! *mod-chaos-guard-hp-scale*
           (if (and *mod-chaos-enable* (-> arg0 value))
               MOD_CHAOS_GUARD_HP_SCALE
               1.0
               )
           )
     )
    )
  (-> arg0 value)
  )

;; ------------------------------------------------------------------------------------------------
;; Builder
;;
;; Called on every rebuild of the Mods tab, so it must be pure: build a node and return it.
;; ------------------------------------------------------------------------------------------------

(defun mod-haven-city-chaos-build-menu ((ctx debug-menu-context))
  (debug-menu-make-from-template ctx
    '(menu "haven-city-chaos"
       (flag "Enable" *mod-chaos-enable* mod-haven-city-chaos-enable-pick)
       (menu "species"
         (flag "Grunt (30%)" *mod-chaos-species-grunt* mod-haven-city-chaos-grunt-pick)
         (flag "Stinger (30%)" *mod-chaos-species-flitter* mod-haven-city-chaos-flitter-pick)
         (flag "Cloaker (10%)" *mod-chaos-species-predator* mod-haven-city-chaos-predator-pick)
         (flag "Rapid gunner (10%)" *mod-chaos-species-rapid* mod-haven-city-chaos-rapid-pick)
         (flag "Spyder gunner (5%)" *mod-chaos-species-spyder* mod-haven-city-chaos-spyder-pick)
         )
       (menu "guards"
         (flag "Tougher guards" *mod-chaos-guard-buffs* mod-haven-city-chaos-guard-buffs-pick)
         (flag "Guards ignore Jak" *mod-chaos-guards-ignore-jak* dm-boolean-toggle-pick-func)
         )
       )
    )
  )

(mods-menu-register "haven-city-chaos" mod-haven-city-chaos-build-menu)
