;;-*-Lisp-*-
(in-package goal)

;; name: mod-city-hooks.gc
;; name in dgo: mod-city-hooks
;; dgos: CWI

;; ================================================================================================
;; Blue Crimson Guard mod -- "city mode" wiring manifest (CITY PEACEFUL variant).
;;
;; The shared traffic / guard engine files call the *mod-city-*-hook* function pointers declared
;; in engine/ai/traffic-h.gc. THIS file is the only place a branch legitimately differs: it
;; defines the two mode flags and points each hook var at a no-op / stock default OR, when City
;; Peaceful is toggled on, at a mod-city-peaceful.gc function.
;; ================================================================================================

;; Both flags exist on every branch so the debug-menu pick-funcs can always clear the other one.
(define *mod-city-peaceful?* #f)
(define *mod-city-insurrection?* #f)

;; hook implementations pulled from mod-city-peaceful.gc (registered before this file in game.gp)
(define-extern mod-pea-guard-activate (function traffic-tracker traffic-type handle))
(define-extern mod-pea-blue-activated? (function crimson-blue-guard traffic-object-spawn-params symbol))

;; --- no-op / stock defaults ---------------------------------------------------------------------

(defun mod-city-hook-traffic-update ((this traffic-manager))
  "default *mod-city-traffic-update-hook*: nothing to shape."
  this
  (none)
  )

(defun mod-city-hook-guard-spawn-blue? ((params traffic-object-spawn-params))
  "*mod-city-guard-spawn-blue-hook* (City Peaceful branch): id-parity blue/red mix
   in the ambient guard pool -- but ONLY while the mod is enabled from Debug > Mods.
   With *mod-city-peaceful?* #f this returns #f for every spawn, so the traffic
   engine builds a stock red `crimson-guard` every time (native non-regression)."
  (and *mod-city-peaceful?* (logtest? (-> params id) 1))
  )

(defun mod-city-hook-alert-blocked? ()
  "default *mod-city-alert-blocked-hook*: alerts rise normally everywhere."
  #f
  )

(defun mod-city-hook-guard-active-trans ((this crimson-guard))
  "default *mod-city-guard-active-trans-hook*: no per-frame active-state scan."
  this
  (none)
  )

(defun mod-city-hook-guard-search-trans ((this crimson-guard))
  "default *mod-city-guard-search-trans-hook*: no per-frame search-state scan."
  this
  #f
  )

(defun mod-city-hook-keep-guard-target? ((p process-focusable))
  "default *mod-city-keep-guard-target-hook*: no special guard-vs-guard target retention."
  p
  #f
  )

(defun mod-city-hook-guard-rider-type ()
  "default *mod-city-guard-rider-type-hook*: stock crimson-guard-rider."
  crimson-guard-rider
  )

(defun mod-city-hook-guard-vehicle-icon ()
  "default *mod-city-guard-vehicle-icon-hook*: stock red `guard` minimap dot."
  (the-as uint (minimap-class guard))
  )

(defun mod-city-hook-citizen-alert-blocked? ((this citizen))
  "default *mod-city-citizen-alert-blocked-hook*: citizen deaths and attacks raise alerts normally."
  this
  #f
  )

(defun mod-city-hook-vehicle-alert-blocked? ((this process-focusable))
  "default *mod-city-vehicle-alert-blocked-hook*: attacking a guard vehicle raises the city alert."
  this
  #f
  )

;; --- City Peaceful dispatch (flag-guarded so a toggle-off is exactly the stock behaviour) ------

(defun mod-city-pea-guard-activate ((this traffic-tracker) (ttype traffic-type))
  "*mod-city-guard-activate-hook*: pull a BLUE process out of the id-parity guard pool while City
   Peaceful is on so ambient guards patrol as blue squads; stock plain pull otherwise."
  (if *mod-city-peaceful?*
      (mod-pea-guard-activate this ttype)
      (get-from-inactive-by-type this ttype)
      )
  )

(defun mod-city-pea-blue-activated? ((this crimson-blue-guard) (params traffic-object-spawn-params))
  "*mod-city-blue-activated-hook*: a fresh ambient leader forms a patrol squad while City Peaceful
   is on. Returns #f so the stock lone-guard activation still runs."
  (if *mod-city-peaceful?*
      (mod-pea-blue-activated? this params)
      #f
      )
  )

(defun mod-city-pea-guard-rider-type ()
  "*mod-city-guard-rider-type-hook*: blue guard vehicle rider when City Peaceful is active; stock red otherwise."
  (if *mod-city-peaceful?*
      crimson-blue-guard-rider
      crimson-guard-rider
      )
  )

(defun mod-city-pea-guard-vehicle-icon ()
  "*mod-city-guard-vehicle-icon-hook*: blue minimap dot for guard vehicles while City Peaceful is
   active -- the exact counterpart of mod-city-pea-guard-rider-type above, so a hellcat / guard-bike
   flown by a `crimson-blue-guard-rider` reads blue instead of red. Stock red dot otherwise."
  (if *mod-city-peaceful?*
      (the-as uint (minimap-class blue-guard))
      (the-as uint (minimap-class guard))
      )
  )

(defun mod-city-pea-vehicle-alert-blocked? ((this process-focusable))
  "*mod-city-vehicle-alert-blocked-hook*: while City Peaceful is active, shooting or ramming a
   guard vehicle no longer puts the whole city on alert. The attacked vehicle alone reacts: its
   vehicle-method-134 still records Jak as pursuit-target and raises its own `alert` flag, which is
   what drives active:post -> vehicle-guard-method-150 -> vehicle-method-108 (in-pursuit) ->
   hostile -> stop-and-shoot. Nothing is broadcast, so every other guard keeps patrolling."
  this
  *mod-city-peaceful?*
  )

(defun mod-city-pea-citizen-alert-blocked? ((this citizen))
  "*mod-city-citizen-alert-blocked-hook*: when City Peaceful is active, citizens (civilians)
   do not trigger city alerts when killed or attacked. Guards still trigger alerts normally."
  (and *mod-city-peaceful?* (not (type? this crimson-guard)))
  )

;; --- install -----------------------------------------------------------------------------------

(define *mod-city-traffic-update-hook* mod-city-hook-traffic-update)
(define *mod-city-guard-spawn-blue-hook* (the-as (function object symbol) mod-city-hook-guard-spawn-blue?))
(define *mod-city-guard-activate-hook* (the-as (function object traffic-type handle) mod-city-pea-guard-activate))
(define *mod-city-alert-blocked-hook* mod-city-hook-alert-blocked?)
(define *mod-city-blue-activated-hook* (the-as (function crimson-blue-guard object symbol) mod-city-pea-blue-activated?))
(define *mod-city-guard-active-trans-hook* mod-city-hook-guard-active-trans)
(define *mod-city-guard-search-trans-hook* mod-city-hook-guard-search-trans)
(define *mod-city-keep-guard-target-hook* mod-city-hook-keep-guard-target?)
(define *mod-city-guard-rider-type-hook* mod-city-pea-guard-rider-type)
(define *mod-city-guard-vehicle-icon-hook* mod-city-pea-guard-vehicle-icon)
(define *mod-city-citizen-alert-blocked-hook* mod-city-pea-citizen-alert-blocked?)
(define *mod-city-vehicle-alert-blocked-hook* (the-as (function process-focusable symbol) mod-city-pea-vehicle-alert-blocked?))
