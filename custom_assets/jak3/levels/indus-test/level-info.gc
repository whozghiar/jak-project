;; add this to goal_src/jak3/engine/level/level-info.gc

(define indus-test
  (new 'static 'level-load-info
    :name 'indus-test
    :visname 'indus-test-vis
    :nickname 'ixt
    :dbname 'indus-test
    :taskname 'default
    :index #x128 ;; the test-zone's: give it a number no other level has
    :master-level #f
    :packages '()
    :run-packages '("common")
    :memory-mode (level-memory-mode large)
    :music-bank #f
    :extra-sound-bank #f
    :mood-func 'update-mood-default
    :special-mood #f
    :ocean #f
    :ocean-alpha 1.0
    :priority 100
    :draw-priority 10.0
    :base-task-mask (task-mask task0)
    :bigmap-id (bigmap-id none)
    :continues '((new 'static 'continue-point
        :name "indus-test-start"
        :level 'indus-test
        :trans (static-vectorm 0.0 9.5 -70.0)
        :camera-trans (static-vectorm 0.0 12.5 -76.0)
        :quat (new 'static 'vector4h :data (new 'static 'array int16 4 0 0 0 #x7fff))
        :camera-rot (new 'static 'array int16 9 #x7fff 0 0 0 #x7fff 0 0 0 #x7fff)
        :on-goto #f
        :vis-nick 'ixt
        :vehicle-type #x1b
        :want-count 1
        :want (new 'static 'inline-array level-buffer-state-small 1
          (new 'static 'level-buffer-state-small :name 'indus-test :display? 'display)
          )
        :want-sound (new 'static 'array symbol 3 #f #f #f)
        )
      )
    :callback-list '()
    :borrow #f
    :bottom-height (meters -16.2593)
    :fog-height (meters 80)
    :max-rain 1.0
    :fog-mult 1.0
    :mood-range (new 'static 'mood-range :max-cloud 1.0 :min-fog 0.5 :max-fog 1.0)
    )
  )

(#when PC_PORT
  (cons! *level-load-list* 'indus-test)
  )
