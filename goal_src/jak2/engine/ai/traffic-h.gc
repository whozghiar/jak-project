;;-*-Lisp-*-
(in-package goal)

;; name: traffic-h.gc
;; name in dgo: traffic-h
;; dgos: ENGINE, GAME

;; +++traffic-danger-type
(defenum traffic-danger-type
  :type uint8
  (tdt0 0)
  (tdt1 1)
  (tdt2 2)
  (tdt3 3)
  (tdt4 4)
  (tdt5 5)
  (tdt6 6)
  (tdt7 7)
  )
;; ---traffic-danger-type

;; +++traffic-danger-flags
(defenum traffic-danger-flags
  :type uint8
  :bitfield #t
  (tdf0 0)
  )
;; ---traffic-danger-flags

;; +++traffic-h:traffic-type
(defenum traffic-type
  :type uint8
  (citizen-norm-1 0)
  (citizen-chick 1)
  (citizen-fat 2)
  (citizen-norm-2 3)
  (crimson-guard-0 4)
  (tt5 5)
  (crimson-guard-1 6)
  (crimson-guard-2 7)
  (metalhead-grunt 8)
  (metalhead-flitter 9)
  (metalhead-predator 10)
  (bikea 11)
  (bikeb 12)
  (bikec 13)
  (cara 14)
  (carb 15)
  (carc 16)
  (tt17 17)
  (guard-bike 18)
  (hellcat 19)
  (traffic-type-20 20)
  (traffic-type-21 21)
  ;; --- MOD haven-city-chaos -------------------------------------------------
  ;; Extra city metal-head species. 21 stays reserved: retail code uses
  ;; `(traffic-type traffic-type-21)` as an "invalid / none" sentinel
  ;; (ctywide-obs.gc), so it must never become a spawnable slot.
  ;; Both are inert on a stock game: `lwide-activate` leaves their `level` at
  ;; #f and `init-params` gives them want-count 0, so `spawn-all` never
  ;; creates a reserve process for them.
  (chaos-rapid-gunner 22)
  (chaos-spyder 23)
  )
;; ---traffic-h:traffic-type

;; MOD haven-city-chaos -- number of entries in every per-traffic-type array
;; (`traffic-engine::object-type-info-array`, the want-count table, the
;; spawn-mask width). Retail value was 21; the two chaos species push it to 24.
;; Anything that iterates traffic types must use this instead of a literal.
(defconstant TRAFFIC_TYPE_COUNT 24)

;; MOD haven-city-chaos -- bit set of traffic types `spawn-all` is allowed to
;; consider: every type in [0, TRAFFIC_TYPE_COUNT) except the 21 sentinel.
(defconstant TRAFFIC_SPAWN_MASK #xdfffff)

;; +++traffic-h:traffic-spawn-flags
(defenum traffic-spawn-flags
  :type uint32
  :bitfield #t
  (trsflags-00)
  (trsflags-01)
  (trsflags-02)
  (dark-guard)
  (trsflags-04)
  (trsflags-05)
  (trsflags-06)
  (trsflags-07)
  )
;; ---traffic-h:traffic-spawn-flags

;; NOTE - for default-menu
(define-extern traffic-start (function none))
(define-extern traffic-kill (function none))

;; NOTE - for vehicle-rider
(define-extern lwide-entity-hack (function none))

(define-extern *traffic-alert-level-force* symbol)

(declare-type nav-mesh basic)
(declare-type nav-branch structure)
(declare-type traffic-manager process)

;; ================================================================================================
;; MOD haven-city-chaos -- hook layer
;; ------------------------------------------------------------------------------------------------
;; The shared city engine files (traffic-engine.gc, traffic-manager.gc, guard.gc) must stay
;; behaviour-identical when the mod is off, and must not depend on the mod's own files being
;; compiled first. They therefore only ever read these forward-declared globals, which
;; `pc/mods/haven-city-chaos-h.gc` (declared before them in game.gp) defines with stock-safe
;; defaults. Turning the mod on only ever flips these values -- never patches engine code.
;; ================================================================================================

;; Master toggle. #f => every hook below is a no-op and the city behaves exactly like retail.
(define-extern *mod-chaos-enable* symbol)

;; Multiplier applied to a freshly spawned Krimzon Guard's hit-points (1.0 = retail).
(define-extern *mod-chaos-guard-hp-scale* float)

;; #t => city guards drop Jak from their target list and only fight metal heads.
(define-extern *mod-chaos-guards-ignore-jak* symbol)

;; Picks which citizen-side traffic type the engine should try to activate next.
;; Returns a traffic-type; the stock implementation reproduces the retail uniform
;; draw over types 0..10, the mod version adds the chaos species with their weights.
;; Argument is the traffic-engine (typed `object` to avoid a forward-reference cycle).
(define-extern *mod-chaos-citizen-type-hook* (function object traffic-type))

;; Spawns one of the chaos-only traffic types. Returns #f for every retail type so
;; `traffic-object-spawn` can fall through to its own dispatch untouched.
;; Arguments: parent process, traffic-object-spawn-params.
(define-extern *mod-chaos-spawn-hook* (function process object process-drawable))

;; Called once per frame from traffic-manager::update, after the stock update.
(define-extern *mod-chaos-traffic-update-hook* (function traffic-manager none))

;; Restores every hook above to its always-resident default. Called from `ctywide-deactivate`,
;; i.e. from CWI.DGO, which is compiled before the file that defines this -- hence the extern.
(define-extern mod-chaos-reset-hooks! (function none))

;; Called from `lwide-activate` after the stock per-level table is written, so the mod
;; can enable its own species for the borrowed city level. Argument is the level symbol.
(define-extern *mod-chaos-lwide-activate-hook* (function symbol none))

;; DECOMP BEGINS

(define *traffic-manager* (the-as traffic-manager #f))

(define *ctywide-entity* (the-as entity #f))

(define *lwide-entity* (the-as entity #f))

(define *race-vehicle-entity* (the-as entity-actor #f))

(deftype traffic-danger-info (structure)
  ((sphere         sphere  :inline)
   (velocity       vector  :inline)
   (handle         handle)
   (notify-radius  float)
   (danger-level   float)
   (decay-rate     float)
   (flags          traffic-danger-flags)
   (danger-type    traffic-danger-type)
   )
  )


(deftype traffic-suppression-params (structure)
  ((bbox      bounding-box  :inline)
   (duration  time-frame)
   (id        int8)
   )
  (:methods
    (try-creating-new-suppression-box (_type_) symbol)
    (create-or-update-suppression-box (_type_) symbol)
    (has-valid-id? (_type_) none)
    (kill-suppression-box (_type_) none)
    )
  )


;; WARN: Return type mismatch symbol vs none.
(defmethod has-valid-id? ((this traffic-suppression-params))
  (!= (-> this id) -1)
  (none)
  )

(deftype traffic-object-spawn-params (structure)
  ((object-type  traffic-type)
   (behavior     uint64)
   (id           uint32)
   (nav-mesh     nav-mesh)
   (nav-branch   nav-branch)
   (position     vector      :inline)
   (rotation     quaternion  :inline)
   (velocity     vector      :inline)
   (handle       handle)
   (guard-type   uint8)
   (user-data    uint32)
   (flags        traffic-spawn-flags)
   (proc         process)
   )
  )

(deftype mystery-traffic-object-spawn-params (structure)
  "TODO - what is this!"
  ((params traffic-object-spawn-params :inline :offset-assert 0)
   (vector vector 3 :inline :offset-assert 112)
  ))

(define-extern traffic-object-spawn (function process traffic-object-spawn-params process-drawable))
