(defpart 5490
  :init-specs ((:texture (starflash effects))
    (:num 1.0)
    (:y (meters 0.3))
    (:scale-x (meters 2.0))
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y :copy scale-x)
    (:r 100.0)
