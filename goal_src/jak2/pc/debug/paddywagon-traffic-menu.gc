;;-*-Lisp-*-
(in-package goal)

#|
  ============================================================================
  paddywagon-traffic-menu.gc -- Debug > Mods > paddywagon-traffic
  ============================================================================

  Registers the "paddywagon / traffic" mod's on/off switch with the unified
  "Mods" debug tab (goal_src/jak2/pc/debug/mods-menu.gc), per the mandatory
  procedure in docs/modding/tools/mods_debug_menu.md and CLAUDE.md's golden
  rules.

  This file only declares the flag's type and registers the menu row. The flag
  itself, *mod-paddywagon-traffic-enable*, is defined (define-perm, #f default)
  in goal_src/jak2/levels/city/traffic/traffic-manager.gc -- a non-debug file
  resident in the CWI DGO next to every site that reads it -- so the gated code
  compiles in release builds too (this menu file is (declare-file (debug)) and
  is stripped from release).

  The whole mod is one cohesive behaviour (a Krimzon Guard paddy wagon woven
  into Haven City's ground traffic, carrying a random civilian prisoner in its
  rear cage, guard-piloted, drivable and stealable), so a single master toggle
  is exposed. With it OFF the traffic want-count for the paddywagon-v slot is 0,
  so no paddywagon-v is ever spawned and none of paddywagon-v.gc's code runs.

  NOTE: the want-count is read in `traffic-manager` `init-params`, which runs
  when the city (re)loads -- toggling this flag takes effect on the next city
  load / level reload, not instantly mid-frame.

  Wiring: "paddywagon-traffic-menu.o" is listed in goal_src/jak2/dgos/game.gd
  immediately after "mods-menu.o".
|#

;; debug-only file: stripped from release builds like the rest of the menu code.
(declare-file (debug))

;; the flag lives in traffic-manager.gc; just declare its type for this file.
(define-extern *mod-paddywagon-traffic-enable* symbol)

;; ============================================================================
;; Menu builder -- pure: only builds and returns the submenu node.
;; ============================================================================

(defun mod-paddywagon-traffic-build-menu ((ctx debug-menu-context))
  "Return the 'paddywagon-traffic' submenu node."
  (debug-menu-make-from-template ctx
    '(menu "paddywagon-traffic"
       ;; plain boolean -- the traffic code reads *mod-paddywagon-traffic-enable*
       ;; on city load, so the stock no-side-effect toggle pick-func is enough.
       (flag "Enable (applies on next city load)"
             *mod-paddywagon-traffic-enable* dm-boolean-toggle-pick-func)
       )
    )
  )

;; ============================================================================
;; Register with the unified Mods tab (top-level, runs at file load / (mi)).
;; ============================================================================

(mods-menu-register "paddywagon-traffic" mod-paddywagon-traffic-build-menu)
