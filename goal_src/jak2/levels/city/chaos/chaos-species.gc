;; Verbatim port of `rapid-gunner::hop-turn`: turn in place at four times the normal rate until the
;; predicted aim point is back inside a 35-degree arc.
(defstate hop-turn (chaos-rapid-gunner)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set! (-> self predict-timer) (the-as uint (current-time)))
    (let ((v1-2 self))
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logclear (-> v1-2 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-2 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    (let ((v1-5 self))
      (set! (-> v1-5 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag37) (-> v1-5 enemy-flags))))
      )
    0
    (logior! (-> self focus-status) (focus-status dangerous))
    (let* ((v1-9 *game-info*)
           (v0-0 (+ (-> v1-9 attack-id) 1))
           )
      (set! (-> v1-9 attack-id) v0-0)
      (set! (-> self attack-id) v0-0)
      )
    )
  :exit (behavior ()
    (if (logtest? (-> self enemy-flags) (enemy-flag dangerous-backup))
        (logior! (-> self focus-status) (focus-status dangerous))
        (logclear! (-> self focus-status) (focus-status dangerous))
        )
    )
  :trans (behavior ()
    (seek! (-> self joint-blend) 0.0 (seconds-per-frame))
    (when (chaos-rgun-facing? self 6371.5557)
      (chaos-rgun-aim! self (-> self target-next-pos) 24.0)
      (when (skip-check-los? (-> self los) 30)
        (vector-normalize-copy! (-> self hop-dir) (-> self focus-dir) -1.0)
        (go-virtual hop)
        )
      (go-hostile self)
      )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (until #f
      (ja-no-eval :group! rapid-gunner-turn-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (chaos-rgun-aim! self (-> self target-next-pos) 4.0)
    (let ((a0-2 (handle->process (-> self focus handle))))
      (if (and a0-2 (let ((a1-2 self))
                      (logtest? (enemy-flag enemy-flag37) (-> a1-2 enemy-flags))
                      )
               )
          (seek-to-point-toward-point!
            (-> self root)
            (get-trans (the-as process-focusable a0-2) 3)
            (* 4.0 (-> self nav max-rotation-rate))
            (seconds 0.5)
            )
          )
      )
    (chaos-rgun-track-post)
    (nav-enemy-simple-post)
    )
  )

;; Verbatim port of `rapid-gunner::cool-down`.
(defstate cool-down (chaos-rapid-gunner)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self shots-fired) (the-as uint 0))
    0
    )
  :trans (behavior ()
    (if (time-elapsed? (-> self state-time) (seconds 0.5))
        (go-hostile self)
        )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (until #f
      (ja-no-eval :group! rapid-gunner-aim-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (chaos-rgun-track-post)
    (nav-enemy-face-focus-post)
    )
  )

;; Verbatim port of `rapid-gunner::reload`: the reload animation at half speed, then a hop if the
;; gunner is still exposed when it finishes.
(defstate reload (chaos-rapid-gunner)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set! (-> self predict-timer) (the-as uint (current-time)))
    (set! (-> self shots-fired) (the-as uint 0))
    (let ((v1-2 self))
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logclear (-> v1-2 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-2 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    (let ((v1-5 self))
      (set! (-> v1-5 enemy-flags) (the-as enemy-flag (logclear (-> v1-5 enemy-flags) (enemy-flag enemy-flag37))))
      )
    0
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (ja-no-eval :group! rapid-gunner-reload-ja :num! (seek! max 0.5) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 0.5))
      )
    (when (skip-check-los? (-> self los) 30)
      (vector-normalize-copy! (-> self hop-dir) (-> self focus-dir) -1.0)
      (go-virtual hop)
      )
    (go-hostile self)
    )
  :post (behavior ()
    (chaos-rgun-track-post)
    (nav-enemy-face-focus-post)
    )
  )

(defmethod go-stare ((this chaos-rapid-gunner))
  "Verbatim `rapid-gunner::go-stare`: an emplacement has nothing to stare from, so losing interest
   keeps it hostile and its own `hostile` trans decides when to stand down (focus aware <= 1 sends
   it back to the city walk)."
  (go (method-of-object this hostile))
  )

(defmethod nav-enemy-method-142 ((this chaos-rapid-gunner) (arg0 nav-control))
  "Retail suppresses the default turn-to-heading entirely -- the gunner is oriented by its own
   state posts. Verbatim override."
  0
  (none)
  )

(defmethod init-enemy-collision! ((this chaos-rapid-gunner))
  ;; Borrow the retail primitive layout -- `spin-attack` addresses child 1 by index, so
  ;; hand-writing it would silently break the melee -- then widen it for city faction combat.
  ((method-of-type rapid-gunner init-enemy-collision!) (the-as rapid-gunner this))
  (chaos-cityify-collision! this)
  0
  (none)
  )

(defmethod init-enemy! ((this chaos-rapid-gunner))
  "Common city bring-up, then the retail gunner's own setup minus the two things a traffic-spawned
   process cannot have.

   Skipped: the `spinup-angle` res-lump read (no entity to read it from -- and the value is dead in
   retail anyway, `spin-up-angle` is written and never used), and the three `*part-engine*`
   connections for the barrel heat haze (particles 1310-1312 live in the Ruins level data and are
   not resident in Haven City)."
  ((method-of-type chaos-metalhead init-enemy!) this)
  (set! (-> this joint) (new 'process 'joint-mod (joint-mod-mode joint-set*-world) this 5))
  (set-vector! (-> this root scale) 1.2 1.2 1.2 1.0)
  ;; Seed the aim prediction 100 m straight ahead so the first frame of tracking has somewhere to
  ;; interpolate from rather than the origin.
  (let ((ahead (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)))
        (seed (new 'stack-no-clear 'vector))
        )
    (vector+float*! seed (-> this root trans) ahead 409600.0)
    (set! (-> this target-next-pos quad) (-> seed quad))
    (set! (-> this target-prev-pos quad) (-> seed quad))
    )
  (set! (-> this shots-fired) (the-as uint 0))
  (set! (-> this spin-up-timer) 0)
  (set! (-> this shot-timer) (the-as uint 0))
  (set! (-> this predict-timer) (the-as uint 0))
  (logclear! (-> this status-flags) (rapid-gunner-flags ragflags-0))
  (logior! (-> this status-flags) (rapid-gunner-flags ragflags-1))
  (vector-reset! (-> this focus-dir))
  (set! (-> this joint-enable) #f)
  (set! (-> this joint-blend) 0.0)
  (set! (-> this shoot-anim-index) -1)
  (logclear! (-> this nav flags) (nav-control-flag update-heading-from-facing))
  (set! (-> this enemy-flags) (the-as enemy-flag (logclear (-> this enemy-flags) (enemy-flag enemy-flag43))))
  (set! (-> this start-pos quad) (-> this root trans quad))
  0
  (none)
  )

(defmethod relocate ((this chaos-rapid-gunner) (offset int))
  (if (nonzero? (-> this joint))
      (&+! (-> this joint) offset)
      )
  (call-parent-method this offset)
  )

;; ------------------------------------------------------------------------------------------------
;; chaos-spyder -- "Spyder gunner"  (5%)
;;
;; Retail combat loop, ported from levels/common/enemy/spyder.gc:
;;
;;   hostile -- a *stand-off* state, not a chase. `chaos-spyder-reposition!` picks a destination:
;;              inside 35 m it strafes sideways a random 8-16 m, outside 35 m it closes to 30 m.
;;              On arrival, if the focus is within 35 m and in line of sight, `attack`.
;;   attack  -- STOP, drop the turn rate to a twentieth, blend the low and high shooting animations
;;              together and hold the volley for eight ticks of 0.2 s, walking the aim point along
;;              the ground toward the focus and leading it as it moves. Each shot is fired by the
;;              animation itself: the art group's `event-attack` tag fires the `:event` handler,
;;              which spawns a `spyder-shot` along the `fire-info` pair that the `:code` keeps
;;              updated. That is why the gun fires in time with the muzzle flash.
;;   backup  -- retreat to `move-dest` for up to six seconds, then back to `hostile`.
;;
;; The leg IK (`chaos-spyder-legs!`) is kept: without it the spyder's four legs float over the
;; city's slopes and kerbs instead of planting on them. It costs one `*collide-cache*` fill per
;; spyder per frame, which is why the species' population share is the smallest of the five.
;; ------------------------------------------------------------------------------------------------

(deftype chaos-spyder (chaos-metalhead)
  ((joint              joint-mod)
   (face-pos           vector        :inline)
   (my-up-vector       vector        :inline)
   (status-flags       spyder-flags)
   (fire-info          vector        2 :inline)
   (joint-ik           joint-mod-ik  4)
   (delta-y-ik         float         4)
   (fade               float)
   (dest-fade          float)
   )
  (:state-methods
    attack
    backup
    )
  (:methods
    (chaos-spyder-reposition! (_type_) none)
    (chaos-spyder-twist! (_type_) none)
    (chaos-spyder-fire! (_type_ matrix float) none)
    (chaos-spyder-orient! (_type_ vector) none)
    (chaos-spyder-legs! (_type_) none)
    )
  )

(defmethod chaos-skel-name ((this chaos-spyder))
  "Skeleton group worn by the Spyder gunner. A method body that is nothing but a string would be
   read as a docstring, hence this one."
  "skel-spyder"
  )

(defmethod get-nav-info ((this chaos-spyder))
  "Reuse the retail spyder's tuning verbatim: 8 hit points, 80 m notice distance, its full
   animation table. Read-only -- the Haven Forest and Mountain Temple spyders share this object."
  *spyder-nav-enemy-info*
  )

(defmethod chaos-spyder-reposition! ((this chaos-spyder))
  "Choose where to stand. Verbatim `spyder-method-181`.

   Inside 35 m it strafes: take the vector to the focus, rotate it 90 degrees (alternating
   direction each call via `spflags-4`), scale it to a random 8-16 m and clamp the result to the
   nav mesh. Outside 35 m it closes to 30 m. This is what makes a spyder sidestep rather than
   charge, and it is the single biggest behavioural difference from the old generic chase."
  (let ((a0-2 (handle->process (-> this focus handle))))
    (when a0-2
      (let* ((s5-0 (-> this root trans))
             (s2-1 (vector-! (new 'stack-no-clear 'vector) (get-trans (the-as process-focusable a0-2) 0) s5-0))
             (f0-0 (vector-length s2-1))
             (s4-0 (new 'stack-no-clear 'vector))
             )
        (cond
          ((>= 143360.0 f0-0)
           (let ((s3-0 (new 'stack-no-clear 'vector)))
             (logxor! (-> this status-flags) (spyder-flags spflags-4))
             (if (logtest? (-> this status-flags) (spyder-flags spflags-4))
                 (set-vector! s3-0 (-> s2-1 z) (-> s2-1 y) (- (-> s2-1 x)) 1.0)
                 (set-vector! s3-0 (- (-> s2-1 z)) (-> s2-1 y) (-> s2-1 x) 1.0)
                 )
             (vector-normalize! s3-0 (* 4096.0 (rand-vu-float-range 8.0 16.0)))
             (clamp-vector-to-mesh-cross-gaps
               (-> this nav)
               s5-0
               (-> this nav state current-poly)
               s3-0
               204.8
               #f
               (the-as clamp-travel-vector-to-mesh-return-info #f)
               )
             (vector+! s4-0 s5-0 s3-0)
             )
           )
          (else
            (vector-normalize! s2-1 (+ -122880.0 f0-0))
            (vector+! s4-0 s5-0 s2-1)
            )
          )
        (set! (-> this move-dest quad) (-> s5-0 quad))
        (cloest-point-on-mesh (-> this nav) (-> this move-dest) s4-0 (the-as nav-poly #f))
        )
      )
    )
  0
  (none)
  )

(defmethod chaos-spyder-twist! ((this chaos-spyder))
  "Twist the body toward `face-pos` and settle the abdomen joint. Verbatim `spyder-method-182`."
  (cond
    ((and (logtest? (-> this status-flags) (spyder-flags spflags-2)) (!= (-> this joint scale z) 1.0))
     (seek! (-> this joint scale z) 1.0 (* 0.8 (seconds-per-frame)))
     )
    ((and (not (logtest? (-> this status-flags) (spyder-flags spflags-2))) (!= (-> this joint scale z) 0.0))
     (seek! (-> this joint scale z) 0.0 (* 0.8 (seconds-per-frame)))
     )
    )
  (let ((s5-0 (new 'stack-no-clear 'quaternion)))
    (let ((a1-2 (-> this node-list data 37 bone transform)))
      (matrix-with-scale->quaternion s5-0 a1-2)
      )
    (let ((a1-4 (quaternion-from-two-vectors! (new 'stack-no-clear 'quaternion) (-> this my-up-vector) *up-vector*)))
      (quaternion*! s5-0 a1-4 s5-0)
      )
    (let ((s4-1 (vector-! (new 'stack-no-clear 'vector) (-> this face-pos) (-> this root trans)))
          (s3-0 (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)))
          )
      (cond
        ((logtest? (-> this status-flags) (spyder-flags spflags-3))
         (vector-! s4-1 (-> this face-pos) (-> this root trans))
         (logclear! (-> this status-flags) (spyder-flags spflags-3))
         )
        (else
          (set! (-> s4-1 quad) (-> s3-0 quad))
          )
        )
      (set! (-> s4-1 y) 0.0)
      (vector-xz-normalize! s4-1 1.0)
      (set! (-> s3-0 y) 0.0)
      (vector-xz-normalize! s3-0 1.0)
      (let ((a1-11 (quaternion-from-two-vectors-max-angle! (new 'stack-no-clear 'quaternion) s3-0 s4-1 10012.444)))
        (quaternion*! s5-0 a1-11 s5-0)
        )
      )
    (quaternion-slerp!
      (the-as quaternion (-> this joint twist))
      (the-as quaternion (-> this joint twist))
      s5-0
      (* 10.0 (seconds-per-frame))
      )
    )
  0
  (none)
  )

(defmethod chaos-spyder-fire! ((this chaos-spyder) (arg0 matrix) (arg1 float))
  "Spawn one `spyder-shot` from `fire-info 0` toward `fire-info 1`. Verbatim `spyder-method-183`.

   Called from the `attack` state's `:event` handler when the animation reaches its `event-attack`
   tag, which is what keeps the shots in time with the muzzle. `spyder-shot` is a `metalhead-shot`
   and already lists `civilian` and `enemy` in its collide-with, so it damages Krimzon Guards
   unmodified."
  (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
    (let ((v1-0 (-> arg0 vector))
          (a1-1 (-> arg0 vector 1))
          )
      (set! (-> gp-0 ent) (-> this entity))
      (set! (-> gp-0 charge) 1.0)
      (set! (-> gp-0 options) (projectile-options))
      (set! (-> gp-0 pos quad) (-> v1-0 0 quad))
      (set! (-> gp-0 notify-handle) (process->handle this))
      (set! (-> gp-0 owner-handle) (the-as handle #f))
      (set! (-> gp-0 ignore-handle) (process->handle this))
      (let* ((a0-10 *game-info*)
             (a3-11 (+ (-> a0-10 attack-id) 1))
             )
        (set! (-> a0-10 attack-id) a3-11)
        (set! (-> gp-0 attack-id) a3-11)
        )
      (set! (-> gp-0 timeout) (seconds 4))
      (vector-normalize! (vector-! (-> gp-0 vel) a1-1 (the-as vector v1-0)) arg1)
      )
    (spawn-projectile spyder-shot gp-0 this *default-dead-pool*)
    )
  (none)
  )

(defmethod chaos-spyder-orient! ((this chaos-spyder) (arg0 vector))
  "Lay the body flat on the ground normal, at most ~25 degrees from vertical, easing toward it.
   Verbatim `spyder-method-184`. `spflags-0` makes it idempotent within a frame."
  (when (not (logtest? (-> this status-flags) (spyder-flags spflags-0)))
    (let ((s4-0 (new 'stack-no-clear 'vector)))
      (set! (-> s4-0 quad) (-> *up-vector* quad))
      (let ((s3-0 (new 'stack-no-clear 'quaternion)))
        (quaternion-from-two-vectors-max-angle! s3-0 s4-0 (-> this root gspot-normal) 4551.1113)
        (vector-orient-by-quat! s4-0 s4-0 s3-0)
        )
      (let ((s3-1 (-> this my-up-vector)))
        (vector-deg-seek s3-1 s3-1 s4-0 (* 16384.0 (seconds-per-frame)))
        (vector-normalize! s3-1 1.0)
        (forward-up-nopitch->quaternion (-> this root quat) arg0 s3-1)
        )
      )
    (logior! (-> this status-flags) (spyder-flags spflags-0))
    )
  0
  (none)
  )

(defmethod chaos-spyder-legs! ((this chaos-spyder))
  "Plant the four legs on the ground with IK. Verbatim `spyder-method-185`.

   For each leg: take the elbow matrix, walk `hand-dist` along its second axis to get the nominal
   foot position, drop a 4 cm line-sphere probe 8 m downward from 4 m above it, and ease the foot
   toward whatever it hit, clamped to +/- 2 m. One `fill-using-bounding-box` per spyder per frame."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf)
         )
    (init-vf0-vector)
    (let ((s5-0 (new 'stack-no-clear 'collide-query)))
      (let ((v1-0 (-> s5-0 bbox))
            (a0-2 (-> this root trans))
            (a1-0 (new 'stack-no-clear 'vector))
            )
        (set! (-> a1-0 x) 22528.0)
        (set! (-> a1-0 y) 22528.0)
        (set! (-> a1-0 z) 22528.0)
        (set! (-> a1-0 w) 1.0)
        (vector-! (the-as vector v1-0) a0-2 a1-0)
        )
      (let ((v1-2 (-> s5-0 bbox max))
            (a0-4 (-> this root trans))
            (a1-1 (new 'stack-no-clear 'vector))
            )
        (set! (-> a1-1 x) 22528.0)
        (set! (-> a1-1 y) 22528.0)
        (set! (-> a1-1 z) 22528.0)
        (set! (-> a1-1 w) 1.0)
        (vector+! v1-2 a0-4 a1-1)
        )
      (set! (-> s5-0 collide-with) (collide-spec backgnd))
      (set! (-> s5-0 ignore-process0) #f)
      (set! (-> s5-0 ignore-process1) #f)
      (set! (-> s5-0 ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (fill-using-bounding-box *collide-cache* s5-0)
      (dotimes (s4-0 4)
        (-> this joint-ik s4-0 shoulder-matrix-no-ik)
        (let ((a2-8 (-> this joint-ik s4-0 elbow-matrix-no-ik))
              (s3-0 (new 'stack-no-clear 'vector))
              )
          (let ((v1-15 (new 'stack-no-clear 'vector)))
            (set! (-> v1-15 quad) (-> *y-vector* quad))
            (new 'stack-no-clear 'vector)
            (let ((s2-0 (new 'stack-no-clear 'vector)))
              (let ((a1-3 s3-0))
                (let ((a0-9 (-> a2-8 trans)))
                  (let ((a2-9 (-> a2-8 vector 1)))
                    (let ((a3-3 (-> this joint-ik s4-0 hand-dist)))
                      (.mov vf7 a3-3)
                      )
                    (.lvf vf5 (&-> a2-9 quad))
                    )
                  (.lvf vf4 (&-> a0-9 quad))
                  )
                (.add.x.vf.w vf6 vf0 vf0)
                (.mul.x.vf.xyz acc vf5 vf7)
                (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
                (.svf (&-> a1-3 quad) vf6)
                )
              (set! (-> s2-0 quad) (-> s3-0 quad))
              (set! (-> s2-0 y) (-> this root trans y))
              (let ((a2-10 (-> s5-0 start-pos)))
                (let ((a0-12 s2-0))
                  (let ((a1-6 v1-15))
                    (let ((a3-5 16384.0))
                      (.mov vf7 a3-5)
                      )
                    (.lvf vf5 (&-> a1-6 quad))
                    )
                  (.lvf vf4 (&-> a0-12 quad))
                  )
                (.add.x.vf.w vf6 vf0 vf0)
                (.mul.x.vf.xyz acc vf5 vf7)
                (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
                (.svf (&-> a2-10 quad) vf6)
                )
              (vector-float*! (-> s5-0 move-dist) v1-15 -32768.0)
              (let ((v1-16 s5-0))
                (set! (-> v1-16 radius) 40.96)
                (set! (-> v1-16 collide-with) (collide-spec backgnd))
                (set! (-> v1-16 ignore-process0) #f)
                (set! (-> v1-16 ignore-process1) #f)
                (set! (-> v1-16 ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
                (set! (-> v1-16 action-mask) (collide-action solid))
                )
              (let ((f0-13 (probe-using-line-sphere *collide-cache* s5-0)))
                (when (>= f0-13 0.0)
                  (let ((a1-10 s2-0))
                    (let ((v1-19 (-> s5-0 start-pos)))
                      (let ((a0-20 (-> s5-0 move-dist)))
                        (let ((a2-11 f0-13))
                          (.mov vf7 a2-11)
                          )
                        (.lvf vf5 (&-> a0-20 quad))
                        )
                      (.lvf vf4 (&-> v1-19 quad))
                      )
                    (.add.x.vf.w vf6 vf0 vf0)
                    (.mul.x.vf.xyz acc vf5 vf7)
                    (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
                    (.svf (&-> a1-10 quad) vf6)
                    )
                  )
                )
              (let ((f0-15 (fmax -8192.0 (fmin 8192.0 (- (-> s2-0 y) (-> s3-0 y))))))
                (+! (-> this delta-y-ik s4-0) (* 10.0 (seconds-per-frame) (- f0-15 (-> this delta-y-ik s4-0))))
                )
              )
            )
          (+! (-> s3-0 y) (-> this delta-y-ik s4-0))
          (handle-copy! (-> this joint-ik s4-0) s3-0)
          )
        )
      )
    0
    (none)
    )
  )

(defmethod nav-enemy-method-142 ((this chaos-spyder) (arg0 nav-control))
  "Orient to the ground along the nav heading rather than the default upright turn. Verbatim
   `spyder::nav-enemy-method-142`."
  (let ((t9-0 (method-of-object this chaos-spyder-orient!))
        (a2-0 (-> arg0 state))
        (a1-1 (new 'stack-no-clear 'vector))
        )
    (set! (-> a1-1 quad) (-> a2-0 heading quad))
    (t9-0 this a1-1)
    )
  0
  (none)
  )

(defmethod coin-flip? ((this chaos-spyder))
  "Retail spyders never take the random branch this gates. Verbatim override."
  #f
  )

(defmethod common-post ((this chaos-spyder))
  "Retail `spyder::common-post` with `nav-enemy common-post` replaced by the chaos base, which is
   `citizen-enemy`'s plus the city overlap filter. The order around it is retail's: legs and body
   orientation first so the skeleton is placed before it is drawn, twist and sound after."
  (chaos-spyder-legs! this)
  (chaos-spyder-orient! this (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)))
  (update-trans! (-> this sound) (-> this root trans))
  (update! (-> this sound))
  (chaos-spyder-twist! this)
  ((method-of-type chaos-metalhead common-post) this)
  (logclear! (-> this status-flags) (spyder-flags spflags-0))
  (if (logtest? (-> this status-flags) (spyder-flags spflags-5))
      (los-control-method-9 (-> this los) (the-as process-focusable #f) (the-as vector #f) 2048.0)
      )
  (none)
  )

(defbehavior chaos-spyder-travel-post chaos-spyder ()
  "Verbatim `spyder-travel-post`."
  (set! (-> self face-pos quad) (-> self move-dest quad))
  (logior! (-> self status-flags) (spyder-flags spflags-3))
  (nav-enemy-travel-post)
  0
  (none)
  )

(defbehavior chaos-spyder-face-post chaos-spyder ()
  "Verbatim `spyder-face-player-post`: stand still and turn to face the focus."
  (logior! (-> self status-flags) (spyder-flags spflags-3))
  (let ((gp-0 (handle->process (-> self focus handle)))
        (f30-0 (-> self nav max-rotation-rate))
        )
    (when gp-0
      (set! (-> self face-pos quad) (-> (get-trans (the-as process-focusable gp-0) 0) quad))
      (let ((a0-4 self))
        (if (logtest? (enemy-flag enemy-flag37) (-> a0-4 enemy-flags))
            (seek-to-point-toward-point!
              (-> self root)
              (get-trans (the-as process-focusable gp-0) 0)
              f30-0
              (seconds 0.02)
              )
            )
        )
      )
    )
  (nav-enemy-simple-post)
  0
  (none)
  )

;; Verbatim port of `spyder::hostile`. Note that this is a stand-off state: `:post` drives toward
;; `move-dest`, which `chaos-spyder-reposition!` sets to a *strafe* target inside 35 m, not to the
;; focus. A spyder that walked into a guard was the clearest sign the retail states were missing.
(defstate hostile (chaos-spyder)
  :virtual #t
  :enter (behavior ()
    (let ((t9-0 (-> (method-of-type nav-enemy hostile) enter)))
      (if t9-0
          (t9-0)
          )
      )
    (chaos-spyder-reposition! self)
    (look-at-target! self (enemy-flag look-at-move-dest))
    (logclear! (-> self status-flags) (spyder-flags spflags-1))
    (when (!= (-> self dest-fade) 128.0)
      (set! (-> self dest-fade) 128.0)
      (sound-play "spyder-uncloak")
      )
    )
  :exit (behavior ()
    (let ((t9-0 (-> (method-of-type nav-enemy hostile) exit)))
      (if t9-0
          (t9-0)
          )
      )
    (logclear! (-> self status-flags) (spyder-flags spflags-5))
    (look-at-target! self (enemy-flag look-at-focus))
    )
  :trans (behavior ()
    (let ((t9-0 (-> (method-of-type nav-enemy hostile) trans)))
      (if t9-0
          (t9-0)
          )
      )
    (let ((a0-1 (handle->process (-> self focus handle))))
      (when a0-1
        (let ((gp-0 (new 'stack-no-clear 'vector)))
          (set! (-> gp-0 quad) (-> (get-trans (the-as process-focusable a0-1) 0) quad))
          (let* ((s5-0 (-> self root trans))
                 (f30-0 (vector-vector-distance s5-0 gp-0))
                 (f0-0 (vector-vector-xz-distance s5-0 (-> self move-dest)))
                 )
            (cond
              ((>= (+ 2048.0 (-> self root nav-radius)) f0-0)
               ;; Arrived at the strafe target: shoot if the focus is inside 35 m and visible,
               ;; otherwise pick the next one.
               (if (and (>= 143360.0 f30-0) (check-los? (-> self los) 0))
                   (go-virtual attack)
                   )
               (chaos-spyder-reposition! self)
               )
              ((>= 24576.0 f0-0)
               (logior! (-> self status-flags) (spyder-flags spflags-5))
               )
              )
            )
          )
        )
      )
    )
  :post (behavior ()
    (let ((a0-0 (-> self nav state))
          (v1-1 (-> self move-dest))
          )
      (logclear! (-> a0-0 flags) (nav-state-flag directional-mode))
      (logior! (-> a0-0 flags) (nav-state-flag target-poly-dirty))
      (set! (-> a0-0 target-post quad) (-> v1-1 quad))
      )
    0
    (chaos-spyder-travel-post)
    )
  )

;; Verbatim port of `spyder::backup`.
(defstate backup (chaos-spyder)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (let ((v1-2 self))
      (if (not (logtest? (enemy-flag enemy-flag36) (-> v1-2 enemy-flags)))
          (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag38) (-> v1-2 enemy-flags))))
          )
      (set! (-> v1-2 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag36) (-> v1-2 enemy-flags))))
      (set! (-> v1-2 nav callback-info) (-> v1-2 enemy-info callback-info))
      )
    0
    )
  :trans (behavior ()
    (let ((f0-0 (vector-vector-xz-distance (-> self root trans) (-> self move-dest))))
      (if (or (>= 4096.0 f0-0) (time-elapsed? (-> self state-time) (seconds 6)))
          (go-hostile self)
          )
      )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.1))
    (until #f
      (ja-no-eval :group! (-> self draw art-group data (-> self enemy-info run-anim)) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (chaos-spyder-travel-post)
    )
  )

;; Verbatim port of `spyder::attack` -- the state the Spyder gunner was missing entirely.
;;
;; The shots are fired by the *animation*: `spyder-shoot-low-ja` / `spyder-shoot-high-ja` carry an
;; `event-attack` tag, the effect system sends that event, and the `:event` handler below turns it
;; into a projectile along whatever `fire-info` currently holds. The `:code` meanwhile walks the
;; aim point out from under the target along the ground in eight 0.2 s steps and compensates for
;; the target's own movement between steps, which is what makes a spyder's volley track a running
;; guard instead of landing where it used to be.
(defstate attack (chaos-spyder)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('event-attack)
       (chaos-spyder-fire! self (the-as matrix (-> self fire-info)) 307200.0)
       )
      (else
        (enemy-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    ;; Plant the feet.
    (let ((v1-1 (-> self nav state))
          (a0-1 (-> self root trans))
          )
      (logclear! (-> v1-1 flags) (nav-state-flag directional-mode))
      (logior! (-> v1-1 flags) (nav-state-flag target-poly-dirty))
      (set! (-> v1-1 target-post quad) (-> a0-1 quad))
      )
    0
    (let ((v1-4 self))
      (set! (-> v1-4 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag37) (-> v1-4 enemy-flags))))
      )
    0
    (look-at-target! self (enemy-flag look-at-focus))
    (logior! (-> self enemy-flags) (enemy-flag lock-focus))
    )
  :exit (behavior ()
    (logclear! (-> self enemy-flags) (enemy-flag lock-focus))
    ;; og:preserve-this fix potential use-after-free bug (carried over from the retail source)
    (if (-> self nav)
      (let ((v1-2 (-> self nav)))
        (set! (-> v1-2 max-rotation-rate) (-> *spyder-nav-enemy-info* maximum-rotation-rate))
        ))
    0
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (if (or (>= 2 (the-as int (-> self focus aware))) (not (get-enemy-target self)))
        (go-stare self)
        )
    )
  :code (behavior ()
    ;; Turn to face the focus before committing -- the volley itself barely rotates.
    (when (not (enemy-method-96 self 2730.6667 #t))
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! spyder-patrol0-ja)
      (ja :num-func num-func-identity :frame-num 0.0)
      (until (enemy-method-96 self 910.2222 #t)
        (ja-blend-eval)
        (suspend)
        (ja :num! (loop! 0.75))
        )
      )
    (let ((v1-17 (-> self nav)))
      (set! (-> v1-17 max-rotation-rate) (/ (-> *spyder-nav-enemy-info* maximum-rotation-rate) 20))
      )
    0
    (ja-channel-push! 2 (seconds 0.2))
    (let ((f30-0 0.0))
      (ja-no-eval :group! spyder-shoot-low-ja :num! (loop!) :frame-num 0.0)
      (ja-no-eval :chan 1
                  :group! spyder-shoot-high-ja
                  :num! (chan 0)
                  :frame-interp0 f30-0
                  :frame-interp1 f30-0
                  :frame-num 0.0
                  )
      (let ((a0-14 (handle->process (-> self focus handle))))
        (when a0-14
          (let ((gp-0 (new 'stack-no-clear 'vector)))
            (set! (-> gp-0 quad) (-> (get-trans (the-as process-focusable a0-14) 0) quad))
            (let ((s5-0 (new 'stack-no-clear 'vector)))
              (set! (-> s5-0 quad) (-> gp-0 quad))
              (let ((f28-0 0.0))
                (dotimes (s4-0 8)
                  ;; Aim point: start 10 m short of the target and walk in 3 m per step, blending
                  ;; the low and high shooting poses as the muzzle rises.
                  (let* ((f26-0 (fmin (-> self root trans y) (-> gp-0 y)))
                         (s3-0 (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node spyder-lod0-jg shoot)))
                         (f0-11 (fmin 40960.0 (+ -16384.0 (vector-vector-distance s3-0 gp-0))))
                         (s2-1 (vector-! (new 'stack-no-clear 'vector) s3-0 gp-0))
                         )
                    (vector-normalize! s2-1 (- f0-11 f28-0))
                    (vector+! s2-1 gp-0 s2-1)
                    (set! (-> s2-1 y) f26-0)
                    (set! (-> self fire-info 0 quad) (-> s3-0 quad))
                    (set! (-> self fire-info 1 quad) (-> s2-1 quad))
                    )
                  (suspend-for (seconds 0.2)
                    (set! f30-0 (seek f30-0 (lerp-scale 0.0 1.0 (the float s4-0) 0.0 8.0) (seconds-per-frame)))
                    (ja :num! (loop!))
                    (ja :chan 1 :num! (chan 0) :frame-interp0 f30-0 :frame-interp1 f30-0)
                    )
                  ;; Lead the target: subtract however far it moved during the step.
                  (let ((f28-1 (+ 12288.0 f28-0)))
                    (set! (-> gp-0 quad) (-> s5-0 quad))
                    (let ((a0-31 (handle->process (-> self focus handle))))
                      (if a0-31
                          (set! (-> s5-0 quad) (-> (get-trans (the-as process-focusable a0-31) 0) quad))
                          )
                      )
                    (set! f28-0 (fmax 0.0 (- f28-1 (vector-vector-distance gp-0 s5-0))))
                    )
                  )
                )
              )
            )
          )
        )
      )
    (until (ja-done? 0)
      (ja :num! (seek! 2.0))
      (let ((a0-36 (-> self skel root-channel 1)))
        (let ((f0-23 1.0))
          (set! (-> a0-36 frame-interp 1) f0-23)
          (set! (-> a0-36 frame-interp 0) f0-23)
          )
        (set! (-> a0-36 param 0) 0.0)
        (joint-control-channel-group-eval! a0-36 (the-as art-joint-anim #f) num-func-chan)
        )
      (suspend)
      )
    (let ((v1-88 self))
      (set! (-> v1-88 enemy-flags) (the-as enemy-flag (logclear (-> v1-88 enemy-flags) (enemy-flag enemy-flag37))))
      )
    0
    (go-hostile self)
    )
  :post (behavior ()
    (chaos-spyder-face-post)
    )
  )

(defmethod go-hostile ((this chaos-spyder))
  "Verbatim `spyder::go-hostile`: open with a volley when coming out of `notice` or `knocked`,
   otherwise reposition first."
  (if (and (not (logtest? (-> this status-flags) (spyder-flags spflags-1)))
           (-> this next-state)
           (let ((v1-5 (-> this next-state name)))
             (or (= v1-5 'notice) (= v1-5 'knocked))
             )
           )
      (go (method-of-object this attack))
      )
  (go (method-of-object this hostile))
  )

(defmethod init-enemy-collision! ((this chaos-spyder))
  ;; Borrow the retail primitive layout, then widen it for city faction combat. All four of the
  ;; spyder's body children already carry `deadly`, so nothing else is needed here.
  ((method-of-type spyder init-enemy-collision!) (the-as spyder this))
  (chaos-cityify-collision! this)
  0
  (none)
  )

(defmethod init-enemy! ((this chaos-spyder))
  "Common city bring-up, then the retail spyder's own setup minus the cloak.

   The cloak is skipped because it is selected by `(res-lump-value (-> this entity) 'extra-id ...)`
   and a traffic-spawned process has no entity to read. Retail spyders without that tag are
   uncloaked too, so this is the stock else-branch, not an approximation."
  ((method-of-type chaos-metalhead init-enemy!) this)
  (set-gravity-length (-> this root dynam) 573440.0)
  (set-vector! (-> this root scale) 1.5 1.5 1.5 1.0)
  (set! (-> this my-up-vector quad) (-> *up-vector* quad))
  (set! (-> this status-flags) (spyder-flags spflags-2))
  (if (rand-vu-percent? 0.5)
      (logior! (-> this status-flags) (spyder-flags spflags-4))
      )
  (set! (-> this face-pos quad) (-> this root trans quad))
  (set! (-> this sound)
        (new 'process 'ambient-sound (static-sound-spec "spyder-talk" :fo-max 70) (-> this root trans))
        )
  (set! (-> this joint) (the-as joint-mod (new 'process 'joint-mod-blend-world this 4 #t 1.0)))
  (set! (-> this joint scale x) (the-as float (logior (the-as int (-> this joint scale x)) 4)))
  (let ((f30-0 (-> this root trans y)))
    (dotimes (s5-1 4)
      (set! (-> this joint-ik s5-1)
            (new
              'process
              'joint-mod-ik
              this
              (-> *spyder-ik-setup* s5-1 elbow-index)
              (-> *spyder-ik-setup* s5-1 hand-dist)
              )
            )
      ;; Retail creates these disabled and enables them when the spyder first enters `active`.
      ;; A city spyder is spawned straight into the traffic pool and activated by the engine, so
      ;; there is no idle phase to wait through -- enabling here is the same thing one frame
      ;; earlier, and it avoids overriding `active` purely to flip four booleans.
      (enable-set! (-> this joint-ik s5-1) #t)
      ;; Retail writes index 0 on every pass rather than `s5-1`. Reproduced deliberately: the other
      ;; three entries settle within a frame of the first `chaos-spyder-legs!` call, so "fixing" it
      ;; would be a behavioural change for no benefit.
      (set! (-> this delta-y-ik 0) f30-0)
      )
    )
  (setup-masks (-> this draw) 0 16)
  (setup-masks (-> this draw) 8 0)
  (set! (-> this fade) 0.0)
  (set! (-> this dest-fade) 0.0)
  0
  (none)
  )

(defmethod relocate ((this chaos-spyder) (offset int))
  (if (nonzero? (-> this joint))
      (&+! (-> this joint) offset)
      )
  (dotimes (v1-4 4)
    (if (nonzero? (-> this joint-ik v1-4))
        (&+! (-> this joint-ik v1-4) offset)
        )
    )
  (call-parent-method this offset)
  )
