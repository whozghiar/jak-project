;;-*-Lisp-*-
(in-package goal)

;; name: haven-city-chaos-menu.gc
;; name in dgo: haven-city-chaos-menu
;; dgos: GAME
;;
;; MOD "Haven City : Chaos" -- Mods > haven-city-chaos
;; ================================================================================================
;; Registers the mod's submenu with the shared `mods-menu.gc` registry, openable in-game
;; with L3 + SELECT in retail and debug boots.
;;
;;   [L3 + SELECT] > Mods > haven-city-chaos
;;     Enable                            -- the master switch; everything else is inert without it
;;     species > Grunt (30%)             -- on by default  (retail invasion species, no extra art)
;;             > Stinger (30%)           -- on by default
;;             > Cloaker (10%)           -- on by default
;;             > Rapid gunner (10%)      -- off by default (streams gunner art into LWIDEB)
;;             > Spyder gunner (5%)      -- off by default (streams spyder art into LWIDEB)
;;     guards  > Tougher guards          -- 1.5x hit points + vehicles engaging metal heads
;;             > Guards ignore Jak       -- the truce
;;
;; All the state itself lives in `pc/mods/haven-city-chaos-h.gc`; this file drives it through
;; the in-game popup menu.
;; ================================================================================================

;; ------------------------------------------------------------------------------------------------
;; Action functions (side effects on confirm)
;; ------------------------------------------------------------------------------------------------

(defun mod-haven-city-chaos-species-changed! ((ttype traffic-type) (now-on symbol))
  "Shared tail of every species toggle."
  (when (and (not now-on) *traffic-manager*)
    (send-event *traffic-manager* 'deactivate-by-type ttype)
    )
  (set! *mod-chaos-species-dirty* #t)
  0
  (none)
  )

(defun mod-haven-city-chaos-toggle-enable ()
  "Master toggle. mod-chaos-set-enable! flips the city onto (or off) the lwideb borrow."
  (set! *mod-chaos-enable* (not *mod-chaos-enable*))
  (mod-chaos-set-enable! *mod-chaos-enable*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-grunt ()
  (set! *mod-chaos-species-grunt* (not *mod-chaos-species-grunt*))
  (mod-haven-city-chaos-species-changed! (traffic-type metalhead-grunt) *mod-chaos-species-grunt*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-flitter ()
  (set! *mod-chaos-species-flitter* (not *mod-chaos-species-flitter*))
  (mod-haven-city-chaos-species-changed! (traffic-type metalhead-flitter) *mod-chaos-species-flitter*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-predator ()
  (set! *mod-chaos-species-predator* (not *mod-chaos-species-predator*))
  (mod-haven-city-chaos-species-changed! (traffic-type metalhead-predator) *mod-chaos-species-predator*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-rapid ()
  (set! *mod-chaos-species-rapid* (not *mod-chaos-species-rapid*))
  (mod-haven-city-chaos-species-changed! (traffic-type chaos-rapid-gunner) *mod-chaos-species-rapid*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-spyder ()
  (set! *mod-chaos-species-spyder* (not *mod-chaos-species-spyder*))
  (mod-haven-city-chaos-species-changed! (traffic-type chaos-spyder) *mod-chaos-species-spyder*)
  (none)
  )

(defun mod-haven-city-chaos-toggle-guard-buffs ()
  (set! *mod-chaos-guard-buffs* (not *mod-chaos-guard-buffs*))
  (set! *mod-chaos-guard-hp-scale*
        (if (and *mod-chaos-enable* *mod-chaos-guard-buffs*)
            MOD_CHAOS_GUARD_HP_SCALE
            1.0
            )
        )
  (none)
  )

(defun mod-haven-city-chaos-toggle-guards-ignore-jak ()
  (set! *mod-chaos-guards-ignore-jak* (not *mod-chaos-guards-ignore-jak*))
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Menu definition (static, costs no heap)
;; ------------------------------------------------------------------------------------------------

(define *mod-haven-city-chaos-menu*
  (new 'static 'popup-menu-submenu :label "haven-city-chaos"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-flag :label "Enable"
           :is-toggled? (lambda () *mod-chaos-enable*)
           :on-confirm (lambda () (mod-haven-city-chaos-toggle-enable) (none))
           )
      (new 'static 'popup-menu-submenu :label "species"
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (new 'static 'popup-menu-flag :label "Grunt (30%)"
               :is-toggled? (lambda () *mod-chaos-species-grunt*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-grunt) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          (new 'static 'popup-menu-flag :label "Stinger (30%)"
               :is-toggled? (lambda () *mod-chaos-species-flitter*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-flitter) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          (new 'static 'popup-menu-flag :label "Cloaker (10%)"
               :is-toggled? (lambda () *mod-chaos-species-predator*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-predator) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          (new 'static 'popup-menu-flag :label "Rapid gunner (10%)"
               :is-toggled? (lambda () *mod-chaos-species-rapid*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-rapid) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          (new 'static 'popup-menu-flag :label "Spyder gunner (5%)"
               :is-toggled? (lambda () *mod-chaos-species-spyder*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-spyder) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          )
        )
      (new 'static 'popup-menu-submenu :label "guards"
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (new 'static 'popup-menu-flag :label "Tougher guards"
               :is-toggled? (lambda () *mod-chaos-guard-buffs*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-guard-buffs) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          (new 'static 'popup-menu-flag :label "Guards ignore Jak"
               :is-toggled? (lambda () *mod-chaos-guards-ignore-jak*)
               :on-confirm (lambda () (mod-haven-city-chaos-toggle-guards-ignore-jak) (none))
               :entry-disabled? (lambda () (not *mod-chaos-enable*))
               )
          )
        )
      )
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Builder
;; ------------------------------------------------------------------------------------------------

(defun mod-haven-city-chaos-build-menu ()
  "Return this mod's submenu entry."
  (the-as popup-menu-entry *mod-haven-city-chaos-menu*)
  )

(mods-menu-register "haven-city-chaos" mod-haven-city-chaos-build-menu)
