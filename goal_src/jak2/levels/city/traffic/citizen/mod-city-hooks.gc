;;-*-Lisp-*-
(in-package goal)

;; name: mod-city-hooks.gc
;; name in dgo: mod-city-hooks
;; dgos: CWI

;; ================================================================================================
;; Blue Crimson Guard mod -- "city mode" wiring manifest (CITY INSURRECTION variant).
;;
;; The shared traffic / guard engine files call the *mod-city-*-hook* function pointers declared
;; in engine/ai/traffic-h.gc. THIS file is the only place a branch legitimately differs: it
;; defines the two mode flags and points each hook var at a no-op / stock default OR, when City
;; Insurrection is toggled on, at a mod-city-insurrection.gc function.
;; ================================================================================================

;; Both flags exist on every branch so the debug-menu pick-funcs can always clear the other one.
(define *mod-city-peaceful?* #f)
(define *mod-city-insurrection?* #f)

;; hook implementations pulled from mod-city-insurrection.gc (registered before this file in game.gp)
(define-extern mod-city-insurrection-update-traffic (function traffic-manager none))
(define-extern mod-ins-guard-spawn-blue? (function traffic-object-spawn-params symbol))
(define-extern mod-ins-alert-blocked? (function symbol))
(define-extern mod-ins-blue-activated? (function crimson-blue-guard traffic-object-spawn-params symbol))
(define-extern mod-ins-guard-active-trans (function crimson-guard none))
(define-extern mod-ins-guard-search-trans (function crimson-guard symbol))
(define-extern mod-ins-keep-guard-target? (function process-focusable symbol))
(define-extern mod-ins-guard-activated? (function crimson-guard traffic-object-spawn-params symbol))
(define-extern mod-ins-guard-activate (function traffic-tracker traffic-type handle))

;; --- no-op / stock defaults ---------------------------------------------------------------------

(defun mod-city-hook-guard-spawn-blue? ((params traffic-object-spawn-params))
  "default *mod-city-guard-spawn-blue-hook*: stock -> no blue guards."
  #f
  )

(defun mod-city-hook-guard-activate ((this traffic-tracker) (ttype traffic-type))
  "default *mod-city-guard-activate-hook*: stock -- take the next inactive process of this type."
  (get-from-inactive-by-type this ttype)
  )

;; --- City Insurrection dispatch (flag-guarded so a toggle-off is exactly the stock behaviour) --
;; mod-city-insurrection-update-traffic already checks *mod-city-insurrection?* internally (and
;; owns the one-shot restore path when it turns off), so it is wired directly.

(defun mod-city-ins-guard-spawn-blue? ((params traffic-object-spawn-params))
  (if *mod-city-insurrection?*
      (mod-ins-guard-spawn-blue? params)
      #f
      )
  )

(defun mod-city-ins-guard-activate ((this traffic-tracker) (ttype traffic-type))
  (if *mod-city-insurrection?*
      (mod-ins-guard-activate this ttype)
      (mod-city-hook-guard-activate this ttype)
      )
  )

(defun mod-city-ins-alert-blocked? ()
  (and *mod-city-insurrection?* (mod-ins-alert-blocked?))
  )

(defun mod-city-ins-blue-activated? ((this crimson-blue-guard) (params traffic-object-spawn-params))
  (if *mod-city-insurrection?*
      (mod-ins-blue-activated? this params)
      #f
      )
  )

(defun mod-city-ins-guard-activated? ((this crimson-guard) (params traffic-object-spawn-params))
  (if *mod-city-insurrection?*
      (mod-ins-guard-activated? this params)
      #f
      )
  )

(defun mod-city-ins-guard-active-trans ((this crimson-guard))
  (when *mod-city-insurrection?*
    (mod-ins-guard-active-trans this)
    )
  (none)
  )

(defun mod-city-ins-guard-search-trans ((this crimson-guard))
  (and *mod-city-insurrection?* (mod-ins-guard-search-trans this))
  )

(defun mod-city-ins-keep-guard-target? ((p process-focusable))
  (and *mod-city-insurrection?* (mod-ins-keep-guard-target? p))
  )

;; --- install -----------------------------------------------------------------------------------

(define *mod-city-traffic-update-hook* mod-city-insurrection-update-traffic)
(define *mod-city-guard-spawn-blue-hook* (the-as (function object symbol) mod-city-ins-guard-spawn-blue?))
(define *mod-city-guard-activate-hook* (the-as (function object traffic-type handle) mod-city-ins-guard-activate))
(define *mod-city-alert-blocked-hook* mod-city-ins-alert-blocked?)
(define *mod-city-blue-activated-hook* (the-as (function crimson-blue-guard object symbol) mod-city-ins-blue-activated?))
(define *mod-city-guard-activated-hook* (the-as (function crimson-guard object symbol) mod-city-ins-guard-activated?))
(define *mod-city-guard-active-trans-hook* mod-city-ins-guard-active-trans)
(define *mod-city-guard-search-trans-hook* mod-city-ins-guard-search-trans)
(define *mod-city-keep-guard-target-hook* mod-city-ins-keep-guard-target?)
