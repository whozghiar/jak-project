    (:a 220.0)
    (:scalevel-x (meters 0.08))
    (:scalevel-y :copy scalevel-x)
    (:fade-r -2.0)
    (:fade-g -4.0)
    (:fade-b -2.0)
    (:fade-a -4.4)
    (:timer (seconds 0.167))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:func 'board-zap-track)
    )
  )

