;;-*-Lisp-*-
(in-package goal)

;; name: chaos-blast-bot.gc
;; name in dgo: chaos-blast-bot
;; dgos: LBOMBBOT
;;
;; MOD "Haven City : Chaos" -- anti-metal-head blast bot.
;; ================================================================================================
;; "Spawn (5%) de blast bot qui focus uniquement les metal heads."
;;
;; The Krimzon Guard blast bot already exists: it is the `bombbot` from the "Destroy the blast bots"
;; mission, a spline-following walker that sweeps the city and shells whatever it finds. Everything
;; about it -- its path following, its cannon, its shielding, its death -- is worth keeping. The one
;; thing that is wrong for this mod is *who it shoots*.
;;
;; `bombbot-method-181` is the target picker, and it does two things we have to undo:
;;   1. it only accepts processes carrying `process-mask vehicle` (it was written to hunt the
;;      vehicle Jak is driving), and
;;   2. whatever it found, it then overrides the choice with Jak if Jak is inside the search sphere.
;;
;; `chaos-blast-bot` overrides that single method with a metal-head-only version and inherits
;; literally everything else. Because it is a `bombbot` subclass, the mission's own bots are
;; untouched -- a stock playthrough never instantiates this type.
;; ================================================================================================

(deftype chaos-blast-bot (bombbot)
  ()
  )

(defmethod bombbot-method-181 ((this chaos-blast-bot) (arg0 vector))
  "Pick the nearest metal head inside the search sphere `arg0` (xyz = centre, w = radius), or drop
   the current focus if there is none.

   Kept deliberately close to the retail implementation so the downstream firing solution sees the
   same fields: `target-pos` is the lead point the cannon aims at, `start-target-pos` /
   `start-target-vel` are the snapshot the ballistics use, and `focus` is what the state machine
   tests. The retail version computes the lead point with a hand-vectorised
   `pos + vel * 0` -- a lead time of zero -- so a plain position copy is equivalent and clearer.

   Metal-head test: city metal heads are `citizen-enemy`s, which set `process-mask enemy`;
   Krimzon Guards explicitly clear `enemy` and set `guard`; citizens carry neither. The blast bot
   therefore never turns on its own side, and never on Jak."
  (let ((best (the-as process-focusable #f))
        (best-dist (the-as float #x7f800000))
        (candidates (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (countdown (i (fill-actor-list-for-sphere *actor-hash* (the-as sphere arg0) candidates 64))
      (let ((cshape (as-type (-> candidates i) collide-shape)))
        (when cshape
          (let ((proc (the-as process-focusable (as-type (-> cshape process) process-focusable))))
            (when (and proc
                       (!= this proc)
                       (logtest? (-> proc mask) (process-mask enemy))
                       (not (logtest? (-> proc mask) (process-mask guard)))
                       (not (logtest? (-> proc mask) (process-mask crate)))
                       (not (logtest? (-> proc focus-status) (focus-status disable dead ignore grabbed)))
                       )
              (let ((dist (vector-vector-xz-distance (-> this root trans) (-> proc root trans))))
                (when (< dist best-dist)
                  (set! best proc)
                  (set! best-dist dist)
                  )
                )
              )
            )
          )
        )
      )
    (cond
      (best
        (set! (-> this target-pos quad) (-> (get-trans best 3) quad))
        (set! (-> this start-target-pos quad) (-> best root trans quad))
        (set! (-> this start-target-vel quad) (-> best root transv quad))
        (try-update-focus (-> this focus) best this)
        )
      (else
        (clear-focused (-> this focus))
        )
      )
    )
  0
  (none)
  )

;; ================================================================================================
;; Dispatch
;; ------------------------------------------------------------------------------------------------
;; Lives here rather than in `chaos-city.gc` because everything below names `bombbot` types, and
;; `bombbot.o` is compiled as part of LBOMBBOT.DGO -- after CWI.DGO. `chaos-city.gc` therefore
;; calls in through the `*mod-chaos-blast-bot-hook*` function pointer, which this file installs on
;; load and which `chaos-city.gc` only follows while `lbombbot` reports active.
;; ================================================================================================

;; At most one blast bot patrols at a time -- they are large, loud and expensive.
(define *mod-chaos-blast-bot* (the-as handle #f))

;; Next frame we are allowed to roll for a blast bot.
(define *mod-chaos-blast-bot-next-roll* (the-as time-frame 0))

;; How often the 5% roll is made.
(defconstant MOD_CHAOS_BLAST_BOT_ROLL_PERIOD (seconds 20))

;; Nav mesh the retail "Destroy the blast bots" mission hands its bots. Same city mesh, so reusing
;; the actor id keeps our bot's pathing identical to the retail ones.
(defconstant MOD_CHAOS_BLAST_BOT_NAV_MESH_ID 9592)

(defun mod-chaos-blast-bot-update ()
  "Roll for, and on a hit dispatch, one anti-metal-head blast bot.

   The roll is made once every MOD_CHAOS_BLAST_BOT_ROLL_PERIOD rather than per frame, so
   MOD_CHAOS_BLAST_BOT_PERCENT reads as 'a 5% chance every 20 seconds' and not as an
   instantaneous certainty. Only one bot is ever alive: the handle test both enforces that
   and cleans up after one dies."
  (when (>= (current-time) *mod-chaos-blast-bot-next-roll*)
    (set! *mod-chaos-blast-bot-next-roll* (+ (current-time) MOD_CHAOS_BLAST_BOT_ROLL_PERIOD))
    (when (and (not (handle->process *mod-chaos-blast-bot*))
               *traffic-manager*
               (< (rand-vu-int-count 100) MOD_CHAOS_BLAST_BOT_PERCENT)
               )
      (let ((params (new 'stack 'bombbot-spawn-params))
            (path (case (rand-vu-int-count 5)
                    ((0) *bombbot-path-1*)
                    ((1) *bombbot-path-2*)
                    ((2) *bombbot-path-3*)
                    ((3) *bombbot-path-4*)
                    (else *bombbot-path-5*)
                    )
                  )
            )
        (set! (-> params nav-mesh) (get-nav-mesh (the-as actor-id MOD_CHAOS_BLAST_BOT_NAV_MESH_ID)))
        ;; `bombbot-init-by-other` immediately overwrites trans from the path's first node, so
        ;; this only has to be a valid vector, not a meaningful spawn point.
        (set! (-> params position quad) (-> path node 0 position quad))
        (quaternion-identity! (-> params quat))
        (set! (-> params path) path)
        ;; Parented to the traffic manager so the bot dies with Haven City rather than leaking
        ;; into the next level.
        (let ((proc (process-spawn chaos-blast-bot params :to *traffic-manager*)))
          (if proc
              (set! *mod-chaos-blast-bot* (ppointer->handle proc))
              )
          )
        )
      )
    )
  0
  (none)
  )

;; Installed on load; `mod-chaos-reset-hooks!` (called from `ctywide-deactivate`) puts the
;; always-resident no-op back.
(set! *mod-chaos-blast-bot-hook* mod-chaos-blast-bot-update)
