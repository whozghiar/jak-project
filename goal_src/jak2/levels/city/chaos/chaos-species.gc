;;-*-Lisp-*-
(in-package goal)

;; name: chaos-species.gc
;; name in dgo: chaos-species
;; dgos: CWI
;;
;; MOD "Haven City : Chaos" -- the extra metal-head species.
;; ================================================================================================
;; Retail Haven City knows exactly three metal heads: `metalhead-grunt`, `metalhead-flitter` and
;; `metalhead-predator`. They are not the standalone `grunt` / `flitter` / `predator` enemies --
;; they are `citizen-enemy` subclasses that reuse the *same art groups* ("skel-grunt" and friends)
;; but plug into the city traffic engine: they are pooled, recycled, walk the city nav-graph and
;; take part in the guard-vs-metal-head war.
;;
;; This file follows exactly that recipe for two species that never set foot in the city:
;;
;;   chaos-rapid-gunner  "Rapid gunner"   (levels/ruins/rapid-gunner.gc)
;;   chaos-spyder        "Spyder gunner"  (levels/common/enemy/spyder.gc)
;;
;; ------------------------------------------------------------------------------------------------
;; The design rule, and why this file is long
;; ------------------------------------------------------------------------------------------------
;; The brief is that these two must fight *exactly* as they do in their own missions -- stop to
;; shoot when they stop to shoot, play the animation they play, circle when they circle -- with one
;; single difference: the thing they are fighting is a Krimzon Guard or a civilian rather than Jak.
;;
;; That last part is already free. Targeting in the city is decided by `citizen-enemy-method-202`,
;; which picks the nearest valid process and calls `go-hostile`; `citizen-init!` sets the focus
;; collide-spec to `jak civilian player-list bot-targetable jak-vehicle`. Everything downstream of
;; `(-> self focus handle)` is target-agnostic. So "make them fight guards" needed no combat code at
;; all -- it needed the *collision* work in `chaos-cityify-collision!` below, and nothing else.
;;
;; What it does need is the combat states themselves, and those cannot be inherited. The retail
;; `attack` / `hop` / `reload` / `backup` states are written against `rapid-gunner` and `spyder`
;; *fields* -- `los`, `target-next-pos`, `fire-info`, `status-flags`, the IK joints -- at offsets
;; that only exist in those types. A `citizen-enemy` subclass has `citizen`'s ~200 bytes of traffic
;; plumbing sitting where those fields would be, so the state bodies cannot simply be pointed at.
;; Nor can the problem be turned around by inheriting from `rapid-gunner` instead: `citizen` is what
;; makes a process poolable, recyclable, nav-graph-walking and traffic-aware, and reimplementing
;; that would be an order of magnitude more work than reimplementing the combat.
;;
;; So the combat states are ported: each species redeclares the fields its retail states read, and
;; the state bodies are transcribed from the retail source. Where the decompiler emitted `b!` /
;; `label` control flow, it is rewritten as the `cond` it came from; everything else is verbatim,
;; including the tuning numbers, so that a future reader can diff against the retail file.
;;
;; An earlier version of this file did *not* do that. It gave both species a generic charge with a
;; melee timer and a shot fired on a fixed cadence while running. It worked, and it was wrong: both
;; of these are stand-and-shoot enemies that do not close, and both have scripted damage windows
;; opened and closed by their animations. Hence this rewrite.
;;
;; What is deliberately *not* ported, and why:
;;   - the gunner's `spinup-angle` res-lump read and the spyder's `predator-effect?` cloak. Both
;;     read the actor's `entity`, and a traffic-spawned process has none. City spyders are always
;;     uncloaked, which is also the retail behaviour for any spyder without an `extra-id` res tag.
;;   - `notice`. City metal heads are pushed straight into `hostile` by `citizen-enemy-method-202`;
;;     they have no idle patrol to be noticed out of.
;;   - the knockback and death paths (`enemy-method-77` / `-78`, the retail `hit` event handling).
;;     `citizen-enemy` owns damage-to-death-to-recycle and the three retail city species all go
;;     through it. Combat is what had to match the mission; dying and being pooled is city business.
;; ================================================================================================

;; ------------------------------------------------------------------------------------------------
;; Shared base
;; ------------------------------------------------------------------------------------------------

(deftype chaos-metalhead (citizen-enemy)
  (;; Line-of-sight tracker. Both species gate their attack on it in retail -- neither will open
   ;; fire through a wall, and the gunner uses it to decide when to break off and hop -- and it is
   ;; the one field they genuinely share, so it lives in the base.
   (los  los-control  :inline)
   )
  (:methods
    ;; Name of the skeleton group to wear, e.g. "skel-rapid-gunner". Resolved through
    ;; `art-group-get-by-name`, so the matching `<x>-ag.go` must be in a resident DGO
    ;; (the mod puts them in LWIDEB.DGO -- see goal_src/jak2/dgos/lwideb.gd).
    (chaos-skel-name (_type_) string)
    ;; Animation index for the base `hostile` fallback below. Falls back to the walk animation for
    ;; species that ship with `run-anim -1`.
    (chaos-chase-anim (_type_) int)
    ;; The `nav-enemy-info` this species is tuned by. NOT inherited from anywhere: `metalhead-grunt`
    ;; declares `get-nav-info` in its own `:methods` block rather than `nav-enemy` or `enemy`
    ;; providing it, so the chaos hierarchy has to declare its own slot for it.
    (get-nav-info (_type_) nav-enemy-info)
    )
  )

(defmethod chaos-skel-name ((this chaos-metalhead))
  "Subclasses must override; the base name would fail the art lookup on purpose."
  "skel-chaos-metalhead-unset"
  )

(defmethod chaos-chase-anim ((this chaos-metalhead))
  "Pick the chase animation, tolerating species that have no dedicated run cycle."
  (let ((run (-> this enemy-info run-anim)))
    (if (>= run 0)
        run
        (-> this enemy-info walk-anim)
        )
    )
  )

(defmethod get-nav-info ((this chaos-metalhead))
  "Base implementation. `chaos-metalhead` is abstract -- only the species below are ever spawned,
   and each overrides this -- but the slot needs a body, and it has to be a body that cannot crash
   `init-enemy-behaviour-and-stats!` if the hierarchy is ever extended carelessly. The city grunt's
   tuning is the closest thing to a neutral default."
  *metalhead-grunt-nav-enemy-info*
  )

(defmethod init-enemy! ((this chaos-metalhead))
  "Common city-enemy bring-up: wear the retail skeleton, adopt the retail tuning, then apply the
   few city-specific overrides the retail city metal heads also apply (neck aim envelope, a nav
   speed scale of 1, no water animation, no minimap icon before `citizen-init!` adds one).

   Species-specific setup -- joints, IK, sound, gravity -- happens in the subclass override, which
   calls this first."
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* (chaos-skel-name this) (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (init-enemy-behaviour-and-stats! this (get-nav-info this))
  ;; `citizen::init-enemy-behaviour-and-stats!` writes `*default-nav-mesh*` into the
  ;; `nav-enemy-info` it is handed -- traffic-spawned actors have no entity to resolve a mesh from,
  ;; so the city forces one. For the retail city Metal Heads that is harmless: each owns its own
  ;; static. Our species share theirs with the arena originals, so the write has to be undone or a
  ;; Ruins gunner would afterwards path on the city's dummy mesh. `#f` is the shipped
  ;; value for every `nav-enemy-info` involved, so this restores rather than approximates.
  (set! (-> (get-nav-info this) nav-mesh) #f)
  (let ((neck (-> this neck)))
    (set! (-> neck up) (the-as uint 1))
    (set! (-> neck nose) (the-as uint 2))
    (set! (-> neck ear) (the-as uint 0))
    ;; Same envelope both retail species use: +/- 65 degrees of head turn, give up past ~170.
    (set-vector! (-> neck twist-max) 11832.889 11832.889 0.0 1.0)
    (set! (-> neck ignore-angle) 30947.555)
    )
  (let ((nav (-> this nav)))
    (set! (-> nav speed-scale) 1.0)
    )
  (set! (-> this water-anim) -1)
  (set! (-> this minimap) #f)
  ;; Same source parameters both retail species use: re-probe five times a second, blocked by
  ;; world geometry and obstacles only.
  (new-source! (-> this los) this (seconds 0.2) (collide-spec backgnd obstacle))
  0
  (none)
  )

(defmethod enemy-method-63 ((this chaos-metalhead) (arg0 process-focusable) (arg1 enemy-aware))
  "Keep the line-of-sight tracker pointed at whatever we just became aware of.

   Verbatim from `rapid-gunner::enemy-method-63` / `spyder::enemy-method-63`, which are identical
   to each other. Without it `los` never gets a destination, `check-los?` is permanently false, and
   neither species would ever open fire."
  (let ((t9-0 (method-of-type nav-enemy enemy-method-63)))
    (the-as symbol (if (t9-0 this arg0 arg1)
                       (set-dst-proc! (-> this los) (-> this focus handle))
                       )
            )
    )
  )

(defmethod common-post ((this chaos-metalhead))
  "`citizen-enemy::common-post` with exactly one thing changed: the overlap filter.

   This is half the fix for 'the new species and the Krimzon Guard stand chest to chest and neither
   can hurt the other'. Damage between two `enemy`s is touch-driven: `common-post` calls
   `find-overlapping-shapes`, which fills `*touching-list*` and makes both sides receive a `touch`
   event; `enemy-method-75` then turns a touch involving a `deadly` primitive into an `attack`.
   Which shapes are even considered comes from `enemy-info.overlaps-others-collide-with-filter`,
   and the two values differ by exactly the bits that matter here:

     metalhead-grunt / flitter / predator : jak civilian enemy vehicle-sphere hit-by-others-list
                                            player-list
     rapid-gunner / spyder (arena enemies): jak bot player-list

   `civilian` is what Krimzon Guards and citizens register as and `vehicle-sphere` is what city
   traffic registers as, so with the arena filter a Rapid gunner in Haven City can only ever touch
   Jak.

   Patching `enemy-info` itself is not an option: `*rapid-gunner-nav-enemy-info*` is a shared static
   that the Ruins gunners read too. Overriding here costs nothing and leaves the retail enemies
   alone.
   The other half of the fix is `chaos-cityify-collision!` -- see its comment."
  (let ((params (new 'stack-no-clear 'overlaps-others-params)))
    (set! (-> params options) (overlaps-others-options))
    (set! (-> params collide-with-filter)
          (collide-spec jak civilian enemy vehicle-sphere hit-by-others-list player-list)
          )
    (set! (-> params tlist) *touching-list*)
    (find-overlapping-shapes (-> this root) params)
    )
  ;; Unchanged from `citizen-enemy::common-post`: re-pick a focus every 0.2s while idle, and
  ;; keep the traffic danger sphere alive so vehicles swerve around us.
  (when (and (not (focus-test? this disable dead ignore inactive))
             (< (-> this next-update-target) (current-time))
             (not (logtest? (enemy-flag lock-focus) (-> this enemy-flags)))
             (-> this next-state)
             (= (-> this next-state name) 'active)
             )
    (citizen-enemy-method-202 this)
    (set! (-> this next-update-target) (+ (current-time) (seconds 0.2)))
    (traffic-danger-init! this)
    )
  ((method-of-type citizen common-post) this)
  (none)
  )

;; Fallback chase for a species that has not ported its retail combat states.
;;
;; Both shipped species override this, so nothing reaches it today. It is kept because
;; `nav-enemy::hostile` has no `:code` of its own -- an unported subclass inheriting it would keep
;; playing the walk animation from `active` while travelling at run speed, which looks broken in a
;; way that is hard to trace back to a missing override.
(defstate hostile (chaos-metalhead)
  :virtual #t
  :event enemy-event-handler
  :trans (behavior ()
    (let ((parent-trans (-> (method-of-type citizen-enemy hostile) trans)))
      (if parent-trans
          (parent-trans)
          )
      )
    )
  :code (behavior ()
    (let ((chase (-> self draw art-group data (chaos-chase-anim self)))
          (rate (rnd-float-range self 0.9 1.1))
          )
      (let ((playing (ja-group)))
        (if (not (and playing (= playing chase)))
            (ja-channel-push! 1 (seconds 0.15))
            )
        )
      (until #f
        (ja-no-eval :group! chase :num! (seek! max rate) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max rate))
          )
        )
      )
    #f
    )
  :post nav-enemy-chase-post
  )

;; ------------------------------------------------------------------------------------------------
;; Shared helpers
;; ------------------------------------------------------------------------------------------------

(defun chaos-cityify-collision! ((this nav-enemy))
  "Take a collide-shape built by a retail enemy's `init-enemy-collision!` and make it a citizen of
   Haven City: add `civilian` and `enemy` to the collide-with of the root primitive **and of every
   child primitive**.

   The children are the whole point, and getting that wrong is what made the first two builds ship
   extra species that walked *through* Krimzon Guards, took no damage from them and dealt none.

   A collide-shape's root primitive is a `collide-shape-prim-group` -- a bounding sphere used to
   reject the whole actor cheaply. The primitives that actually collide, and that carry the
   `deadly` action a melee hit is tested against, are its children. `find-overlapping-shapes` pairs
   two primitives only when one's `collide-as` appears in the other's `collide-with`
   (intersected with `overlaps-others-collide-with-filter`), so a child that does not list
   `civilian` can never produce a touching entry against a guard -- and a guard is `civilian`.

   Compare the retail city grunt with the arena species, child by child:

     metalhead-grunt children : ... jak civilian hit-by-others-list player-list ...
     rapid-gunner children    : ... jak bot player-list ...

   Widening only the group changes nothing: the group never pairs, so neither the guard's rifle
   butt nor the species' body primitives could ever be part of a touching entry, and the solid
   reaction that keeps two actors apart never fired either.

   What this deliberately does *not* do is force `deadly` onto the children. An earlier version did,
   to give a species contact damage it was not supposed to have. Both species here open their own
   damage window from inside an animation -- the gunner grows and arms child primitive 1 for the
   duration of `spin-attack`, the spyder ships four permanently `deadly` children -- so forcing it
   on would make them lethal to brush past, which neither is in its own level.

   `backup-collide-as` / `backup-collide-with` must be refreshed afterwards because `citizen-init!`
   restores the root primitive from them every time the traffic engine recycles the process. The
   children are not restored, so the widening above survives recycling on its own."
  (let* ((cshape (-> this root))
         (root-prim (-> cshape root-prim))
         (group (the-as collide-shape-prim-group root-prim))
         )
    (logior! (-> root-prim prim-core collide-with) (collide-spec civilian enemy))
    (dotimes (i (the int (-> group num-children)))
      (logior! (-> group child i prim-core collide-with) (collide-spec civilian enemy))
      )
    (set! (-> cshape backup-collide-as) (-> root-prim prim-core collide-as))
    (set! (-> cshape backup-collide-with) (-> root-prim prim-core collide-with))
    ;; City metal heads run at event-priority 8 so a guard's shot beats an ambient bump.
    (set! (-> cshape event-priority) (the-as uint 8))
    )
  0
  (none)
  )

(defun chaos-art-ready? ((skel-name string))
  "#t when the skeleton group is resident, i.e. its `-ag.go` made it into a loaded DGO.
   Checked before spawning so a missing art group degrades into 'this species does not appear'
   instead of a `process-drawable-art-error` crash.

   Written as an `if` rather than `(and ... #t)` on purpose: `and` types as the union of its
   operands, i.e. `object`, which will not go into a `symbol` global."
  (if (art-group-get-by-name *level* skel-name (the-as (pointer uint32) #f))
      #t
      #f
      )
  )

;; ------------------------------------------------------------------------------------------------
;; chaos-rapid-gunner -- "Rapid gunner"  (10%)
;;
;; Retail combat loop, ported from levels/ruins/rapid-gunner.gc. Unlike the other four species this
;; one is an *emplacement*: in its own levels it never chases. It plants itself, tracks with its
;; gun arm, spins up, and walks a stream of shots onto the target; when pressed it hops sideways
;; rather than closing. All of that is preserved here. The only city-side concession is that it
;; still patrols like any other pedestrian while it has no focus, via `citizen-enemy`'s `active` --
;; a metal head that stood motionless on a street corner until something walked past would read as
;; a bug, and the retail `active` is a pure idle loop because a ruins gunner is placed by hand.
;;
;;   hostile     -- stand and aim. Its `:trans` is the decision table: inside 5 m and roughly level
;;                  -> `spin-attack`; inside 100 m with line of sight -> `attack`, or `reload`
;;                  first if the drum is empty; no line of sight for 25 s -> `hop` back toward
;;                  where the fight started; focus lost -> back to `active`.
;;   attack      -- STOP and fire. One shot every 0.25 s while the gun is within ~12 degrees of
;;                  the predicted aim point, from the `blast` joint, with a spin-up cone that
;;                  tightens over the first two seconds. Twelve shots, then `reload`. Breaks to
;;                  `spin-attack` if the target closes to 5 m, `hop` if it loses sight, `hop-turn`
;;                  if the target gets behind it, `hostile` if it runs past 105 m.
;;   spin-attack -- the melee: child primitive 1 is enlarged and made `deadly` for the duration of
;;                  one spin animation, then restored. This is the only time a rapid gunner deals
;;                  contact damage.
;;   hop-turn    -- turn in place with the turn animation until the target is back in the arc.
;;   hop         -- a two-channel hop along `hop-dir`, blended from directional idle animations,
;;                  clamped to the nav mesh. Costs two rounds of the drum.
;;   reload      -- play the reload animation at half speed, then hop if still exposed.
;;   cool-down   -- half a second of aim animation, drum reset. (Reachable from the retail
;;                  knocked/hit paths.)
;;
;; The aim prediction is the part that makes it feel like the mission enemy: `chaos-rgun-track-post`
;; keeps `target-next-pos` one lead-time ahead of the focus, scaled by range, and the gun joint
;; slerps toward that rather than the target's current position. Everything downstream --
;; `enemy-method-96`, the firing cone test, the joint aim -- reads `target-next-pos`, not the focus.
;; ------------------------------------------------------------------------------------------------

(deftype chaos-rapid-gunner (chaos-metalhead)
  ((joint             joint-mod)
   (joint-blend       float)
   (joint-enable      symbol)
   (shot-timer        uint64)
   (predict-timer     uint64)
   (target-prev-pos   vector              :inline)
   (target-next-pos   vector              :inline)
   (focus-dir         vector              :inline)
   (shots-fired       uint32)
   (spin-up-timer     time-frame)
   (shoot-anim-index  int32)
   (status-flags      rapid-gunner-flags)
   (start-pos         vector              :inline)
   (dest-pos          vector              :inline)
   (hop-dir           vector              :inline)
   )
  (:state-methods
    attack
    spin-attack
    hop
    hop-turn
    cool-down
    reload
    )
  (:methods
    (chaos-rgun-aim! (_type_ vector float) none)
    (chaos-rgun-facing? (_type_ float) symbol)
    (chaos-rgun-blend! (_type_ int float int int) none)
    )
  )

(defmethod chaos-skel-name ((this chaos-rapid-gunner))
  "Skeleton group worn by the Rapid gunner. A method body that is nothing but a string would be
   read as a docstring, hence this one."
  "skel-rapid-gunner"
  )

(defmethod get-nav-info ((this chaos-rapid-gunner))
  "Reuse the Ruins gunner's tuning verbatim. Read-only -- the Ruins and Haven Forest gunners share
   this object."
  *rapid-gunner-nav-enemy-info*
  )

(defmethod chaos-rgun-aim! ((this chaos-rapid-gunner) (aim-at vector) (rate float))
  "Slerp the gun arm toward `aim-at`, clamped to +/- 15 degrees of pitch and 90 degrees of yaw off
   the arm's rest direction. Verbatim `rapid-gunner-method-185`.

   The clamp at 29491.2 (7.2 m) pushes an aim point that is too close back out along the same
   bearing: the arm cannot converge on something inside its own turning circle, and without this a
   target that walks into contact range makes the gun swing wildly."
  (if (not (-> this joint-enable))
      (return #f)
      )
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (set! (-> s5-0 quad) (-> aim-at quad))
    (let ((s4-0 (new 'stack-no-clear 'vector)))
      (set! (-> s4-0 quad) (-> this root root-prim prim-core world-sphere quad))
      (let ((s3-1 (vector-! (new 'stack-no-clear 'vector) s5-0 s4-0)))
        (set! (-> s4-0 w) 1.0)
        (when (< (vector-vector-distance s5-0 s4-0) 29491.2)
          (vector-normalize! s3-1 29491.2)
          (vector+! s5-0 s4-0 s3-1)
          )
        )
      )
    (let* ((v1-16 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 18)))
           (s4-1 (vector-normalize! (vector-! (new 'stack-no-clear 'vector) s5-0 v1-16) 1.0))
           (s3-2
             (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this node-list data 4 bone transform vector 2) 1.0)
             )
           (s5-1 (new 'stack-no-clear 'quaternion))
           )
      (let* ((s1-0 (forward-up-nopitch->quaternion (new 'stack-no-clear 'quaternion) s4-1 *up-vector*))
             (s2-0 (vector-inv-orient-by-quat! (new 'stack-no-clear 'vector) s4-1 s1-0))
             (f0-2 (vector-x-angle s2-0))
             )
        (when (< 2730.6667 (fabs f0-2))
          (let ((f30-0 (fmax -2730.6667 (fmin 2730.6667 f0-2))))
            (set! (-> s2-0 y) 0.0)
            (vector-normalize! s2-0 1.0)
            (vector-rotate-x! s2-0 s2-0 (- f30-0))
            )
          (vector-orient-by-quat! s4-1 s2-0 s1-0)
          )
        )
      (quaternion-from-two-vectors-max-angle-partial! s5-1 s3-2 s4-1 16384.0 (-> this joint-blend))
      (quaternion-slerp! (-> this joint quat) (-> this joint quat) s5-1 0.1)
      )
    )
  0
  (none)
  )

(defmethod chaos-rgun-facing? ((this chaos-rapid-gunner) (arc float))
  "Is the gun arm pointing within `arc` of the predicted aim point, in the XZ plane?
   Verbatim `rapid-gunner-method-184`. This is the firing gate -- the gunner will not squeeze the
   trigger until the barrel has caught up."
  (let* ((s4-0 (-> this node-list data 18))
         (v1-1 (vector<-cspace! (new 'stack-no-clear 'vector) s4-0))
         (s5-1 (vector-normalize! (vector-! (new 'stack-no-clear 'vector) (-> this target-next-pos) v1-1) 1.0))
         (s4-1 (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> s4-0 bone transform vector 2) 1.0))
         )
    (set! (-> s4-1 y) 0.0)
    (vector-xz-normalize! s4-1 1.0)
    (set! (-> s5-1 y) 0.0)
    (vector-xz-normalize! s5-1 1.0)
    (>= (vector-dot s4-1 s5-1) (cos arc))
    )
  )

(defmethod chaos-rgun-blend! ((this chaos-rapid-gunner) (chan int) (amount float) (pos-anim int) (neg-anim int))
  "Drive one animation channel from a signed amount: pick `pos-anim` or `neg-anim` by sign and set
   the channel's blend to the magnitude. Verbatim `rapid-gunner-method-186`; it is what makes the
   hop lean into whichever direction it is travelling."
  (local-vars (v1-1 int))
  0
  (if (< 0.0 amount)
      (set! v1-1 pos-anim)
      (set! v1-1 neg-anim)
      )
  (let ((a1-2 (-> this skel root-channel chan)))
    (let ((f0-2 (fabs amount)))
      (set! (-> a1-2 frame-interp 1) f0-2)
      (set! (-> a1-2 frame-interp 0) f0-2)
      )
    (set! (-> a1-2 frame-group) (the-as art-joint-anim (-> this draw art-group data v1-1)))
    )
  (none)
  )

(defmethod enemy-method-96 ((this chaos-rapid-gunner) (arg0 float) (arg1 symbol))
  "Aim tests go against the *predicted* point, not the focus. Verbatim override."
  (enemy-method-95 this (-> this target-next-pos) arg0)
  )

(defmethod common-post ((this chaos-rapid-gunner))
  "Base city post plus the line-of-sight refresh the retail gunner does every frame."
  ((method-of-type chaos-metalhead common-post) this)
  (los-control-method-9 (-> this los) (the-as process-focusable #f) (the-as vector #f) 2048.0)
  0
  (none)
  )

(defmethod general-event-handler ((this chaos-rapid-gunner) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "The retail gunner's hit-confirmation sound, everything else to the city handler.

   Retail also intercepts `hit` / `hit-flinch` to force its own `knocked`. That is deliberately
   *not* ported: `citizen-enemy` owns the damage-to-death-to-recycle path that makes a process a
   traffic actor, and the other four species all go through it. Combat is what had to match the
   mission; dying and being pooled is city business."
  (case arg2
    (('notify)
     (if (= (-> arg3 param 0) 'attack)
         (sound-play "rgun-shot-hit")
         )
     ((method-of-type citizen-enemy general-event-handler) this arg0 arg1 arg2 arg3)
     )
    (else
      ((method-of-type citizen-enemy general-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defun vector-average-copy-chaos! ((dst vector) (src vector) (amount float))
  "Exponential average of `dst` toward `src`. Retail spells this `vector-average-copy!` in
   rapid-gunner.gc; renamed here only to avoid defining the same global twice when both files are
   in the image."
  (let ((f0-1 (- 1.0 amount)))
    (set! (-> dst x) (+ (* f0-1 (-> dst x)) (* amount (-> src x))))
    (set! (-> dst y) (+ (* f0-1 (-> dst y)) (* amount (-> src y))))
    (set! (-> dst z) (+ (* f0-1 (-> dst z)) (* amount (-> src z))))
    )
  (set! (-> dst w) 1.0)
  dst
  )

(defbehavior chaos-rgun-track-post chaos-rapid-gunner ()
  "Keep `target-next-pos` one lead ahead of the focus. Verbatim `rapid-gunner-common-post`.

   The lead is the focus's per-frame displacement scaled by range (0.00028170072 is roughly
   'one frame of travel per 3.5 m of distance'), smoothed at 8 % per frame and flattened to the
   horizontal. Every aim test in this species reads the result rather than the focus itself, which
   is why its stream lands *in front of* a running Krimzon Guard instead of trailing it."
  (let ((a0-1 (handle->process (-> self focus handle))))
    (cond
      (a0-1
        (let ((gp-0 (new 'stack-no-clear 'vector)))
          (set! (-> gp-0 quad) (-> (get-trans (the-as process-focusable a0-1) 0) quad))
          (let ((s5-1 (vector-! (new 'stack-no-clear 'vector) gp-0 (-> self target-prev-pos))))
            (let* ((a1-3 (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node rapid-gunner-lod0-jg blast)))
                   (f0-0 (vector-vector-distance gp-0 a1-3))
                   )
              (vector-normalize! s5-1 (* 0.00028170072 f0-0 (vector-length s5-1)))
              )
            (set! (-> s5-1 y) 0.0)
            (vector-average-copy-chaos! (-> self focus-dir) s5-1 0.08)
            )
          (vector+! (-> self target-next-pos) (-> self focus-dir) gp-0)
          (set! (-> self target-prev-pos quad) (-> gp-0 quad))
          )
        (set! (-> self predict-timer) (the-as uint (current-time)))
        )
      (else
        (set! (-> self target-next-pos quad) (-> self target-prev-pos quad))
        (vector-reset! (-> self focus-dir))
        )
      )
    )
  0
  (none)
  )

;; Verbatim port of `rapid-gunner::hostile`. The gunner does not navigate here -- `nav callback-info`
;; is nulled and the post only faces the focus. Every transition out of the fight lives in `:trans`.
;;
;; One city adaptation: `start-pos` is refreshed on entry. Retail sets it once in `init-enemy!` from
;; the entity's placement, which is the spot the gunner falls back to when it loses sight of its
;; target. A traffic actor is recycled all over the map, so its fallback has to be wherever this
;; particular fight started rather than wherever the pooled process happened to be built.
(defstate hostile (chaos-rapid-gunner)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (let ((t9-0 (-> (method-of-type nav-enemy hostile) enter)))
      (if t9-0
          (t9-0)
          )
      )
    (set! (-> self start-pos quad) (-> self root trans quad))
    (set! (-> self predict-timer) (the-as uint (current-time)))
    (cond
      ((handle->process (-> self focus handle))
       (if (check-los? (-> self los) 0)
           (logclear! (-> self status-flags) (rapid-gunner-flags ragflags-1))
           (logior! (-> self status-flags) (rapid-gunner-flags ragflags-1))
           )
       )
      (else
        (logior! (-> self status-flags) (rapid-gunner-flags ragflags-1))
        )
      )
    (let ((v1-18 self))
      (set! (-> v1-18 enemy-flags) (the-as enemy-flag (logclear (-> v1-18 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-18 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (let ((gp-0 (handle->process (-> self focus handle))))
      (when gp-0
        (let* ((s5-0 (get-trans (the-as process-focusable gp-0) 0))
               (f30-0 (vector-vector-distance s5-0 (-> self root trans)))
               )
          ;; Inside 5 m and roughly level: melee.
          (if (and (< f30-0 20480.0)
                   (and (< (fabs (- (-> s5-0 y) (-> self root trans y))) 6144.0)
                        gp-0
                        (not (logtest? (-> (the-as process-focusable gp-0) focus-status) (focus-status disable dead ignore grabbed)))
                        )
                   )
              (go-virtual spin-attack)
              )
          ;; Inside 100 m with a clear line: open fire, reloading first if the drum is dry.
          (when (and (< f30-0 409600.0) (check-los? (-> self los) 0))
            (if (>= (-> self shots-fired) (the-as uint 12))
                (go-virtual reload)
                )
            (go-virtual attack)
            )
          )
        )
      )
    ;; No line of sight for 25 s: hop back toward where this fight started.
    (when (skip-check-los? (-> self los) 1500)
      (let ((a1-6 (vector-! (new 'stack-no-clear 'vector) (-> self start-pos) (-> self root trans))))
        (when (< 4096.0 (vector-length a1-6))
          (vector-normalize-copy! (-> self hop-dir) a1-6 1.0)
          (go-virtual hop)
          )
        )
      )
    (when (time-elapsed? (-> self state-time) (seconds 0.1))
      (if (>= 1 (the-as int (-> self focus aware)))
          (go-virtual active)
          )
      )
    )
  :code (behavior ()
    (when (not (chaos-rgun-facing? self 2730.6667))
      (let ((v1-3 self))
        (set! (-> v1-3 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag37) (-> v1-3 enemy-flags))))
        )
      0
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! rapid-gunner-shoot-track-ja)
      (ja :num-func num-func-identity :frame-num 0.0)
      (until (chaos-rgun-facing? self 910.2222)
        (ja-blend-eval)
        (suspend)
        (ja :num! (loop! 0.75))
        )
      (let ((v1-19 self))
        (set! (-> v1-19 enemy-flags) (the-as enemy-flag (logclear (-> v1-19 enemy-flags) (enemy-flag enemy-flag37))))
        )
      0
      )
    (let ((v1-23 (ja-group)))
      (when (not (and v1-23 (= v1-23 rapid-gunner-aim-ja)))
        (let ((v1-29 (ja-group)))
          (if (and v1-29 (= v1-29 rapid-gunner-shoot-track-ja))
              (ja-channel-push! 1 (seconds 0.067))
              (ja-channel-push! 1 (seconds 0.2))
              )
          )
        )
      )
    (let ((f30-0 (rnd-float-range self 0.9 1.1)))
      (until #f
        (ja-no-eval :group! rapid-gunner-aim-ja :num! (seek! max f30-0) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max f30-0))
          )
        )
      )
    #f
    )
  :post (behavior ()
    (chaos-rgun-aim! self (-> self target-next-pos) 3.6)
    (chaos-rgun-track-post)
    (nav-enemy-face-focus-post)
    )
  )

;; Verbatim port of `rapid-gunner::attack`. The firing itself is in `:trans`, not `:code`: the
;; animation loop and the trigger run on independent clocks in retail, which is what lets the
;; barrel keep tracking between bursts.
(defstate attack (chaos-rapid-gunner)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self predict-timer) (the-as uint (+ (current-time) 1)))
    (set! (-> self shot-timer) (the-as uint (current-time)))
    (let ((v1-7 self))
      (set! (-> v1-7 enemy-flags) (the-as enemy-flag (logclear (-> v1-7 enemy-flags) (enemy-flag enemy-flag36))))
      (set! (-> v1-7 nav callback-info) *nav-enemy-null-callback-info*)
      )
    0
    (let ((v1-10 self))
      (set! (-> v1-10 enemy-flags) (the-as enemy-flag (logclear (-> v1-10 enemy-flags) (enemy-flag enemy-flag37))))
      )
    0
    (set! (-> self joint-enable) #t)
    (logior! (-> self focus-status) (focus-status dangerous))
    (let* ((v1-15 *game-info*)
           (a0-6 (+ (-> v1-15 attack-id) 1))
           )
      (set! (-> v1-15 attack-id) a0-6)
      (set! (-> self attack-id) a0-6)
      )
    ;; Cold barrel: the first two seconds of fire are scattered by the spin-up cone below.
    (when (logtest? (-> self status-flags) (rapid-gunner-flags ragflags-1))
      (set! (-> self spin-up-timer) (+ (current-time) (seconds 2)))
      (logclear! (-> self status-flags) (rapid-gunner-flags ragflags-1))
      )
    (if (zero? (rand-vu-int-range 0 3))
        (set! (-> self shoot-anim-index) 15)
        (set! (-> self shoot-anim-index) 14)
        )
    )
  :exit (behavior ()
    (if (logtest? (-> self enemy-flags) (enemy-flag dangerous-backup))
        (logior! (-> self focus-status) (focus-status dangerous))
        (logclear! (-> self focus-status) (focus-status dangerous))
        )
    )
  :trans (behavior ()
    (seek! (-> self joint-blend) 0.95 (seconds-per-frame))
    (let ((gp-0 (handle->process (-> self focus handle))))
      (if (not gp-0)
          (go-virtual hostile)
          )
      (let ((s5-0 (get-trans (the-as process-focusable gp-0) 0))
            (f0-3 (vector-vector-distance (get-trans (the-as process-focusable gp-0) 0) (-> self root trans)))
            )
        (cond
          ((and (< f0-3 20480.0)
                (and (< (fabs (- (-> s5-0 y) (-> self root trans y))) 6144.0)
                     gp-0
                     (not (logtest? (-> (the-as process-focusable gp-0) focus-status) (focus-status disable dead ignore grabbed)))
                     )
                )
           (go-virtual spin-attack)
           )
          ((< 430080.0 f0-3)
           (go-hostile self)
           )
          ((skip-check-los? (-> self los) 90)
           (vector-normalize-copy! (-> self hop-dir) (-> self focus-dir) -1.0)
           (go-virtual hop)
           )
          ((not (chaos-rgun-facing? self 16384.0))
           (go-virtual hop-turn)
           )
          ((>= (-> self shots-fired) (the-as uint 12))
           (when (skip-check-los? (-> self los) 0)
             (vector-normalize-copy! (-> self hop-dir) (-> self focus-dir) -1.0)
             (go-virtual hop)
             )
           (go-virtual reload)
           )
          ((time-elapsed? (the-as int (-> self shot-timer)) (seconds 0.25))
           ;; One round, but only once the barrel has caught up to within ~12 degrees.
           (when (chaos-rgun-facing? self 2184.5334)
             (let* ((a1-11 (joint-node rapid-gunner-lod0-jg blast))
                    (f30-0 (fmax 0.0 (the float (- (-> self spin-up-timer) (current-time)))))
                    (s5-1 (vector<-cspace! (new 'stack-no-clear 'vector) a1-11))
                    (s4-2
                      (vector+! (new 'stack-no-clear 'vector) (get-trans (the-as process-focusable gp-0) 0) (-> self focus-dir))
                      )
                    )
               ;; Aim higher at a stationary target than at a sprinting one.
               (+! (-> s4-2 y) (lerp 2457.6 819.2 (* 0.000048828126 (vector-length (-> self focus-dir)))))
               ;; Spin-up scatter: pitch the round up by an angle that decays to zero over the
               ;; two seconds after the barrel starts turning.
               (let* ((gp-2 (vector-! (new 'stack-no-clear 'vector) s4-2 s5-1))
                      (f28-1 (vector-length gp-2))
                      )
                 (vector-normalize! gp-2 1.0)
                 (vector-rotate-x! gp-2 gp-2 (* 0.9102223 f30-0))
                 (vector+float*! s4-2 s5-1 gp-2 f28-1)
                 )
               (sound-play "rgun-shot-fire" :position s5-1)
               ;; `spawn-metalhead-projectile` only reads `entity` and the process handle off its
               ;; first argument, so the cast is safe and the shot is a plain `metalhead-shot` --
               ;; the same projectile the retail city grunt fires, already carrying `civilian` and
               ;; `enemy` in its collide-with.
               (spawn-metalhead-projectile (the-as metalhead-shot self) s5-1 s4-2 532480.0)
               )
             (+! (-> self shots-fired) 1)
             )
           (set! (-> self shot-timer) (the-as uint (current-time)))
           )
          )
        )
      )
    )
  :code (behavior ()
    (until #f
      (when (not (chaos-rgun-facing? self 2730.6667))
        (let ((v1-3 self))
          (set! (-> v1-3 enemy-flags) (the-as enemy-flag (logior (enemy-flag enemy-flag37) (-> v1-3 enemy-flags))))
          )
        0
        (ja-channel-push! 1 (seconds 0.2))
        (ja :group! rapid-gunner-shoot-track-ja)
        (ja :num-func num-func-identity :frame-num 0.0)
        (until (chaos-rgun-facing? self 910.2222)
          (ja-blend-eval)
          (suspend)
          (ja :num! (loop! 0.75))
          )
        (let ((v1-19 self))
          (set! (-> v1-19 enemy-flags) (the-as enemy-flag (logclear (-> v1-19 enemy-flags) (enemy-flag enemy-flag37))))
          )
        0
        )
      (let ((v1-23 (ja-group)))
        (if (not (and v1-23 (or (= v1-23 rapid-gunner-shoot-ja) (= v1-23 rapid-gunner-shoot1-ja))))
            (ja-channel-push! 1 (seconds 0.2))
            )
        )
      (ja-no-eval :group! (-> self draw art-group data (-> self shoot-anim-index)) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (chaos-rgun-aim! self (-> self target-next-pos) 4.0)
    (let ((a0-2 (handle->process (-> self focus handle))))
      (if (and a0-2 (let ((a1-2 self))
                      (logtest? (enemy-flag enemy-flag37) (-> a1-2 enemy-flags))
                      )
               )
          (seek-to-point-toward-point!
            (-> self root)
            (get-trans (the-as process-focusable a0-2) 3)
            (/ (-> self nav max-rotation-rate) 2)
            (seconds 0.5)
            )
          )
      )
    (chaos-rgun-track-post)
    (nav-enemy-simple-post)
    )
  )

;; Verbatim port of `rapid-gunner::spin-attack` -- the only time this species deals contact damage.
;; Child primitive 1 is grown from 1 m to 1.8 m and made `deadly` for exactly one spin animation,
;; then put back. This scripted-window pattern is why `chaos-cityify-collision!` must not force
;; `deadly` on permanently -- a gunner is harmless to walk into except during this one animation.
(defstate spin-attack (chaos-rapid-gunner)
